;;;; ref-cl.lisp  check-v3  Common Lisp  CL 
;;;;  I/O JSON tasks/v3.spec.md

(defparameter *limit* 20)
(defparameter *db* nil)   ; list of plists (:name :teacher :loc :day :from :to)

(defun tokens (s)
  " token"
  (let ((out '()) (buf (make-string-output-stream)) (n 0))
    (loop for ch across s do
      (if (or (char= ch #\Space) (char= ch #\Tab))
          (progn (when (> n 0) (push (get-output-stream-string buf) out) (setf n 0)))
          (progn (write-char ch buf) (incf n))))
    (when (> n 0) (push (get-output-stream-string buf) out))
    (nreverse out)))

(defun cname (c) (getf c :name))
(defun find-course (name) (find name *db* :key #'cname :test #'string=))
(defun overlap-p (f1 t1 f2 t2) (not (or (< t1 f2) (< t2 f1))))
(defun conflict-p (day from to except)
  (some (lambda (c) (and (not (eq c except)) (= (getf c :day) day)
                         (overlap-p from to (getf c :from) (getf c :to))))
        *db*))
(defun err (code) (format t "err ~a~%" code))
(defun ok (verb n) (format t "ok ~a ~a~%" verb n))
(defun num (s) (handler-case (parse-integer s) (error () nil)))
(defun valid-range (day from to)
  (and day from to (<= 1 day 7) (<= 1 from 12) (<= 1 to 12) (<= from to)))

(defun run-cmd (tok)
  (let* ((cmd (first tok)) (n (length tok)))
    (cond
      ((string= cmd "add")
       (if (/= n 7) (err "BADARG")
           (let* ((name (nth 1 tok)) (teacher (nth 2 tok)) (loc (nth 3 tok))
                  (day (num (nth 4 tok))) (from (num (nth 5 tok))) (to (num (nth 6 tok))))
             (cond ((not (valid-range day from to)) (err "BADARG"))
                   ((find-course name) (err "DUP"))
                   ((>= (length *db*) *limit*) (err "LIMIT"))
                   ((conflict-p day from to nil) (err "CONFLICT"))
                   (t (push (list :name name :teacher teacher :loc loc
                                  :day day :from from :to to) *db*)
                      (ok "add" 1))))))
      ((string= cmd "del")
       (if (/= n 2) (err "BADARG")
           (let ((c (find-course (nth 1 tok))))
             (if (null c) (err "NOTFOUND")
                 (progn (setf *db* (remove c *db*)) (ok "del" 1))))))
      ((string= cmd "edit")
       (if (/= n 4) (err "BADARG")
           (let ((c (find-course (nth 1 tok))))
             (if (null c) (err "NOTFOUND")
                 (progn (setf (getf c :teacher) (nth 2 tok)
                              (getf c :loc) (nth 3 tok))
                        (ok "edit" 1))))))
      ((string= cmd "move")
       (if (/= n 5) (err "BADARG")
           (let* ((c (find-course (nth 1 tok)))
                  (day (num (nth 2 tok))) (from (num (nth 3 tok))) (to (num (nth 4 tok))))
             (cond ((null c) (err "NOTFOUND"))
                   ((not (valid-range day from to)) (err "BADARG"))
                   ((conflict-p day from to c) (err "CONFLICT"))
                   (t (setf (getf c :day) day (getf c :from) from (getf c :to) to)
                      (ok "move" 1))))))
      ((string= cmd "swap")
       (if (/= n 3) (err "BADARG")
           (let ((a (find-course (nth 1 tok))) (b (find-course (nth 2 tok))))
             (if (or (null a) (null b)) (err "NOTFOUND")
                 (let ((ad (getf a :day)) (af (getf a :from)) (at (getf a :to)))
                   (setf (getf a :day) (getf b :day) (getf a :from) (getf b :from)
                         (getf a :to) (getf b :to))
                   (setf (getf b :day) ad (getf b :from) af (getf b :to) at)
                   (ok "swap" 2))))))
      ((string= cmd "rename")
       (if (/= n 3) (err "BADARG")
           (let ((c (find-course (nth 1 tok))))
             (cond ((null c) (err "NOTFOUND"))
                   ((find-course (nth 2 tok)) (err "DUP"))
                   (t (setf (getf c :name) (nth 2 tok)) (ok "rename" 1))))))
      ((string= cmd "duplicate")
       (if (/= n 3) (err "BADARG")
           (let ((c (find-course (nth 1 tok))))
             (cond ((null c) (err "NOTFOUND"))
                   ((find-course (nth 2 tok)) (err "DUP"))
                   ((>= (length *db*) *limit*) (err "LIMIT"))
                   (t (push (list :name (nth 2 tok) :teacher (getf c :teacher)
                                  :loc (getf c :loc) :day (getf c :day)
                                  :from (getf c :from) :to (getf c :to)) *db*)
                      (ok "duplicate" 1))))))
      ((string= cmd "trim")
       (if (/= n 3) (err "BADARG")
           (let* ((day (num (nth 1 tok))) (cap (num (nth 2 tok))) (k 0))
             (if (not (and day cap (<= 1 day 7) (<= 1 cap 12))) (err "BADARG")
                 (progn
                   (dolist (c *db*)
                     (when (and (= (getf c :day) day)
                                (<= (getf c :from) cap)
                                (> (getf c :to) cap))
                       (setf (getf c :to) cap) (incf k)))
                   (ok "trim" k))))))
      ((string= cmd "clear")
       (if (/= n 2) (err "BADARG")
           (let ((day (num (nth 1 tok))))
             (if (not (and day (<= 1 day 7))) (err "BADARG")
                 (let ((hit (remove-if-not (lambda (c) (= (getf c :day) day)) *db*)))
                   (setf *db* (remove-if (lambda (c) (= (getf c :day) day)) *db*))
                   (ok "clear" (length hit)))))))
      ((string= cmd "shift")
       (if (/= n 3) (err "BADARG")
           (let* ((day (num (nth 1 tok))) (delta (num (nth 2 tok)))
                  (hit (and day (remove-if-not (lambda (c) (= (getf c :day) day)) *db*))))
             (cond ((not (and day delta (<= 1 day 7))) (err "BADARG"))
                   ((some (lambda (c) (let ((nd (+ (getf c :day) delta)))
                                        (or (< nd 1) (> nd 7)))) hit)
                    (err "BADARG"))
                   (t (dolist (c hit) (incf (getf c :day) delta))
                      (ok "shift" (length hit)))))))
      ((string= cmd "copy")
       (if (/= n 3) (err "BADARG")
           (let ((c (find-course (nth 1 tok))) (day (num (nth 2 tok))))
             (cond ((null c) (err "NOTFOUND"))
                   ((not (and day (<= 1 day 7))) (err "BADARG"))
                   ((>= (length *db*) *limit*) (err "LIMIT"))
                   (t (push (list :name (concatenate 'string (getf c :name) "_2")
                                  :teacher (getf c :teacher) :loc (getf c :loc)
                                  :day day :from (getf c :from) :to (getf c :to)) *db*)
                      (ok "copy" 1))))))
      ((string= cmd "merge")
       (if (/= n 3) (err "BADARG")
           (let ((a (find-course (nth 1 tok))) (b (find-course (nth 2 tok))))
             (if (or (null a) (null b)) (err "NOTFOUND")
                 (progn (setf (getf a :teacher) (getf b :teacher)
                              (getf a :loc) (getf b :loc))
                        (setf *db* (remove b *db*))
                        (ok "merge" 2))))))
      ((string= cmd "sort")
       (if (/= n 1) (err "BADARG") (ok "sort" 0)))
      ((string= cmd "filter")
       (if (/= n 2) (err "BADARG")
           (let ((day (num (nth 1 tok))))
             (if (not (and day (<= 1 day 7))) (err "BADARG")
                 (ok "filter" (count-if (lambda (c) (= (getf c :day) day)) *db*))))))
      ((string= cmd "count")
       (if (/= n 1) (err "BADARG") (ok "count" (length *db*))))
      (t (err "BADARG")))))

;; ---- entry ----
;; 不依赖 "--script" 的位置：过滤掉选项与脚本路径，剩下的就是命令
(let* ((argv sb-ext:*posix-argv*)
       (cmds (remove-if (lambda (s)
                          (or (and (> (length s) 0) (char= (char s 0) #\-))
                              (search ".lisp" s)))
                        (rest argv))))
  (dolist (raw cmds)
    (let ((tok (tokens raw)))
      (if (null tok) (err "BADARG") (run-cmd tok))))
  (format t "#state~%")
  (dolist (c (sort (copy-list *db*) #'string< :key #'cname))
    (format t "~a|~a|~a|~a|~a-~a~%"
            (getf c :name) (getf c :teacher) (getf c :loc)
            (getf c :day) (getf c :from) (getf c :to))))
