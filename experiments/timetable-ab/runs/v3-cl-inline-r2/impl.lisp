; v3 timetable ops executor -- inline style arm.
; One hand written branch per op. No op generating macros, no dispatch table.

(defstruct course name teacher loc day fr to)

(defun digits-p (s)
  (and (stringp s) (plusp (length s)) (every #'digit-char-p s)))

(defun inum (s)
  (when (digits-p s) (parse-integer s)))

(defun snum (s)
  (cond
    ((not (stringp s)) nil)
    ((digits-p s) (parse-integer s))
    ((and (> (length s) 1)
          (char= (char s 0) #\-)
          (every #'digit-char-p (subseq s 1)))
     (- (parse-integer (subseq s 1))))
    ((and (> (length s) 1)
          (char= (char s 0) #\+)
          (every #'digit-char-p (subseq s 1)))
     (parse-integer (subseq s 1)))
    (t nil)))

(defun word-p (s)
  (and (stringp s) (>= (length s) 1) (<= (length s) 12)))

(defun split-ws (s)
  (let ((out nil) (cur nil))
    (loop for ch across s
          do (if (or (char= ch #\Space) (char= ch #\Tab))
                 (when cur
                   (push (coerce (nreverse cur) 'string) out)
                   (setf cur nil))
                 (push ch cur)))
    (when cur (push (coerce (nreverse cur) 'string) out))
    (nreverse out)))

(defun find-course (nm lst)
  (find nm lst :key #'course-name :test #'equal))

(defun clash-p (lst d f e skip)
  (some (lambda (c)
          (and (not (eq c skip))
               (= (course-day c) d)
               (<= f (course-to c))
               (<= (course-fr c) e)))
        lst))

(defun day-ok (d) (and d (>= d 1) (<= d 7)))

(defun hour-ok (h) (and h (>= h 1) (<= h 12)))

(defun main ()
  (let ((courses nil)
        (args (remove-if (lambda (s)
                           (or (and (> (length s) 0) (char= (char s 0) #\-))
                               (and (> (length s) 0) (search ".lisp" s))))
                         (rest sb-ext:*posix-argv*))))
    (dolist (item args)
      (let* ((toks (split-ws item))
             (v (first toks))
             (a (rest toks)))
        (cond
          ((null toks)
           (format t "err BADARG~%"))
          ((equal v "add")
           (if (/= (length a) 6)
               (format t "err BADARG~%")
               (let ((nm (nth 0 a)) (tc (nth 1 a)) (lc (nth 2 a))
                     (d (inum (nth 3 a))) (f (inum (nth 4 a))) (e (inum (nth 5 a))))
                 (cond
                   ((not (and (word-p nm) (word-p tc) (word-p lc)))
                    (format t "err BADARG~%"))
                   ((not (and (day-ok d) (hour-ok f) (hour-ok e) (>= e f)))
                    (format t "err BADARG~%"))
                   ((find-course nm courses)
                    (format t "err DUP~%"))
                   ((>= (length courses) 20)
                    (format t "err LIMIT~%"))
                   ((clash-p courses d f e nil)
                    (format t "err CONFLICT~%"))
                   (t
                    (push (make-course :name nm :teacher tc :loc lc
                                       :day d :fr f :to e)
                          courses)
                    (format t "ok add 1~%"))))))
          ((equal v "del")
           (if (/= (length a) 1)
               (format t "err BADARG~%")
               (let ((c (find-course (nth 0 a) courses)))
                 (if (null c)
                     (format t "err NOTFOUND~%")
                     (progn
                       (setf courses (remove c courses :test #'eq))
                       (format t "ok del 1~%"))))))
          ((equal v "edit")
           (if (/= (length a) 3)
               (format t "err BADARG~%")
               (if (not (and (word-p (nth 1 a)) (word-p (nth 2 a))))
                   (format t "err BADARG~%")
                   (let ((c (find-course (nth 0 a) courses)))
                     (if (null c)
                         (format t "err NOTFOUND~%")
                         (progn
                           (setf (course-teacher c) (nth 1 a)
                                 (course-loc c) (nth 2 a))
                           (format t "ok edit 1~%")))))))
          ((equal v "move")
           (if (/= (length a) 4)
               (format t "err BADARG~%")
               (let ((d (inum (nth 1 a))) (f (inum (nth 2 a))) (e (inum (nth 3 a))))
                 (if (not (and (day-ok d) (hour-ok f) (hour-ok e) (>= e f)))
                     (format t "err BADARG~%")
                     (let ((c (find-course (nth 0 a) courses)))
                       (cond
                         ((null c)
                          (format t "err NOTFOUND~%"))
                         ((clash-p courses d f e c)
                          (format t "err CONFLICT~%"))
                         (t
                          (setf (course-day c) d
                                (course-fr c) f
                                (course-to c) e)
                          (format t "ok move 1~%"))))))))
          ((equal v "swap")
           (if (/= (length a) 2)
               (format t "err BADARG~%")
               (let ((x (find-course (nth 0 a) courses))
                     (y (find-course (nth 1 a) courses)))
                 (if (or (null x) (null y))
                     (format t "err NOTFOUND~%")
                     (let ((d (course-day x)) (f (course-fr x)) (e (course-to x)))
                       (setf (course-day x) (course-day y)
                             (course-fr x) (course-fr y)
                             (course-to x) (course-to y))
                       (setf (course-day y) d
                             (course-fr y) f
                             (course-to y) e)
                       (format t "ok swap 2~%"))))))
          ((equal v "rename")
           (if (/= (length a) 2)
               (format t "err BADARG~%")
               (if (not (word-p (nth 1 a)))
                   (format t "err BADARG~%")
                   (let ((c (find-course (nth 0 a) courses)))
                     (cond
                       ((null c)
                        (format t "err NOTFOUND~%"))
                       ((find-course (nth 1 a) courses)
                        (format t "err DUP~%"))
                       (t
                        (setf (course-name c) (nth 1 a))
                        (format t "ok rename 1~%")))))))
          ((equal v "duplicate")
           (if (/= (length a) 2)
               (format t "err BADARG~%")
               (if (not (word-p (nth 1 a)))
                   (format t "err BADARG~%")
                   (let ((c (find-course (nth 0 a) courses)))
                     (cond
                       ((null c)
                        (format t "err NOTFOUND~%"))
                       ((find-course (nth 1 a) courses)
                        (format t "err DUP~%"))
                       ((>= (length courses) 20)
                        (format t "err LIMIT~%"))
                       (t
                        (push (make-course :name (nth 1 a)
                                           :teacher (course-teacher c)
                                           :loc (course-loc c)
                                           :day (course-day c)
                                           :fr (course-fr c)
                                           :to (course-to c))
                              courses)
                        (format t "ok duplicate 1~%")))))))
          ((equal v "trim")
           (if (/= (length a) 2)
               (format t "err BADARG~%")
               (let ((d (inum (nth 0 a))) (e (inum (nth 1 a))))
                 (if (not (and (day-ok d) (hour-ok e)))
                     (format t "err BADARG~%")
                     (let ((n 0))
                       (dolist (c courses)
                         (when (and (= (course-day c) d)
                                    (<= (course-fr c) e)
                                    (< e (course-to c)))
                           (setf (course-to c) e)
                           (incf n)))
                       (format t "ok trim ~d~%" n))))))
          ((equal v "clear")
           (if (/= (length a) 1)
               (format t "err BADARG~%")
               (let ((d (inum (nth 0 a))))
                 (if (not (day-ok d))
                     (format t "err BADARG~%")
                     (let ((n (count-if (lambda (c) (= (course-day c) d)) courses)))
                       (setf courses
                             (remove-if (lambda (c) (= (course-day c) d)) courses))
                       (format t "ok clear ~d~%" n))))))
          ((equal v "shift")
           (if (/= (length a) 2)
               (format t "err BADARG~%")
               (let ((d (inum (nth 0 a))) (g (snum (nth 1 a))))
                 (if (not (and (day-ok d) g))
                     (format t "err BADARG~%")
                     (let ((nd (+ d g)))
                       (if (or (< nd 1) (> nd 7))
                           (format t "err BADARG~%")
                           (let ((n 0))
                             (dolist (c courses)
                               (when (= (course-day c) d)
                                 (setf (course-day c) nd)
                                 (incf n)))
                             (format t "ok shift ~d~%" n))))))))
          ((equal v "copy")
           (if (/= (length a) 2)
               (format t "err BADARG~%")
               (let ((d (inum (nth 1 a))))
                 (if (not (day-ok d))
                     (format t "err BADARG~%")
                     (let ((c (find-course (nth 0 a) courses)))
                       (cond
                         ((null c)
                          (format t "err NOTFOUND~%"))
                         ((find-course (concatenate 'string (course-name c) "_2") courses)
                          (format t "err DUP~%"))
                         ((>= (length courses) 20)
                          (format t "err LIMIT~%"))
                         (t
                          (push (make-course
                                 :name (concatenate 'string (course-name c) "_2")
                                 :teacher (course-teacher c)
                                 :loc (course-loc c)
                                 :day d
                                 :fr (course-fr c)
                                 :to (course-to c))
                                courses)
                          (format t "ok copy 1~%"))))))))
          ((equal v "merge")
           (if (/= (length a) 2)
               (format t "err BADARG~%")
               (let ((x (find-course (nth 0 a) courses))
                     (y (find-course (nth 1 a) courses)))
                 (if (or (null x) (null y))
                     (format t "err NOTFOUND~%")
                     (progn
                       (setf (course-teacher x) (course-teacher y)
                             (course-loc x) (course-loc y))
                       (setf courses (remove y courses :test #'eq))
                       (format t "ok merge 2~%"))))))
          ((equal v "sort")
           (if (null a)
               (format t "ok sort 0~%")
               (format t "err BADARG~%")))
          ((equal v "filter")
           (if (/= (length a) 1)
               (format t "err BADARG~%")
               (let ((d (inum (nth 0 a))))
                 (if (not (day-ok d))
                     (format t "err BADARG~%")
                     (format t "ok filter ~d~%"
                             (count-if (lambda (c) (= (course-day c) d))
                                       courses))))))
          ((equal v "count")
           (if (null a)
               (format t "ok count ~d~%" (length courses))
               (format t "err BADARG~%")))
          (t
           (format t "err BADARG~%")))))
    (format t "#state~%")
    (dolist (c (sort (copy-list courses) #'string< :key #'course-name))
      (format t "~a|~a|~a|~d|~d-~d~%"
              (course-name c) (course-teacher c) (course-loc c)
              (course-day c) (course-fr c) (course-to c)))))

(main)
