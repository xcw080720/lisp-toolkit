;;;; v3 timetable ops executor -- macro style
;;;; single file, ASCII only, argv -> stdout, no file/json/third-party

(defstruct course name teacher loc day from to)
(defstruct op name fn)

(defvar *op-table* (make-hash-table :test #'equal))
(defvar *courses* '())
(defparameter *capacity* 20)

(defun op-error (code)
  (throw 'op-fail code))

(defun register-op (name fn)
  (let ((rec (make-op :name name :fn fn)))
    (setf (gethash name *op-table*) rec)
    (setf (gethash (string-downcase name) *op-table*) rec)
    rec))

;;;; ---- argument readers: every declared parameter goes through one ----

(defun to-int (s)
  (multiple-value-bind (v pos) (parse-integer s :junk-allowed t)
    (unless (and v (= pos (length s)))
      (op-error "BADARG"))
    v))

(defun word-arg (s)
  (when (or (< (length s) 1) (> (length s) 12))
    (op-error "BADARG"))
  s)

(defun int-arg (s)
  (to-int s))

(defun day-arg (s)
  (let ((v (to-int s)))
    (when (or (< v 1) (> v 7)) (op-error "BADARG"))
    v))

(defun slot-arg (s)
  (let ((v (to-int s)))
    (when (or (< v 1) (> v 12)) (op-error "BADARG"))
    v))

(defun count-arg (s)
  (let ((v (to-int s)))
    (when (< v 0) (op-error "BADARG"))
    v))

;;;; ---- the one form per op: arity check, arg validation, roster, dispatch ----

(defmacro defop (opname params &body body)
  (let ((argv (gensym "ARGV")))
    `(register-op ,opname
                  (lambda (,argv)
                    (unless (= (length ,argv) ,(length params))
                      (op-error "BADARG"))
                    (let ,(loop for p in params
                                for i from 0
                                collect
                                (list (first p)
                                      (case (second p)
                                        (:word `(word-arg (nth ,i ,argv)))
                                        (:int `(int-arg (nth ,i ,argv)))
                                        (:day `(day-arg (nth ,i ,argv)))
                                        (:slot `(slot-arg (nth ,i ,argv)))
                                        (:count `(count-arg (nth ,i ,argv)))
                                        (t (error "defop: unknown param kind")))))
                      ,@(when params
                          `((declare (ignorable ,@(mapcar #'first params)))))
                      ,@body)))))

;;;; ---- shared helpers ----

(defun find-course (nm cs)
  (find nm cs :key #'course-name :test #'string=))

(defun need-course (nm cs)
  (or (find-course nm cs)
      (op-error "NOTFOUND")))

(defun check-capacity ()
  (when (>= (length *courses*) *capacity*)
    (op-error "LIMIT")))

(defun replace-course (cs old new)
  (mapcar (lambda (c) (if (eq c old) new c)) cs))

(defun replace-two (cs a na b nb)
  (mapcar (lambda (c) (cond ((eq c a) na) ((eq c b) nb) (t c))) cs))

(defun touch (c)
  (copy-course c))

(defun conflict-p (cs day from to ignore)
  (let ((hit nil))
    (dolist (c cs hit)
      (when (and (not (eq c ignore))
                 (= (course-day c) day)
                 (<= from (course-to c))
                 (<= (course-from c) to))
        (setf hit t)))))

(defun clash (a b)
  (and (= (course-day a) (course-day b))
       (<= (course-from a) (course-to b))
       (<= (course-from b) (course-to a))))

(defun schedule-conflict-p (cs)
  (let ((hit nil))
    (dolist (a cs hit)
      (dolist (b cs)
        (when (and (not (eq a b)) (clash a b))
          (setf hit t))))))

(defun map-counting (fn cs)
  (let ((n 0) (out '()))
    (dolist (c cs)
      (let ((r (funcall fn c)))
        (if r (progn (incf n) (push r out)) (push c out))))
    (values (nreverse out) n)))

(defun filter-counting (keep cs)
  (let ((n 0) (out '()))
    (dolist (c cs)
      (if (funcall keep c) (push c out) (incf n)))
    (values (nreverse out) n)))

(defun best-named (d cs)
  (let ((best nil))
    (dolist (c cs best)
      (when (and (= (course-day c) d)
                 (or (null best) (string< (course-name c) (course-name best))))
        (setf best c)))))

(defun compress-day (d cs)
  (let* ((mine (stable-sort (remove-if-not (lambda (c) (= (course-day c) d)) cs)
                            #'< :key #'course-from))
         (order '())
         (k 0))
    (dolist (c mine)
      (incf k)
      (push (cons c k) order))
    (map-counting
     (lambda (c)
       (let ((pr (assoc c order)))
         (when pr
           (let ((j (cdr pr)))
             (unless (and (= (course-from c) j) (= (course-to c) (1+ j)))
               (let ((nc (touch c)))
                 (setf (course-from nc) j)
                 (setf (course-to nc) (1+ j))
                 nc))))))
     cs)))

;;;; ---- ops 1-15 ----

(defop "add" ((nm :word) (w1 :word) (w2 :word) (d :day) (f :slot) (to :slot))
  (when (> f to) (op-error "BADARG"))
  (when (find-course nm *courses*) (op-error "DUP"))
  (check-capacity)
  (when (conflict-p *courses* d f to nil) (op-error "CONFLICT"))
  (values 1
          (cons (make-course :name nm :teacher w1 :loc w2 :day d :from f :to to)
                *courses*)))

(defop "del" ((nm :word))
  (need-course nm *courses*)
  (multiple-value-bind (new n)
      (filter-counting (lambda (c) (not (string= (course-name c) nm))) *courses*)
    (values 1 new)))

(defop "edit" ((nm :word) (w1 :word) (w2 :word))
  (let ((c (need-course nm *courses*)))
    (let ((nc (touch c)))
      (setf (course-teacher nc) w1)
      (setf (course-loc nc) w2)
      (values 1 (replace-course *courses* c nc)))))

(defop "move" ((nm :word) (d :day) (f :slot) (to :slot))
  (when (> f to) (op-error "BADARG"))
  (let ((c (need-course nm *courses*)))
    (when (conflict-p *courses* d f to c) (op-error "CONFLICT"))
    (let ((nc (touch c)))
      (setf (course-day nc) d)
      (setf (course-from nc) f)
      (setf (course-to nc) to)
      (values 1 (replace-course *courses* c nc)))))

(defop "swap" ((a :word) (b :word))
  (let* ((ca (need-course a *courses*))
         (cb (need-course b *courses*)))
    (if (eq ca cb)
        (values 2 *courses*)
        (let ((na (touch ca))
              (nb (touch cb)))
          (setf (course-day na) (course-day cb))
          (setf (course-from na) (course-from cb))
          (setf (course-to na) (course-to cb))
          (setf (course-day nb) (course-day ca))
          (setf (course-from nb) (course-from ca))
          (setf (course-to nb) (course-to ca))
          (values 2 (replace-two *courses* ca na cb nb))))))

(defop "rename" ((old :word) (new :word))
  (let ((c (need-course old *courses*)))
    (when (and (not (string= old new)) (find-course new *courses*))
      (op-error "DUP"))
    (if (string= old new)
        (values 1 *courses*)
        (let ((nc (touch c)))
          (setf (course-name nc) new)
          (values 1 (replace-course *courses* c nc))))))

(defop "duplicate" ((nm :word) (nn :word))
  (let ((c (need-course nm *courses*)))
    (when (find-course nn *courses*) (op-error "DUP"))
    (check-capacity)
    (let ((nc (touch c)))
      (setf (course-name nc) nn)
      (values 1 (cons nc *courses*)))))

(defop "trim" ((d :day) (to :slot))
  (multiple-value-bind (new n)
      (map-counting
       (lambda (c)
         (when (and (= (course-day c) d)
                    (<= (course-from c) to)
                    (< to (course-to c)))
           (let ((nc (touch c)))
             (setf (course-to nc) to)
             nc)))
       *courses*)
    (values n new)))

(defop "clear" ((d :day))
  (multiple-value-bind (new n)
      (filter-counting (lambda (c) (/= (course-day c) d)) *courses*)
    (values n new)))

(defop "shift" ((d :day) (delta :int))
  (let ((nd (+ d delta)))
    (when (or (< nd 1) (> nd 7)) (op-error "BADARG"))
    (multiple-value-bind (new n)
        (map-counting
         (lambda (c)
           (when (= (course-day c) d)
             (let ((nc (touch c)))
               (setf (course-day nc) nd)
               nc)))
         *courses*)
      (values n new))))

(defop "copy" ((nm :word) (d :day))
  (let* ((c (need-course nm *courses*))
         (nn (concatenate 'string (course-name c) "_2")))
    (when (find-course nn *courses*) (op-error "DUP"))
    (check-capacity)
    (let ((nc (touch c)))
      (setf (course-name nc) nn)
      (setf (course-day nc) d)
      (values 1 (cons nc *courses*)))))

(defop "merge" ((a :word) (b :word))
  (let* ((ca (need-course a *courses*))
         (cb (need-course b *courses*)))
    (if (eq ca cb)
        (values 2 *courses*)
        (let ((nc (touch ca)))
          (setf (course-teacher nc) (course-teacher cb))
          (setf (course-loc nc) (course-loc cb))
          (multiple-value-bind (mid ignored)
              (filter-counting (lambda (c) (not (eq c cb))) *courses*)
            (declare (ignore ignored))
            (values 2 (replace-course mid ca nc)))))))

(defop "sort" ()
  (values 0 *courses*))

(defop "filter" ((d :day))
  (values (count-if (lambda (c) (= (course-day c) d)) *courses*) *courses*))

(defop "count" ()
  (values (length *courses*) *courses*))

;;;; ---- ops 16-30 ----

(defop "swapTeacher" ((a :word) (b :word))
  (let* ((ca (need-course a *courses*))
         (cb (need-course b *courses*)))
    (if (eq ca cb)
        (values 2 *courses*)
        (let ((na (touch ca))
              (nb (touch cb)))
          (setf (course-teacher na) (course-teacher cb))
          (setf (course-teacher nb) (course-teacher ca))
          (values 2 (replace-two *courses* ca na cb nb))))))

(defop "swapLoc" ((a :word) (b :word))
  (let* ((ca (need-course a *courses*))
         (cb (need-course b *courses*)))
    (if (eq ca cb)
        (values 2 *courses*)
        (let ((na (touch ca))
              (nb (touch cb)))
          (setf (course-loc na) (course-loc cb))
          (setf (course-loc nb) (course-loc ca))
          (values 2 (replace-two *courses* ca na cb nb))))))

(defop "copyTo" ((nm :word) (d :day) (f :slot) (to :slot))
  (when (> f to) (op-error "BADARG"))
  (let* ((c (need-course nm *courses*))
         (nn (concatenate 'string (course-name c) "_3")))
    (when (find-course nn *courses*) (op-error "DUP"))
    (when (conflict-p *courses* d f to nil) (op-error "CONFLICT"))
    (check-capacity)
    (values 1
            (cons (make-course :name nn
                               :teacher (course-teacher c)
                               :loc (course-loc c)
                               :day d
                               :from f
                               :to to)
                  *courses*))))

(defop "truncate" ((d :day))
  (let ((best (best-named d *courses*)))
    (multiple-value-bind (new n)
        (filter-counting (lambda (c) (or (/= (course-day c) d) (eq c best))) *courses*)
      (values n new))))

(defop "keep" ((d :day) (k :count))
  (let* ((mine (remove-if-not (lambda (c) (= (course-day c) d)) *courses*))
         (sorted (sort mine #'string< :key #'course-name))
         (kept (if (> (length sorted) k) (subseq sorted 0 k) sorted)))
    (multiple-value-bind (new n)
        (filter-counting
         (lambda (c) (or (/= (course-day c) d) (member c kept :test #'eq)))
         *courses*)
      (values n new))))

(defop "renameTeacher" ((t1 :word) (t2 :word))
  (multiple-value-bind (new n)
      (map-counting
       (lambda (c)
         (when (string= (course-teacher c) t1)
           (let ((nc (touch c)))
             (setf (course-teacher nc) t2)
             nc)))
       *courses*)
    (values n new)))

(defop "renameLoc" ((l1 :word) (l2 :word))
  (multiple-value-bind (new n)
      (map-counting
       (lambda (c)
         (when (string= (course-loc c) l1)
           (let ((nc (touch c)))
             (setf (course-loc nc) l2)
             nc)))
       *courses*)
    (values n new)))

(defop "dedupe" ()
  (let* ((sorted (sort (copy-list *courses*) #'string< :key #'course-name))
         (seen '())
         (kept '())
         (n 0))
    (dolist (c sorted)
      (let ((key (list (course-teacher c) (course-loc c)
                       (course-day c) (course-from c) (course-to c))))
        (if (member key seen :test #'equal)
            (incf n)
            (progn (push key seen) (push c kept)))))
    (values n (nreverse kept))))

(defop "compress" ((d :day))
  (multiple-value-bind (new n) (compress-day d *courses*)
    (values n new)))

(defop "compact" ()
  (let ((cur *courses*) (total 0))
    (dotimes (i 7)
      (multiple-value-bind (new n) (compress-day (1+ i) cur)
        (setf cur new)
        (incf total n)))
    (values total cur)))

(defop "mirror" ((d :day) (d2 :day))
  (let ((mine (remove-if-not (lambda (c) (= (course-day c) d)) *courses*)))
    (dolist (c mine)
      (when (find-course (concatenate 'string (course-name c) "_m") *courses*)
        (op-error "DUP")))
    (let ((fresh (mapcar (lambda (c)
                           (let ((nc (touch c)))
                             (setf (course-name nc)
                                   (concatenate 'string (course-name c) "_m"))
                             (setf (course-day nc) d2)
                             nc))
                         mine)))
      (values (length mine) (append fresh *courses*)))))

(defop "absorb" ((a :word) (b :word))
  (let* ((ca (need-course a *courses*))
         (cb (need-course b *courses*)))
    (if (eq ca cb)
        (values 2 *courses*)
        (let ((nc (touch ca)))
          (setf (course-teacher nc) (course-teacher cb))
          (setf (course-loc nc) (course-loc cb))
          (values 2 (replace-course *courses* ca nc))))))

(defop "swapDays" ((d1 :day) (d2 :day))
  (let ((n1 (count-if (lambda (c) (= (course-day c) d1)) *courses*))
        (n2 (count-if (lambda (c) (= (course-day c) d2)) *courses*)))
    (if (= d1 d2)
        (values (+ n1 n2) *courses*)
        (multiple-value-bind (new ignored)
            (map-counting
             (lambda (c)
               (let ((cur (course-day c)))
                 (when (or (= cur d1) (= cur d2))
                   (let ((nc (touch c)))
                     (setf (course-day nc) (if (= cur d1) d2 d1))
                     nc))))
             *courses*)
          (declare (ignore ignored))
          (when (schedule-conflict-p new) (op-error "CONFLICT"))
          (values (+ n1 n2) new)))))

(defop "promote" ((nm :word))
  (let* ((c (need-course nm *courses*))
         (dur (- (course-to c) (course-from c)))
         (slot (loop for f from 1 to (- 12 dur)
                     when (not (conflict-p *courses* (course-day c) f (+ f dur) c))
                     return f)))
    (if (null slot)
        (values 1 *courses*)
        (let ((nc (touch c)))
          (setf (course-from nc) slot)
          (setf (course-to nc) (+ slot dur))
          (values 1 (replace-course *courses* c nc))))))

(defop "purge" ((w :word))
  (multiple-value-bind (new n)
      (filter-counting (lambda (c) (not (string= (course-teacher c) w))) *courses*)
    (values n new)))

;;;; ---- command line: tokenise, split --dry, dispatch, emit ----

(defun split-tokens (s)
  (let ((toks '())
        (start nil))
    (loop for i from 0 below (length s)
          for ch = (char s i)
          do (if (or (char= ch #\Space) (char= ch #\Tab))
                 (when start
                   (push (subseq s start i) toks)
                   (setf start nil))
                 (unless start
                   (setf start i))))
    (when start
      (push (subseq s start) toks))
    (nreverse toks)))

(defun run-op (line)
  (let ((tok (split-tokens line)))
    (when (null tok) (op-error "BADARG"))
    (let* ((dry (string= (first tok) "--dry"))
           (rest (if dry (rest tok) tok)))
      (when (null rest) (op-error "BADARG"))
      (let ((rec (gethash (first rest) *op-table*)))
        (unless rec (op-error "BADARG"))
        (multiple-value-bind (n new) (funcall (op-fn rec) (rest rest))
          (unless dry (setf *courses* new))
          (format t "ok ~a ~a~%" (string-downcase (op-name rec)) n)
          t)))))

(defun run-line (line)
  (let ((res (catch 'op-fail
               (handler-case (run-op line)
                 (error () (op-error "BADARG"))))))
    (unless (eq res t)
      (format t "err ~a~%" res)))
  (finish-output))

(defun script-args ()
  (let* ((argv (rest sb-ext:*posix-argv*))
         (tail (member-if (lambda (s)
                            (and (>= (length s) 5)
                                 (string-equal ".lisp" s
                                               :start2 (- (length s) 5))))
                          argv)))
    (if tail (rest tail) argv)))

(defun print-state ()
  (format t "#state~%")
  (dolist (c (stable-sort (copy-list *courses*) #'string< :key #'course-name))
    (format t "~a|~a|~a|~a|~a-~a~%"
            (course-name c)
            (course-teacher c)
            (course-loc c)
            (course-day c)
            (course-from c)
            (course-to c))))

(defun main ()
  (dolist (line (script-args))
    (run-line line))
  (print-state)
  (finish-output))

(main)
(sb-ext:exit :code 0)
