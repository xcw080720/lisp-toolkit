(defvar *courses* nil)

(defstruct course name teacher loc day from to)

(defun split-string (str)
  (let ((tokens nil) (start nil))
    (loop for i from 0 below (length str)
          for ch = (char str i)
          if (member ch '(#\Space #\Tab #\Newline #\Return))
            do (when start
                 (push (subseq str start i) tokens)
                 (setf start nil))
          else
            do (unless start (setf start i))
          finally (when start
                    (push (subseq str start) tokens)))
    (nreverse tokens)))

(defun parse-int (str)
  (ignore-errors (parse-integer str)))

(defun valid-word-p (w)
  (and (stringp w) (>= (length w) 1) (<= (length w) 12)))

(defun valid-day-p (d)
  (and (integerp d) (<= 1 d 7)))

(defun valid-period-p (f to)
  (and (integerp f) (integerp to)
       (<= 1 f 12) (<= 1 to 12)
       (<= f to)))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun conflict-p (day from to excl)
  (some (lambda (c)
          (and (not (member (course-name c) excl :test #'string=))
               (= (course-day c) day)
               (<= (course-from c) to)
               (<= from (course-to c))))
        *courses*))

(defun out-ok (verb n)
  (format t "ok ~a ~d~%" verb n))

(defun out-err (code)
  (format t "err ~a~%" code))

(defun op-add (args)
  (if (/= (length args) 6)
      (out-err "BADARG")
      (let* ((name (first args))
             (teacher (second args))
             (loc (third args))
             (day (parse-int (fourth args)))
             (from (parse-int (fifth args)))
             (to (parse-int (sixth args))))
        (if (or (not (valid-word-p name))
                (not (valid-word-p teacher))
                (not (valid-word-p loc))
                (not (valid-day-p day))
                (not (valid-period-p from to)))
            (out-err "BADARG")
            (cond
              ((find-course name) (out-err "DUP"))
              ((>= (length *courses*) 20) (out-err "LIMIT"))
              ((conflict-p day from to nil) (out-err "CONFLICT"))
              (t (push (make-course :name name :teacher teacher :loc loc
                                    :day day :from from :to to)
                       *courses*)
                 (out-ok "add" 1)))))))

(defun op-del (args)
  (if (/= (length args) 1)
      (out-err "BADARG")
      (let ((c (find-course (first args))))
        (if (null c)
            (out-err "NOTFOUND")
            (progn
              (setf *courses* (remove c *courses* :test #'eq))
              (out-ok "del" 1))))))

(defun op-edit (args)
  (if (/= (length args) 3)
      (out-err "BADARG")
      (let ((name (first args))
            (teacher (second args))
            (loc (third args)))
        (if (or (not (valid-word-p teacher))
                (not (valid-word-p loc)))
            (out-err "BADARG")
            (let ((c (find-course name)))
              (if (null c)
                  (out-err "NOTFOUND")
                  (progn
                    (setf (course-teacher c) teacher
                          (course-loc c) loc)
                    (out-ok "edit" 1))))))))

(defun op-move (args)
  (if (/= (length args) 4)
      (out-err "BADARG")
      (let* ((name (first args))
             (day (parse-int (second args)))
             (from (parse-int (third args)))
             (to (parse-int (fourth args))))
        (if (or (not (valid-day-p day))
                (not (valid-period-p from to)))
            (out-err "BADARG")
            (let ((c (find-course name)))
              (if (null c)
                  (out-err "NOTFOUND")
                  (if (conflict-p day from to (list name))
                      (out-err "CONFLICT")
                      (progn
                        (setf (course-day c) day
                              (course-from c) from
                              (course-to c) to)
                        (out-ok "move" 1)))))))))

(defun op-swap (args)
  (if (/= (length args) 2)
      (out-err "BADARG")
      (let* ((a-name (first args))
             (b-name (second args))
             (a (find-course a-name))
             (b (find-course b-name)))
        (cond
          ((null a) (out-err "NOTFOUND"))
          ((null b) (out-err "NOTFOUND"))
          (t
           (let ((ad (course-day a)) (af (course-from a)) (at (course-to a))
                 (bd (course-day b)) (bf (course-from b)) (bt (course-to b)))
             (setf (course-day a) bd (course-from a) bf (course-to a) bt)
             (setf (course-day b) ad (course-from b) af (course-to b) at))
           (out-ok "swap" 2))))))

(defun op-rename (args)
  (if (/= (length args) 2)
      (out-err "BADARG")
      (let ((old (first args))
            (new (second args)))
        (if (not (valid-word-p new))
            (out-err "BADARG")
            (let ((c (find-course old)))
              (if (null c)
                  (out-err "NOTFOUND")
                  (if (and (not (string= old new))
                           (find-course new))
                      (out-err "DUP")
                      (progn
                        (setf (course-name c) new)
                        (out-ok "rename" 1)))))))))

(defun op-duplicate (args)
  (if (/= (length args) 2)
      (out-err "BADARG")
      (let ((name (first args))
            (newname (second args)))
        (if (not (valid-word-p newname))
            (out-err "BADARG")
            (let ((c (find-course name)))
              (if (null c)
                  (out-err "NOTFOUND")
                  (cond
                    ((find-course newname) (out-err "DUP"))
                    ((>= (length *courses*) 20) (out-err "LIMIT"))
                    (t (push (make-course :name newname
                                          :teacher (course-teacher c)
                                          :loc (course-loc c)
                                          :day (course-day c)
                                          :from (course-from c)
                                          :to (course-to c))
                             *courses*)
                       (out-ok "duplicate" 1)))))))))

(defun op-trim (args)
  (if (/= (length args) 2)
      (out-err "BADARG")
      (let ((day (parse-int (first args)))
            (to (parse-int (second args))))
        (if (or (not (valid-day-p day))
                (not (and (integerp to) (<= 1 to 12))))
            (out-err "BADARG")
            (let ((count 0))
              (dolist (c *courses*)
                (when (and (= (course-day c) day)
                           (<= (course-from c) to)
                           (< to (course-to c)))
                  (setf (course-to c) to)
                  (incf count)))
              (out-ok "trim" count))))))

(defun op-clear (args)
  (if (/= (length args) 1)
      (out-err "BADARG")
      (let ((day (parse-int (first args))))
        (if (not (valid-day-p day))
            (out-err "BADARG")
            (let* ((before (length *courses*))
                   (after (remove-if (lambda (c) (= (course-day c) day)) *courses*)))
              (setf *courses* after)
              (out-ok "clear" (- before (length after)))))))))

(defun op-shift (args)
  (if (/= (length args) 2)
      (out-err "BADARG")
      (let* ((day (parse-int (first args)))
             (delta (parse-int (second args)))
             (target (and day delta (+ day delta))))
        (if (or (not (valid-day-p day))
                (not (integerp delta))
                (not (and target (<= 1 target 7))))
            (out-err "BADARG")
            (let ((count 0))
              (dolist (c *courses*)
                (when (= (course-day c) day)
                  (setf (course-day c) target)
                  (incf count)))
              (out-ok "shift" count))))))

(defun op-copy (args)
  (if (/= (length args) 2)
      (out-err "BADARG")
      (let* ((name (first args))
             (day (parse-int (second args)))
             (c (find-course name)))
        (cond
          ((not (valid-day-p day)) (out-err "BADARG"))
          ((null c) (out-err "NOTFOUND"))
          (t
           (let ((newname (concatenate 'string name "_2")))
             (cond
               ((> (length newname) 12) (out-err "BADARG"))
               ((find-course newname) (out-err "DUP"))
               ((>= (length *courses*) 20) (out-err "LIMIT"))
               (t (push (make-course :name newname
                                     :teacher (course-teacher c)
                                     :loc (course-loc c)
                                     :day day
                                     :from (course-from c)
                                     :to (course-to c))
                        *courses*)
                  (out-ok "copy" 1)))))))))

(defun op-merge (args)
  (if (/= (length args) 2)
      (out-err "BADARG")
      (let* ((a-name (first args))
             (b-name (second args))
             (a (find-course a-name))
             (b (find-course b-name)))
        (cond
          ((null a) (out-err "NOTFOUND"))
          ((null b) (out-err "NOTFOUND"))
          ((string= a-name b-name) (out-err "BADARG"))
          (t
           (setf (course-teacher a) (course-teacher b)
                 (course-loc a) (course-loc b))
           (setf *courses* (remove b *courses* :test #'eq))
           (out-ok "merge" 2))))))

(defun op-sort (args)
  (if (/= (length args) 0)
      (out-err "BADARG")
      (progn
        (setf *courses* (sort *courses* #'string< :key #'course-name))
        (out-ok "sort" 0))))

(defun op-filter (args)
  (if (/= (length args) 1)
      (out-err "BADARG")
      (let ((day (parse-int (first args))))
        (if (not (valid-day-p day))
            (out-err "BADARG")
            (out-ok "filter" (count-if (lambda (c) (= (course-day c) day)) *courses*))))))

(defun op-count (args)
  (if (/= (length args) 0)
      (out-err "BADARG")
      (out-ok "count" (length *courses*))))

(defun process-command (cmd)
  (let* ((tokens (split-string cmd))
         (verb (first tokens))
         (args (rest tokens)))
    (cond
      ((null verb) nil)
      ((string= verb "add") (op-add args))
      ((string= verb "del") (op-del args))
      ((string= verb "edit") (op-edit args))
      ((string= verb "move") (op-move args))
      ((string= verb "swap") (op-swap args))
      ((string= verb "rename") (op-rename args))
      ((string= verb "duplicate") (op-duplicate args))
      ((string= verb "trim") (op-trim args))
      ((string= verb "clear") (op-clear args))
      ((string= verb "shift") (op-shift args))
      ((string= verb "copy") (op-copy args))
      ((string= verb "merge") (op-merge args))
      ((string= verb "sort") (op-sort args))
      ((string= verb "filter") (op-filter args))
      ((string= verb "count") (op-count args))
      (t nil))))

(defun print-state ()
  (format t "#state~%")
  (let ((sorted (sort (copy-list *courses*) #'string< :key #'course-name)))
    (dolist (c sorted)
      (format t "~a|~a|~a|~d|~d-~d~%"
              (course-name c)
              (course-teacher c)
              (course-loc c)
              (course-day c)
              (course-from c)
              (course-to c)))))

(defun main ()
  (dolist (arg (sb-ext:posix-argv))
    (process-command arg))
  (print-state))

(main)
