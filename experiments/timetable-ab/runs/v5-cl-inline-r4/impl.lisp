(defvar *state* nil)

(defun split-words (s)
  (let ((words nil) (start 0) (len (length s)))
    (loop for i from 0 to len
          for c = (if (< i len) (char s i) #\Space)
          do (cond ((or (char= c #\Space) (char= c #\Tab))
                    (when (> i start)
                      (push (subseq s start i) words))
                    (setf start (1+ i)))
                   (t nil)))
    (nreverse words)))

(defun parse-int (s)
  (let ((len (length s)) (i 0) (sign 1) (val 0) (has-digit nil))
    (when (zerop len) (return-from parse-int nil))
    (let ((c (char s 0)))
      (cond ((char= c #\-) (setf sign -1) (incf i))
            ((char= c #\+) (incf i))))
    (when (= i len) (return-from parse-int nil))
    (loop while (< i len) do
      (let ((c (char s i)))
        (if (digit-char-p c)
            (progn (setf has-digit t)
                   (setf val (+ (* val 10) (digit-char-p c)))
                   (incf i))
            (return-from parse-int nil))))
    (if has-digit (* sign val) nil)))

(defun valid-word-p (s)
  (and (stringp s)
       (>= (length s) 1)
       (<= (length s) 12)
       (not (find-if (lambda (c) (or (char= c #\Space) (char= c #\Tab))) s))))

(defun find-rec (name state)
  (find name state :key #'first :test #'string=))

(defun remove-rec (name state)
  (remove name state :key #'first :test #'string=))

(defun overlap-p (d1 f1 t1 d2 f2 t2)
  (and (= d1 d2)
       (not (or (< t1 f2) (< t2 f1)))))

(defun conflict-p (day from to state &optional exclude-name)
  (some (lambda (rec)
          (and (or (null exclude-name) (not (string= (first rec) exclude-name)))
               (overlap-p day from to (fourth rec) (fifth rec) (sixth rec))))
        state))

(defun print-err (code)
  (format t "err ~a~%" code))

(defun print-ok (verb n)
  (format t "ok ~a ~a~%" verb n))

(defun process-command (cmd)
  (let* ((words (split-words cmd)))
    (when (null words)
      (print-err "BADARG")
      (return-from process-command))
    (let* ((verb (string-downcase (first words)))
           (args (rest words)))
      (cond
        ((string= verb "add")
         (if (/= (length args) 6)
             (print-err "BADARG")
             (let* ((name (nth 0 args))
                    (teacher (nth 1 args))
                    (loc (nth 2 args))
                    (day-s (nth 3 args))
                    (from-s (nth 4 args))
                    (to-s (nth 5 args))
                    (day (parse-int day-s))
                    (from (parse-int from-s))
                    (to (parse-int to-s)))
               (if (or (not (valid-word-p name))
                       (not (valid-word-p teacher))
                       (not (valid-word-p loc))
                       (not (and day (<= 1 day 7)))
                       (not (and from (<= 1 from 12)))
                       (not (and to (<= 1 to 12)))
                       (not (and from to (<= from to))))
                   (print-err "BADARG")
                   (cond
                     ((find-rec name *state*) (print-err "DUP"))
                     ((>= (length *state*) 20) (print-err "LIMIT"))
                     ((conflict-p day from to *state*) (print-err "CONFLICT"))
                     (t (push (list name teacher loc day from to) *state*)
                        (print-ok "add" 1)))))))
        ((string= verb "del")
         (if (/= (length args) 1)
             (print-err "BADARG")
             (let ((name (first args)))
               (if (not (valid-word-p name))
                   (print-err "BADARG")
                   (if (find-rec name *state*)
                       (progn
                         (setf *state* (remove-rec name *state*))
                         (print-ok "del" 1))
                       (print-err "NOTFOUND"))))))
        ((string= verb "edit")
         (if (/= (length args) 3)
             (print-err "BADARG")
             (let ((name (nth 0 args))
                   (teacher (nth 1 args))
                   (loc (nth 2 args)))
               (if (or (not (valid-word-p name))
                       (not (valid-word-p teacher))
                       (not (valid-word-p loc)))
                   (print-err "BADARG")
                   (let ((rec (find-rec name *state*)))
                     (if (null rec)
                         (print-err "NOTFOUND")
                         (progn
                           (setf *state*
                                 (mapcar (lambda (r)
                                           (if (string= (first r) name)
                                               (list name teacher loc (fourth r) (fifth r) (sixth r))
                                               r))
                                         *state*))
                           (print-ok "edit" 1))))))))
        ((string= verb "move")
         (if (/= (length args) 4)
             (print-err "BADARG")
             (let* ((name (nth 0 args))
                    (day-s (nth 1 args))
                    (from-s (nth 2 args))
                    (to-s (nth 3 args))
                    (day (parse-int day-s))
                    (from (parse-int from-s))
                    (to (parse-int to-s)))
               (if (or (not (valid-word-p name))
                       (not (and day (<= 1 day 7)))
                       (not (and from (<= 1 from 12)))
                       (not (and to (<= 1 to 12)))
                       (not (and from to (<= from to))))
                   (print-err "BADARG")
                   (let ((rec (find-rec name *state*)))
                     (if (null rec)
                         (print-err "NOTFOUND")
                         (if (conflict-p day from to *state* name)
                             (print-err "CONFLICT")
                             (progn
                               (setf *state*
                                     (mapcar (lambda (r)
                                               (if (string= (first r) name)
                                                   (list name (second r) (third r) day from to)
                                                   r))
                                             *state*))
                               (print-ok "move" 1))))))))
        ((string= verb "swap")
         (if (/= (length args) 2)
             (print-err "BADARG")
             (let ((a (nth 0 args))
                   (b (nth 1 args)))
               (if (or (not (valid-word-p a))
                       (not (valid-word-p b)))
                   (print-err "BADARG")
                   (let ((rec-a (find-rec a *state*))
                         (rec-b (find-rec b *state*)))
                     (if (or (null rec-a) (null rec-b))
                         (print-err "NOTFOUND")
                         (if (string= a b)
                             (print-ok "swap" 2)
                             (let* ((new-a (list a (second rec-a) (third rec-a)
                                                 (fourth rec-b) (fifth rec-b) (sixth rec-b)))
                                    (new-b (list b (second rec-b) (third rec-b)
                                                 (fourth rec-a) (fifth rec-a) (sixth rec-a)))
                                    (others (remove-if (lambda (r)
                                                         (or (string= (first r) a)
                                                             (string= (first r) b)))
                                                       *state*)))
                               (if (or (conflict-p (fourth new-a) (fifth new-a) (sixth new-a) others)
                                       (conflict-p (fourth new-b) (fifth new-b) (sixth new-b) others)
                                       (overlap-p (fourth new-a) (fifth new-a) (sixth new-a)
                                                  (fourth new-b) (fifth new-b) (sixth new-b)))
                                   (print-err "CONFLICT")
                                   (progn
                                     (setf *state*
                                           (mapcar (lambda (r)
                                                     (cond ((string= (first r) a) new-a)
                                                           ((string= (first r) b) new-b)
                                                           (t r)))
                                                   *state*))
                                     (print-ok "swap" 2))))))))))
        ((string= verb "rename")
         (if (/= (length args) 2)
             (print-err "BADARG")
             (let ((old (nth 0 args))
                   (new (nth 1 args)))
               (if (or (not (valid-word-p old))
                       (not (valid-word-p new)))
                   (print-err "BADARG")
                   (let ((rec (find-rec old *state*)))
                     (if (null rec)
                         (print-err "NOTFOUND")
                         (if (find-rec new *state*)
                             (print-err "DUP")
                             (progn
                               (setf *state*
                                     (mapcar (lambda (r)
                                               (if (string= (first r) old)
                                                   (list new (second r) (third r) (fourth r) (fifth r) (sixth r))
                                                   r))
                                             *state*))
                               (print-ok "rename" 1))))))))
        ((string= verb "duplicate")
         (if (/= (length args) 2)
             (print-err "BADARG")
             (let ((name (nth 0 args))
                   (newname (nth 1 args)))
               (if (or (not (valid-word-p name))
                       (not (valid-word-p newname)))
                   (print-err "BADARG")
                   (let ((rec (find-rec name *state*)))
                     (if (null rec)
                         (print-err "NOTFOUND")
                         (cond
                           ((find-rec newname *state*) (print-err "DUP"))
                           ((>= (length *state*) 20) (print-err "LIMIT"))
                           (t (push (list newname (second rec) (third rec)
                                          (fourth rec) (fifth rec) (sixth rec))
                                    *state*)
                              (print-ok "duplicate" 1))))))))
        ((string= verb "trim")
         (if (/= (length args) 2)
             (print-err "BADARG")
             (let* ((day-s (nth 0 args))
                    (to-s (nth 1 args))
                    (day (parse-int day-s))
                    (to (parse-int to-s)))
               (if (or (not (and day (<= 1 day 7)))
                       (not (and to (<= 1 to 12))))
                   (print-err "BADARG")
                   (let ((count 0))
                     (setf *state*
                           (mapcar (lambda (r)
                                     (if (and (= (fourth r) day)
                                              (<= (fifth r) to)
                                              (< to (sixth r)))
                                         (progn (incf count)
                                                (list (first r) (second r) (third r)
                                                      (fourth r) (fifth r) to))
                                         r))
                                   *state*))
                     (print-ok "trim" count))))))
        ((string= verb "clear")
         (if (/= (length args) 1)
             (print-err "BADARG")
             (let* ((day-s (first args))
                    (day (parse-int day-s)))
               (if (not (and day (<= 1 day 7)))
                   (print-err "BADARG")
                   (let ((count 0) (new-state nil))
                     (dolist (r *state*)
                       (if (= (fourth r) day)
                           (incf count)
                           (push r new-state)))
                     (setf *state* (nreverse new-state))
                     (print-ok "clear" count))))))
        ((string= verb "shift")
         (if (/= (length args) 2)
             (print-err "BADARG")
             (let* ((day-s (nth 0 args))
                    (delta-s (nth 1 args))
                    (day (parse-int day-s))
                    (delta (parse-int delta-s)))
               (if (or (not (and day (<= 1 day 7)))
                       (null delta))
                   (print-err "BADARG")
                   (let ((newday (+ day delta)))
                     (if (or (< newday 1) (> newday 7))
                         (print-err "BADARG")
                         (let ((count 0))
                           (setf *state*
                                 (mapcar (lambda (r)
                                           (if (= (fourth r) day)
                                               (progn (incf count)
                                                      (list (first r) (second r) (third r)
                                                            newday (fifth r) (sixth r)))
                                               r))
                                         *state*))
                           (print-ok "shift" count))))))))
        ((string= verb "copy")
         (if (/= (length args) 2)
             (print-err "BADARG")
             (let* ((name (nth 0 args))
                    (day-s (nth 1 args))
                    (day (parse-int day-s)))
               (if (or (not (valid-word-p name))
                       (not (and day (<= 1 day 7))))
                   (print-err "BADARG")
                   (let ((rec (find-rec name *state*)))
                     (if (null rec)
                         (print-err "NOTFOUND")
                         (let ((newname (concatenate 'string name "_2")))
                           (cond
                             ((not (valid-word-p newname)) (print-err "BADARG"))
                             ((find-rec newname *state*) (print-err "DUP"))
                             ((>= (length *state*) 20) (print-err "LIMIT"))
                             (t (push (list newname (second rec) (third rec)
                                            day (fifth rec) (sixth rec))
                                      *state*)
                                (print-ok "copy" 1)))))))))
        ((string= verb "merge")
         (if (/= (length args) 2)
             (print-err "BADARG")
             (let ((a (nth 0 args))
                   (b (nth 1 args)))
               (if (or (not (valid-word-p a))
                       (not (valid-word-p b)))
                   (print-err "BADARG")
                   (let ((rec-a (find-rec a *state*))
                         (rec-b (find-rec b *state*)))
                     (if (or (null rec-a) (null rec-b))
                         (print-err "NOTFOUND")
                         (if (string= a b)
                             (progn
                               (setf *state* (remove-rec a *state*))
                               (print-ok "merge" 2))
                             (let ((new-a (list a (second rec-b) (third rec-b)
                                                (fourth rec-a) (fifth rec-a) (sixth rec-a))))
                               (setf *state*
                                     (mapcar (lambda (r)
                                               (cond ((string= (first r) a) new-a)
                                                     ((string= (first r) b) nil)
                                                     (t r)))
                                             *state*))
                               (setf *state* (remove nil *state*))
                               (print-ok "merge" 2))))))))
        ((string= verb "sort")
         (if (/= (length args) 0)
             (print-err "BADARG")
             (print-ok "sort" 0)))
        ((string= verb "filter")
         (if (/= (length args) 1)
             (print-err "BADARG")
             (let* ((day-s (first args))
                    (day (parse-int day-s)))
               (if (not (and day (<= 1 day 7)))
                   (print-err "BADARG")
                   (let ((count (count-if (lambda (r) (= (fourth r) day)) *state*)))
                     (print-ok "filter" count))))))
        ((string= verb "count")
         (if (/= (length args) 0)
             (print-err "BADARG")
             (print-ok "count" (length *state*))))
        (t (print-err "BADARG"))))))

(defun main ()
  (let* ((args (sb-ext:*posix-argv*))
         (known '("add" "del" "edit" "move" "swap" "rename" "duplicate" "trim" "clear" "shift" "copy" "merge" "sort" "filter" "count")))
    (let ((cmds (member-if (lambda (s)
                             (let ((w (split-words s)))
                               (and w (member (string-downcase (first w)) known :test #'string=))))
                           args)))
      (dolist (cmd cmds)
        (process-command cmd))
      (format t "#state~%")
      (dolist (rec (sort (copy-list *state*) #'string< :key #'first))
        (format t "~a|~a|~a|~a|~a-~a~%"
                (first rec) (second rec) (third rec)
                (fourth rec) (fifth rec) (sixth rec))))))

(main)
