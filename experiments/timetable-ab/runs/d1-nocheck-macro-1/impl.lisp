;;;; v3 timetable ops executor -- macro arm.
;;;; Commands come from argv only; one result line per command goes to stdout.
;;;; No file I/O, no JSON, no third-party code. Pure ASCII.

(defvar *op-names* '())
(defvar *courses* '())
(defvar *ops* (make-hash-table :test #'equal))

(defstruct (course (:conc-name c-)) name teacher loc day from to)

(defun mk (x) (copy-course x))

(defun cat (a b) (concatenate 'string a b))

(defun put (st old new)
  (mapcar (lambda (x) (if (eq x old) new x)) st))

(defun tt (k src)
  (setf (c-day k) (c-day src)
        (c-from k) (c-from src)
        (c-to k) (c-to src))
  k)

(defun find-c (st nm) (find nm st :key #'c-name :test #'string=))

(defun clash-p (st day fr tx ex)
  (some (lambda (x)
          (and (not (eq x ex))
               (= (c-day x) day)
               (<= fr (c-to x))
               (<= (c-from x) tx)))
        st))

(defun bad-state-p (st)
  (loop for rest on st
        thereis (let ((x (car rest)))
                  (some (lambda (y)
                          (and (= (c-day x) (c-day y))
                               (<= (c-from x) (c-to y))
                               (<= (c-from y) (c-to x))))
                        (cdr rest)))))

(defun sint (s)
  (let ((i 0) (v 0) (neg nil) (n (length s)))
    (when (and (> n 0) (or (char= (char s 0) #\-) (char= (char s 0) #\+)))
      (setf neg (char= (char s 0) #\-))
      (setf i 1))
    (when (= i n) (return-from sint nil))
    (loop while (< i n) do
      (let ((d (digit-char-p (char s i))))
        (if d
            (setf v (+ (* v 10) d))
            (return-from sint nil)))
      (incf i))
    (if neg (- v) v)))

(defun ival (s lo hi)
  (let ((v (sint s)))
    (and v (<= lo v) (<= v hi) v)))

(defun word-p (s)
  (and (stringp s)
       (>= (length s) 1)
       (<= (length s) 12)
       (loop for ch across s
             always (and (> (char-code ch) 32) (< (char-code ch) 127)))))

(defun tag-p (s) (or (string= s "-") (word-p s)))

(defun tokens (s)
  (let ((out '())
        (buf (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
    (loop for ch across s do
      (if (or (char= ch #\Space) (char= ch #\Tab))
          (progn (push (coerce buf 'string) out)
                 (setf (fill-pointer buf) 0))
          (vector-push-extend ch buf)))
    (push (coerce buf 'string) out)
    (nreverse out)))

(defmacro fail (code)
  `(return-from op (values nil ,code)))

(defmacro defop (name params &body body)
  (when (member name *op-names* :test #'string=)
    (error "duplicate op name ~s" name))
  (push name *op-names*)
  `(setf (gethash ,name *ops*)
         (lambda (args st)
           (declare (ignorable st))
           (if (/= (length args) ,(length params))
               (values nil "BADARG")
               (block op
                 (let* (,@(loop for p in params
                                for i from 0
                                collect `(,p (nth ,i args))))
                   ,@(when params `((declare (ignorable ,@params))))
                   ,@body))))))

(defun compress-day (st day)
  (let* ((on (remove-if-not (lambda (x) (= (c-day x) day)) st))
         (ord (sort on (lambda (a b)
                         (or (< (c-from a) (c-from b))
                             (and (= (c-from a) (c-from b))
                                  (string< (c-name a) (c-name b)))))))
         (map '())
         (k 0))
    (dolist (x ord) (incf k) (push (cons x k) map))
    (let ((cnt 0) (out '()))
      (dolist (x st)
        (let ((hit (assoc x map :test #'eq)))
          (if (null hit)
              (push x out)
              (let ((y (mk x)))
                (setf (c-from y) (cdr hit))
                (setf (c-to y) (1+ (cdr hit)))
                (unless (and (= (c-from y) (c-from x))
                             (= (c-to y) (c-to x)))
                  (incf cnt))
                (push y out)))))
      (values cnt (nreverse out)))))

;;; ---- ops 1-15 ----

(defop "add" (nm tc lc d f t)
  (let ((day (ival d 1 7))
        (fr (ival f 1 12))
        (tx (ival t 1 12)))
    (unless (and (word-p nm) (tag-p tc) (tag-p lc) day fr tx (>= tx fr))
      (fail "BADARG"))
    (when (find-c st nm) (fail "DUP"))
    (when (>= (length st) 20) (fail "LIMIT"))
    (when (clash-p st day fr tx nil) (fail "CONFLICT"))
    (values 1 (cons (make-course :name nm :teacher tc :loc lc
                                 :day day :from fr :to tx)
                    st))))

(defop "del" (nm)
  (let ((x (find-c st nm)))
    (unless x (fail "NOTFOUND"))
    (values 1 (remove x st :test #'eq))))

(defop "edit" (nm tc lc)
  (let ((x (find-c st nm)))
    (unless x (fail "NOTFOUND"))
    (unless (and (tag-p tc) (tag-p lc)) (fail "BADARG"))
    (let ((k (mk x)))
      (setf (c-teacher k) tc)
      (setf (c-loc k) lc)
      (values 1 (put st x k)))))

(defop "move" (nm d f t)
  (let ((x (find-c st nm)))
    (unless x (fail "NOTFOUND"))
    (let ((day (ival d 1 7))
          (fr (ival f 1 12))
          (tx (ival t 1 12)))
      (unless (and day fr tx (>= tx fr)) (fail "BADARG"))
      (when (clash-p st day fr tx x) (fail "CONFLICT"))
      (let ((k (mk x)))
        (setf (c-day k) day)
        (setf (c-from k) fr)
        (setf (c-to k) tx)
        (values 1 (put st x k))))))

(defop "swap" (a b)
  (let ((x (find-c st a))
        (y (find-c st b)))
    (unless (and x y) (fail "NOTFOUND"))
    (let ((k (tt (mk x) y))
          (j (tt (mk y) x)))
      (values 2 (put (put st x k) y j)))))

(defop "rename" (o nw)
  (let ((x (find-c st o)))
    (unless x (fail "NOTFOUND"))
    (unless (word-p nw) (fail "BADARG"))
    (let ((e (find-c st nw)))
      (when (and e (not (eq e x))) (fail "DUP")))
    (let ((k (mk x)))
      (setf (c-name k) nw)
      (values 1 (put st x k)))))

(defop "duplicate" (nm nn)
  (let ((x (find-c st nm)))
    (unless x (fail "NOTFOUND"))
    (unless (word-p nn) (fail "BADARG"))
    (when (find-c st nn) (fail "DUP"))
    (when (>= (length st) 20) (fail "LIMIT"))
    (let ((k (mk x)))
      (setf (c-name k) nn)
      (values 1 (cons k st)))))

(defop "trim" (d t2)
  (let ((day (ival d 1 7))
        (tx (ival t2 1 12)))
    (unless (and day tx) (fail "BADARG"))
    (let ((cnt 0) (out '()))
      (dolist (x st)
        (if (and (= (c-day x) day)
                 (<= (c-from x) tx)
                 (< tx (c-to x)))
            (let ((k (mk x)))
              (setf (c-to k) tx)
              (incf cnt)
              (push k out))
            (push x out)))
      (values cnt (nreverse out)))))

(defop "clear" (d)
  (let ((day (ival d 1 7)))
    (unless day (fail "BADARG"))
    (let ((cnt 0) (out '()))
      (dolist (x st)
        (if (= (c-day x) day)
            (incf cnt)
            (push x out)))
      (values cnt (nreverse out)))))

(defop "shift" (d dl)
  (let ((day (ival d 1 7))
        (dl2 (sint dl)))
    (unless (and day dl2) (fail "BADARG"))
    (let ((nd (+ day dl2)))
      (unless (<= 1 nd 7) (fail "BADARG"))
      (let ((cnt 0) (out '()))
        (dolist (x st)
          (if (= (c-day x) day)
              (let ((k (mk x)))
                (setf (c-day k) nd)
                (incf cnt)
                (push k out))
              (push x out)))
        (values cnt (nreverse out))))))

(defop "copy" (nm d)
  (let ((x (find-c st nm)))
    (unless x (fail "NOTFOUND"))
    (let ((day (ival d 1 7)))
      (unless day (fail "BADARG"))
      (let ((nn (cat nm "_2")))
        (when (find-c st nn) (fail "DUP"))
        (when (>= (length st) 20) (fail "LIMIT"))
        (let ((k (mk x)))
          (setf (c-name k) nn)
          (setf (c-day k) day)
          (values 1 (cons k st)))))))

(defop "merge" (a b)
  (let ((x (find-c st a))
        (y (find-c st b)))
    (unless (and x y) (fail "NOTFOUND"))
    (let ((k (mk x)))
      (setf (c-teacher k) (c-teacher y))
      (setf (c-loc k) (c-loc y))
      (values 2 (put (remove y st :test #'eq) x k)))))

(defop "sort" ()
  (values 0 st))

(defop "filter" (d)
  (let ((day (ival d 1 7)))
    (unless day (fail "BADARG"))
    (values (count-if (lambda (x) (= (c-day x) day)) st) st)))

(defop "count" ()
  (values (length st) st))

;;; ---- ops 16-30 ----

(defop "swapTeacher" (a b)
  (let ((x (find-c st a))
        (y (find-c st b)))
    (unless (and x y) (fail "NOTFOUND"))
    (let ((ta (c-teacher x))
          (tb (c-teacher y)))
      (let ((k (mk x))
            (j (mk y)))
        (setf (c-teacher k) tb)
        (setf (c-teacher j) ta)
        (values 2 (put (put st x k) y j))))))

(defop "swapLoc" (a b)
  (let ((x (find-c st a))
        (y (find-c st b)))
    (unless (and x y) (fail "NOTFOUND"))
    (let ((la (c-loc x))
          (lb (c-loc y)))
      (let ((k (mk x))
            (j (mk y)))
        (setf (c-loc k) lb)
        (setf (c-loc j) la)
        (values 2 (put (put st x k) y j))))))

(defop "copyTo" (nm d f t)
  (let ((x (find-c st nm)))
    (unless x (fail "NOTFOUND"))
    (let ((day (ival d 1 7))
          (fr (ival f 1 12))
          (tx (ival t 1 12)))
      (unless (and day fr tx (>= tx fr)) (fail "BADARG"))
      (let ((nn (cat nm "_3")))
        (when (find-c st nn) (fail "DUP"))
        (when (>= (length st) 20) (fail "LIMIT"))
        (when (clash-p st day fr tx nil) (fail "CONFLICT"))
        (let ((k (mk x)))
          (setf (c-name k) nn)
          (setf (c-day k) day)
          (setf (c-from k) fr)
          (setf (c-to k) tx)
          (values 1 (cons k st)))))))

(defop "truncate" (d)
  (let ((day (ival d 1 7)))
    (unless day (fail "BADARG"))
    (let ((on (remove-if-not (lambda (x) (= (c-day x) day)) st)))
      (if (null on)
          (values 0 st)
          (let ((best (reduce (lambda (a b)
                                (if (string< (c-name a) (c-name b)) a b))
                              on)))
            (let ((cnt 0) (out '()))
              (dolist (x st)
                (if (and (= (c-day x) day) (not (eq x best)))
                    (incf cnt)
                    (push x out)))
              (values cnt (nreverse out))))))))

(defop "keep" (d n)
  (let ((day (ival d 1 7))
        (kk (sint n)))
    (unless (and day kk (>= kk 0)) (fail "BADARG"))
    (let* ((on (sort (remove-if-not (lambda (x) (= (c-day x) day)) st)
                     #'string< :key #'c-name))
           (stay (if (> (length on) kk) (subseq on 0 kk) on))
           (cnt 0)
           (out '()))
      (dolist (x st)
        (if (and (= (c-day x) day) (not (member x stay :test #'eq)))
            (incf cnt)
            (push x out)))
      (values cnt (nreverse out)))))

(defop "renameTeacher" (t1 t2)
  (unless (and (tag-p t1) (tag-p t2)) (fail "BADARG"))
  (let ((cnt 0) (out '()))
    (dolist (x st)
      (if (string= (c-teacher x) t1)
          (let ((k (mk x)))
            (setf (c-teacher k) t2)
            (incf cnt)
            (push k out))
          (push x out)))
    (values cnt (nreverse out))))

(defop "renameLoc" (l1 l2)
  (unless (and (tag-p l1) (tag-p l2)) (fail "BADARG"))
  (let ((cnt 0) (out '()))
    (dolist (x st)
      (if (string= (c-loc x) l1)
          (let ((k (mk x)))
            (setf (c-loc k) l2)
            (incf cnt)
            (push k out))
          (push x out)))
    (values cnt (nreverse out))))

(defop "dedupe" ()
  (let ((seen '()) (out '()) (cnt 0))
    (dolist (x (sort (copy-list st) #'string< :key #'c-name))
      (let ((key (list (c-teacher x) (c-loc x) (c-day x)
                       (c-from x) (c-to x))))
        (if (member key seen :test #'equal)
            (incf cnt)
            (progn (push key seen) (push x out)))))
    (values cnt (nreverse out))))

(defop "compress" (d)
  (let ((day (ival d 1 7)))
    (unless day (fail "BADARG"))
    (compress-day st day)))

(defop "compact" ()
  (let ((total 0))
    (dotimes (i 7)
      (multiple-value-bind (n s2) (compress-day st (1+ i))
        (incf total n)
        (setf st s2)))
    (values total st)))

(defop "mirror" (d d2)
  (let ((a (ival d 1 7))
        (b (ival d2 1 7)))
    (unless (and a b) (fail "BADARG"))
    (let ((on (remove-if-not (lambda (x) (= (c-day x) a)) st)))
      (when (some (lambda (x) (find-c st (cat (c-name x) "_m"))) on)
        (fail "DUP"))
      (when (> (+ (length st) (length on)) 20) (fail "LIMIT"))
      (let ((cnt 0))
        (dolist (x on)
          (let ((k (mk x)))
            (setf (c-name k) (cat (c-name x) "_m"))
            (setf (c-day k) b)
            (incf cnt)
            (push k st)))
        (values cnt st)))))

(defop "absorb" (a b)
  (let ((x (find-c st a))
        (y (find-c st b)))
    (unless (and x y) (fail "NOTFOUND"))
    (let ((k (mk x)))
      (setf (c-teacher k) (c-teacher y))
      (setf (c-loc k) (c-loc y))
      (values 2 (put st x k)))))

(defop "swapDays" (d1 d2)
  (let ((a (ival d1 1 7))
        (b (ival d2 1 7)))
    (unless (and a b) (fail "BADARG"))
    (let ((n1 0) (n2 0) (out '()))
      (dolist (x st)
        (cond ((= (c-day x) a)
               (incf n1)
               (let ((k (mk x)))
                 (setf (c-day k) b)
                 (push k out)))
              ((= (c-day x) b)
               (incf n2)
               (let ((k (mk x)))
                 (setf (c-day k) a)
                 (push k out)))
              (t (push x out))))
      (let ((new (nreverse out)))
        (when (bad-state-p new) (fail "CONFLICT"))
        (values (+ n1 n2) new)))))

(defop "promote" (nm)
  (let ((x (find-c st nm)))
    (unless x (fail "NOTFOUND"))
    (let* ((ln (1+ (- (c-to x) (c-from x))))
           (day (c-day x))
           (slot nil))
      (loop for f from 1 to 12 do
        (when (and (<= (+ f (1- ln)) 12)
                   (not (clash-p st day f (+ f (1- ln)) x)))
          (setf slot f)
          (return)))
      (if slot
          (let ((k (mk x)))
            (setf (c-from k) slot)
            (setf (c-to k) (+ slot (1- ln)))
            (values 1 (put st x k)))
          (values 1 st)))))

(defop "purge" (tc)
  (unless (tag-p tc) (fail "BADARG"))
  (let ((cnt 0) (out '()))
    (dolist (x st)
      (if (string= (c-teacher x) tc)
          (incf cnt)
          (push x out)))
    (values cnt (nreverse out))))

;;; ---- driver ----

(defun emit-err (code) (format t "err ~a~%" code))

(defun run-one (line)
  (let ((tk (tokens line))
        (dry nil))
    (when (and tk (string= (first tk) "--dry"))
      (setf dry t)
      (setf tk (rest tk)))
    (if (null tk)
        (emit-err "BADARG")
        (let ((verb (first tk))
              (args (rest tk)))
          (let ((fn (gethash verb *ops*)))
            (if (null fn)
                (emit-err "BADARG")
                (multiple-value-bind (n s2) (funcall fn args *courses*)
                  (if n
                      (progn
                        (unless dry (setf *courses* s2))
                        (format t "ok ~a ~a~%" verb n))
                      (emit-err s2)))))))))

(defun skip-arg-p (s)
  (let ((d (string-downcase s)))
    (or (member d '("--script" "--noinform" "--no-userinit" "--no-sysinit"
                    "--disable-debugger" "--end-toplevel-options")
                :test #'string=)
        (search "sbcl" d)
        (and (> (length d) 5)
             (string= ".lisp" (subseq d (- (length d) 5)))))))

(defun cmds ()
  (let ((a (sb-ext:*posix-argv*)))
    (loop while (and a (skip-arg-p (first a))) do (setf a (rest a)))
    a))

(defun main ()
  (dolist (line (cmds)) (run-one line))
  (format t "#state~%")
  (dolist (x (stable-sort (copy-list *courses*) #'string< :key #'c-name))
    (format t "~a|~a|~a|~a|~a-~a~%"
            (c-name x) (c-teacher x) (c-loc x)
            (c-day x) (c-from x) (c-to x))))

(main)
