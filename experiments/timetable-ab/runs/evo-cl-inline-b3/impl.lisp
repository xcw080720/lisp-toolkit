; v3 timetable ops executor -- inline style, Common Lisp (SBCL), ASCII only.
; No file I/O, no JSON, no third-party code. Input from argv, output to stdout.
; Course record: (name teacher loc day from to)

(defvar *courses* nil)
(defvar *out* nil)

(defun emit (line) (push line *out*))

(defun cname (c) (nth 0 c))
(defun cteacher (c) (nth 1 c))
(defun cloc (c) (nth 2 c))
(defun cday (c) (nth 3 c))
(defun cfrom (c) (nth 4 c))
(defun cto (c) (nth 5 c))

(defun mkcourse (nm tc lc dy fr to) (list nm tc lc dy fr to))

(defun ws-char-p (ch) (or (char= ch #\Space) (char= ch #\Tab)))

(defun word-p (s)
  (and (stringp s)
       (>= (length s) 1)
       (<= (length s) 12)
       (not (some #'ws-char-p s))))

(defun day-ok (x) (and (integerp x) (>= x 1) (<= x 7)))
(defun span-ok (x) (and (integerp x) (>= x 1) (<= x 12)))

(defun digits-only-p (s start)
  (let ((n (length s)) (ok t))
    (if (>= start n)
        nil
        (progn
          (loop for i from start below n
                do (unless (digit-char-p (char s i) 10) (setf ok nil)))
          ok))))

(defun digits-value (s start)
  (let ((v 0))
    (loop for i from start below (length s)
          do (setf v (+ (* v 10) (digit-char-p (char s i) 10))))
    v))

(defun parse-int (s)
  (if (stringp s)
      (let ((n (length s)))
        (cond ((and (> n 1) (char= (char s 0) #\-) (digits-only-p s 1))
               (- (digits-value s 1)))
              ((and (> n 1) (char= (char s 0) #\+) (digits-only-p s 1))
               (digits-value s 1))
              ((digits-only-p s 0) (digits-value s 0))
              (t nil)))
      nil))

(defun split-tokens (s)
  (let ((toks nil) (start nil) (n (length s)))
    (dotimes (i n)
      (if (ws-char-p (char s i))
          (when start
            (push (subseq s start i) toks)
            (setf start nil))
          (unless start (setf start i))))
    (when start (push (subseq s start n) toks))
    (nreverse toks)))

(defun find-course (nm)
  (find nm *courses* :key #'cname :test #'string=))

(defun conflict-p (dy fr to skip)
  (dolist (c *courses* nil)
    (when (and (not (eq c skip))
               (= (cday c) dy)
               (<= fr (cto c))
               (<= (cfrom c) to))
      (return t))))

(defun print-state ()
  (emit "#state")
  (let ((sorted (stable-sort (copy-list *courses*) #'string< :key #'cname)))
    (dolist (c sorted)
      (emit (format nil "~a|~a|~a|~a|~a-~a"
                    (cname c) (cteacher c) (cloc c) (cday c) (cfrom c) (cto c))))))

(defun run-one (cmd)
  (let* ((toks (split-tokens cmd))
         (op (first toks))
         (args (rest toks))
         (n (length args)))
    (cond

      ((null op) (emit "err BADARG"))

      ((string= op "add")
       (if (/= n 6)
           (emit "err BADARG")
           (let ((nm (nth 0 args))
                 (tc (nth 1 args))
                 (lc (nth 2 args))
                 (dy (parse-int (nth 3 args)))
                 (fr (parse-int (nth 4 args)))
                 (to (parse-int (nth 5 args))))
             (cond ((not (and (word-p nm) (word-p tc) (word-p lc)
                              (day-ok dy) (span-ok fr) (span-ok to)
                              (<= fr to)))
                    (emit "err BADARG"))
                   ((find-course nm) (emit "err DUP"))
                   ((>= (length *courses*) 20) (emit "err LIMIT"))
                   ((conflict-p dy fr to nil) (emit "err CONFLICT"))
                   (t (push (mkcourse nm tc lc dy fr to) *courses*)
                      (emit "ok add 1"))))))

      ((string= op "del")
       (if (/= n 1)
           (emit "err BADARG")
           (let ((c (find-course (nth 0 args))))
             (if (null c)
                 (emit "err NOTFOUND")
                 (progn
                   (setf *courses* (remove c *courses* :test #'eq))
                   (emit "ok del 1"))))))

      ((string= op "edit")
       (if (/= n 3)
           (emit "err BADARG")
           (let ((nm (nth 0 args)) (tc (nth 1 args)) (lc (nth 2 args)))
             (if (not (and (word-p tc) (word-p lc)))
                 (emit "err BADARG")
                 (let ((c (find-course nm)))
                   (if (null c)
                       (emit "err NOTFOUND")
                       (let ((d (copy-list c)))
                         (setf (nth 1 d) tc)
                         (setf (nth 2 d) lc)
                         (setf *courses* (substitute d c *courses* :test #'eq))
                         (emit "ok edit 1"))))))))

      ((string= op "move")
       (if (/= n 4)
           (emit "err BADARG")
           (let ((nm (nth 0 args))
                 (dy (parse-int (nth 1 args)))
                 (fr (parse-int (nth 2 args)))
                 (to (parse-int (nth 3 args))))
             (if (not (and (day-ok dy) (span-ok fr) (span-ok to) (<= fr to)))
                 (emit "err BADARG")
                 (let ((c (find-course nm)))
                   (cond ((null c) (emit "err NOTFOUND"))
                         ((conflict-p dy fr to c) (emit "err CONFLICT"))
                         (t (let ((d (copy-list c)))
                              (setf (nth 3 d) dy)
                              (setf (nth 4 d) fr)
                              (setf (nth 5 d) to)
                              (setf *courses*
                                    (substitute d c *courses* :test #'eq))
                              (emit "ok move 1")))))))))

      ((string= op "swap")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((ca (find-course (nth 0 args)))
                 (cb (find-course (nth 1 args))))
             (if (or (null ca) (null cb))
                 (emit "err NOTFOUND")
                 (progn
                   (unless (eq ca cb)
                     (let ((da (copy-list ca)) (db (copy-list cb)))
                       (setf (nth 3 da) (cday cb))
                       (setf (nth 4 da) (cfrom cb))
                       (setf (nth 5 da) (cto cb))
                       (setf (nth 3 db) (cday ca))
                       (setf (nth 4 db) (cfrom ca))
                       (setf (nth 5 db) (cto ca))
                       (setf *courses*
                             (mapcar (lambda (c)
                                       (cond ((eq c ca) da)
                                             ((eq c cb) db)
                                             (t c)))
                                     *courses*))))
                   (emit "ok swap 2"))))))

      ((string= op "rename")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((old (nth 0 args)) (new (nth 1 args)))
             (cond ((not (word-p new)) (emit "err BADARG"))
                   (t (let ((c (find-course old)))
                        (cond ((null c) (emit "err NOTFOUND"))
                              ((find-course new) (emit "err DUP"))
                              (t (let ((d (copy-list c)))
                                   (setf (nth 0 d) new)
                                   (setf *courses*
                                         (substitute d c *courses* :test #'eq))
                                   (emit "ok rename 1"))))))))))

      ((string= op "duplicate")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((nm (nth 0 args)) (nn (nth 1 args)))
             (cond ((not (word-p nn)) (emit "err BADARG"))
                   (t (let ((c (find-course nm)))
                        (cond ((null c) (emit "err NOTFOUND"))
                              ((find-course nn) (emit "err DUP"))
                              ((>= (length *courses*) 20) (emit "err LIMIT"))
                              (t (push (mkcourse nn (cteacher c) (cloc c)
                                                 (cday c) (cfrom c) (cto c))
                                       *courses*)
                                 (emit "ok duplicate 1")))))))))

      ((string= op "trim")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((dy (parse-int (nth 0 args))) (to (parse-int (nth 1 args))))
             (if (not (and (day-ok dy) (span-ok to)))
                 (emit "err BADARG")
                 (let ((k 0))
                   (setf *courses*
                         (mapcar (lambda (c)
                                   (if (and (= (cday c) dy)
                                            (<= (cfrom c) to)
                                            (< to (cto c)))
                                       (progn
                                         (incf k)
                                         (let ((d (copy-list c)))
                                           (setf (nth 5 d) to)
                                           d))
                                       c))
                                 *courses*))
                   (emit (format nil "ok trim ~a" k)))))))

      ((string= op "clear")
       (if (/= n 1)
           (emit "err BADARG")
           (let ((dy (parse-int (nth 0 args))))
             (if (not (day-ok dy))
                 (emit "err BADARG")
                 (let ((k (count-if (lambda (c) (= (cday c) dy)) *courses*)))
                   (setf *courses*
                         (remove-if (lambda (c) (= (cday c) dy)) *courses*))
                   (emit (format nil "ok clear ~a" k)))))))

      ((string= op "shift")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((dy (parse-int (nth 0 args))) (dl (parse-int (nth 1 args))))
             (if (not (and (day-ok dy) (integerp dl) (day-ok (+ dy dl))))
                 (emit "err BADARG")
                 (let ((k 0) (nd (+ dy dl)))
                   (setf *courses*
                         (mapcar (lambda (c)
                                   (if (= (cday c) dy)
                                       (progn
                                         (incf k)
                                         (let ((d (copy-list c)))
                                           (setf (nth 3 d) nd)
                                           d))
                                       c))
                                 *courses*))
                   (emit (format nil "ok shift ~a" k)))))))

      ((string= op "copy")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((nm (nth 0 args)) (dy (parse-int (nth 1 args))))
             (if (not (day-ok dy))
                 (emit "err BADARG")
                 (let ((c (find-course nm)))
                   (if (null c)
                       (emit "err NOTFOUND")
                       (let ((nn (concatenate 'string nm "_2")))
                         (cond ((find-course nn) (emit "err DUP"))
                               ((>= (length *courses*) 20) (emit "err LIMIT"))
                               (t (push (mkcourse nn (cteacher c) (cloc c)
                                                  dy (cfrom c) (cto c))
                                        *courses*)
                                  (emit "ok copy 1"))))))))))

      ((string= op "merge")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((ca (find-course (nth 0 args)))
                 (cb (find-course (nth 1 args))))
             (if (or (null ca) (null cb))
                 (emit "err NOTFOUND")
                 (let ((res nil))
                   (dolist (c *courses*)
                     (cond ((eq c cb) nil)
                           ((eq c ca)
                            (let ((d (copy-list c)))
                              (setf (nth 1 d) (cteacher cb))
                              (setf (nth 2 d) (cloc cb))
                              (push d res)))
                           (t (push c res))))
                   (setf *courses* (nreverse res))
                   (emit "ok merge 2"))))))

      ((string= op "sort")
       (if (/= n 0)
           (emit "err BADARG")
           (progn
             (setf *courses*
                   (stable-sort (copy-list *courses*) #'string< :key #'cname))
             (emit "ok sort 0"))))

      ((string= op "filter")
       (if (/= n 1)
           (emit "err BADARG")
           (let ((dy (parse-int (nth 0 args))))
             (if (not (day-ok dy))
                 (emit "err BADARG")
                 (emit (format nil "ok filter ~a"
                               (count-if (lambda (c) (= (cday c) dy))
                                         *courses*)))))))

      ((string= op "count")
       (if (/= n 0)
           (emit "err BADARG")
           (emit (format nil "ok count ~a" (length *courses*)))))

      ((string= op "swapTeacher")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((ca (find-course (nth 0 args)))
                 (cb (find-course (nth 1 args))))
             (if (or (null ca) (null cb))
                 (emit "err NOTFOUND")
                 (progn
                   (unless (eq ca cb)
                     (let ((da (copy-list ca)) (db (copy-list cb)))
                       (setf (nth 1 da) (cteacher cb))
                       (setf (nth 1 db) (cteacher ca))
                       (setf *courses*
                             (mapcar (lambda (c)
                                       (cond ((eq c ca) da)
                                             ((eq c cb) db)
                                             (t c)))
                                     *courses*))))
                   (emit "ok swapTeacher 2"))))))

      ((string= op "swapLoc")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((ca (find-course (nth 0 args)))
                 (cb (find-course (nth 1 args))))
             (if (or (null ca) (null cb))
                 (emit "err NOTFOUND")
                 (progn
                   (unless (eq ca cb)
                     (let ((da (copy-list ca)) (db (copy-list cb)))
                       (setf (nth 2 da) (cloc cb))
                       (setf (nth 2 db) (cloc ca))
                       (setf *courses*
                             (mapcar (lambda (c)
                                       (cond ((eq c ca) da)
                                             ((eq c cb) db)
                                             (t c)))
                                     *courses*))))
                   (emit "ok swapLoc 2"))))))

      ((string= op "copyTo")
       (if (/= n 4)
           (emit "err BADARG")
           (let ((nm (nth 0 args))
                 (dy (parse-int (nth 1 args)))
                 (fr (parse-int (nth 2 args)))
                 (to (parse-int (nth 3 args))))
             (if (not (and (day-ok dy) (span-ok fr) (span-ok to) (<= fr to)))
                 (emit "err BADARG")
                 (let ((c (find-course nm)))
                   (if (null c)
                       (emit "err NOTFOUND")
                       (let ((nn (concatenate 'string nm "_3")))
                         (cond ((find-course nn) (emit "err DUP"))
                               ((>= (length *courses*) 20) (emit "err LIMIT"))
                               ((conflict-p dy fr to nil)
                                (emit "err CONFLICT"))
                               (t (push (mkcourse nn (cteacher c) (cloc c)
                                                  dy fr to)
                                        *courses*)
                                  (emit "ok copyTo 1"))))))))))

      ((string= op "truncate")
       (if (/= n 1)
           (emit "err BADARG")
           (let ((dy (parse-int (nth 0 args))))
             (if (not (day-ok dy))
                 (emit "err BADARG")
                 (let ((best nil) (cnt 0))
                   (dolist (c *courses*)
                     (when (= (cday c) dy)
                       (incf cnt)
                       (if (or (null best) (string< (cname c) best))
                           (setf best (cname c)))))
                   (cond ((null best) (emit "ok truncate 0"))
                         (t (setf *courses*
                                  (remove-if (lambda (c)
                                               (and (= (cday c) dy)
                                                    (not (string= (cname c)
                                                                  best))))
                                             *courses*))
                            (emit (format nil "ok truncate ~a"
                                          (1- cnt))))))))))

      ((string= op "keep")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((dy (parse-int (nth 0 args)))
                 (want (parse-int (nth 1 args))))
             (if (not (and (day-ok dy) (integerp want) (>= want 0)))
                 (emit "err BADARG")
                 (let ((names nil) (cnt 0))
                   (dolist (c *courses*)
                     (when (= (cday c) dy)
                       (incf cnt)
                       (push (cname c) names)))
                   (let* ((srt (stable-sort names #'string<))
                          (lim (min want (length srt)))
                          (keeper nil))
                     (dotimes (i lim)
                       (push (nth i srt) keeper))
                     (setf *courses*
                           (remove-if (lambda (c)
                                        (and (= (cday c) dy)
                                             (not (member (cname c) keeper
                                                          :test #'string=))))
                                      *courses*))
                     (emit (format nil "ok keep ~a"
                                   (- cnt (length keeper))))))))))

      ((string= op "renameTeacher")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((t1 (nth 0 args)) (t2 (nth 1 args)))
             (if (not (and (word-p t1) (word-p t2)))
                 (emit "err BADARG")
                 (let ((k 0))
                   (dolist (c *courses*)
                     (when (string= (cteacher c) t1)
                       (incf k)
                       (setf (nth 1 c) t2)))
                   (emit (format nil "ok renameTeacher ~a" k)))))))

      ((string= op "renameLoc")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((l1 (nth 0 args)) (l2 (nth 1 args)))
             (if (not (and (word-p l1) (word-p l2)))
                 (emit "err BADARG")
                 (let ((k 0))
                   (dolist (c *courses*)
                     (when (string= (cloc c) l1)
                       (incf k)
                       (setf (nth 2 c) l2)))
                   (emit (format nil "ok renameLoc ~a" k)))))))

      ((string= op "dedupe")
       (if (/= n 0)
           (emit "err BADARG")
           (let ((drop nil))
             (dolist (c *courses*)
               (when (some (lambda (d)
                             (and (not (eq d c))
                                  (string= (cteacher d) (cteacher c))
                                  (string= (cloc d) (cloc c))
                                  (= (cday d) (cday c))
                                  (= (cfrom d) (cfrom c))
                                  (= (cto d) (cto c))
                                  (string< (cname d) (cname c))))
                           *courses*)
                 (push c drop)))
             (setf *courses*
                   (remove-if (lambda (c) (member c drop :test #'eq)) *courses*))
             (emit (format nil "ok dedupe ~a" (length drop))))))

      ((string= op "compress")
       (if (/= n 1)
           (emit "err BADARG")
           (let ((dy (parse-int (nth 0 args))))
             (if (not (day-ok dy))
                 (emit "err BADARG")
                 (let ((k 0) (idx 0))
                   (let ((daycs (remove-if-not (lambda (c) (= (cday c) dy))
                                               *courses*)))
                     (setf daycs (stable-sort (copy-list daycs) #'< :key #'cfrom))
                     (dolist (c daycs)
                       (incf idx)
                       (let ((nf idx) (nt (1+ idx)))
                         (unless (and (= (cfrom c) nf) (= (cto c) nt))
                           (incf k))
                         (setf (nth 4 c) nf)
                         (setf (nth 5 c) nt))))
                   (emit (format nil "ok compress ~a" k)))))))

      ((string= op "compact")
       (if (/= n 0)
           (emit "err BADARG")
           (let ((k 0))
             (loop for dy from 1 to 7
                   do (let ((idx 0))
                        (let ((daycs (remove-if-not (lambda (c) (= (cday c) dy))
                                                    *courses*)))
                          (setf daycs (stable-sort (copy-list daycs) #'<
                                                   :key #'cfrom))
                          (dolist (c daycs)
                            (incf idx)
                            (let ((nf idx) (nt (1+ idx)))
                              (unless (and (= (cfrom c) nf) (= (cto c) nt))
                                (incf k))
                              (setf (nth 4 c) nf)
                              (setf (nth 5 c) nt))))))
             (emit (format nil "ok compact ~a" k)))))

      ((string= op "mirror")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((d1 (parse-int (nth 0 args)))
                 (d2 (parse-int (nth 1 args))))
             (if (not (and (day-ok d1) (day-ok d2)))
                 (emit "err BADARG")
                 (let ((src (remove-if-not (lambda (c) (= (cday c) d1))
                                           *courses*))
                       (bad nil)
                       (news nil))
                   (dolist (c src)
                     (let ((nn (concatenate 'string (cname c) "_m")))
                       (when (find-course nn) (setf bad t))
                       (push (mkcourse nn (cteacher c) (cloc c) d2
                                       (cfrom c) (cto c))
                             news)))
                   (cond (bad (emit "err DUP"))
                         (t (setf *courses* (append (nreverse news) *courses*))
                            (emit (format nil "ok mirror ~a" (length news))))))))))

      ((string= op "absorb")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((ca (find-course (nth 0 args)))
                 (cb (find-course (nth 1 args))))
             (if (or (null ca) (null cb))
                 (emit "err NOTFOUND")
                 (progn
                   (setf (nth 1 ca) (cteacher cb))
                   (setf (nth 2 ca) (cloc cb))
                   (emit "ok absorb 2"))))))

      ((string= op "swapDays")
       (if (/= n 2)
           (emit "err BADARG")
           (let ((d1 (parse-int (nth 0 args)))
                 (d2 (parse-int (nth 1 args))))
             (if (not (and (day-ok d1) (day-ok d2)))
                 (emit "err BADARG")
                 (let ((cnt 0) (cand nil) (bad nil))
                   (dolist (c *courses*)
                     (let ((dy (cday c)))
                       (cond ((= dy d1)
                              (incf cnt)
                              (push (mkcourse (cname c) (cteacher c) (cloc c)
                                              d2 (cfrom c) (cto c))
                                    cand))
                             ((= dy d2)
                              (incf cnt)
                              (push (mkcourse (cname c) (cteacher c) (cloc c)
                                              d1 (cfrom c) (cto c))
                                    cand))
                             (t (push c cand)))))
                   (dolist (c cand)
                     (dolist (e cand)
                       (when (and (not (eq c e))
                                  (= (cday c) (cday e))
                                  (<= (cfrom c) (cto e))
                                  (<= (cfrom e) (cto c)))
                         (setf bad t))))
                   (cond (bad (emit "err CONFLICT"))
                         (t (setf *courses* (nreverse cand))
                            (emit (format nil "ok swapDays ~a" cnt)))))))))

      ((string= op "promote")
       (if (/= n 1)
           (emit "err BADARG")
           (let ((c (find-course (nth 0 args))))
             (if (null c)
                 (emit "err NOTFOUND")
                 (let* ((dy (cday c))
                        (len (1+ (- (cto c) (cfrom c))))
                        (last (- 13 len))
                        (pick nil)
                        (f 1))
                   (loop while (and (null pick) (<= f last))
                         do (if (conflict-p dy f (+ f (1- len)) c)
                                (incf f)
                                (setf pick f)))
                   (cond ((null pick) (emit "err CONFLICT"))
                         (t (setf (nth 4 c) pick)
                            (setf (nth 5 c) (+ pick (1- len)))
                            (emit "ok promote 1"))))))))

      ((string= op "purge")
       (if (/= n 1)
           (emit "err BADARG")
           (let ((tc (nth 0 args)))
             (if (not (word-p tc))
                 (emit "err BADARG")
                 (let ((k (count-if (lambda (c) (string= (cteacher c) tc))
                                    *courses*)))
                   (setf *courses*
                         (remove-if (lambda (c) (string= (cteacher c) tc))
                                    *courses*))
                   (emit (format nil "ok purge ~a" k)))))))

      (t (emit "err BADARG")))))

(let ((raw (rest sb-ext:*posix-argv*)))
  (dolist (cmd (remove-if (lambda (s)
                            (or (and (> (length s) 0) (char= (char s 0) #\-))
                                (search ".lisp" s)))
                          raw))
    (run-one cmd))
  (print-state)
  (dolist (line (nreverse *out*))
    (write-line line))
  (finish-output))
