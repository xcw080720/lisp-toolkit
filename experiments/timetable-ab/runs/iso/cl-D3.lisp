;;; impl.lisp — 课表 ops 执行器（add / del / edit / move / swap）
;;; 手写 JSON 读写：对象 = (cons :obj alist)（键序即输入顺序），数组 = (cons :arr list)。
;;; 空对象与 null 因此不混淆：空对象写回 {}。
;;; 5 个 op，量级远低于 defop 的交叉点（19–34），按 lisp-defop 的结论手写分派。

;; ---------- 值表示 ----------
;; :null :true :false | 字符串 | 整数/浮点 | (cons :obj alist) | (cons :arr list)

(defun obj (alist) (cons :obj alist))
(defun arr (list) (cons :arr list))
(defun objp (v) (and (consp v) (eq (car v) :obj)))
(defun arrp (v) (and (consp v) (eq (car v) :arr)))

(defparameter +ws+ (list #\Space #\Tab #\Newline #\Return))

;; ---------- JSON 读 ----------
(defun jparse (str)
  (let ((i 0) (n (length str)))
    (labels
      ((ws () (loop while (and (< i n) (member (char str i) +ws+)) do (incf i)))
       (err (m) (error "JSON 错误：~a（偏移 ~d）" m i))
       (peek () (if (< i n) (char str i) (err "意外结尾")))
       (eat (c) (if (and (< i n) (char= (char str i) c)) (incf i) (err (format nil "期望 ~c" c))))
       (hex4 ()
         (let ((v 0))
           (dotimes (k 4)
             (let ((d (digit-char-p (char str i) 16)))
               (unless d (err "坏 hex"))
               (setf v (+ (* v 16) d))
               (incf i)))
           v))
       (pstr ()
         (eat #\")
         (let ((out (make-string-output-stream)))
           (loop
             (when (>= i n) (err "字符串未闭合"))
             (let ((c (char str i)))
               (cond
                 ((char= c #\") (incf i) (return (get-output-stream-string out)))
                 ((char= c #\\)
                  (incf i)
                  (let ((e (if (< i n) (char str i) (err "转义未完成"))))
                    (incf i)
                    (case e
                      (#\" (write-char #\" out))
                      (#\\ (write-char #\\ out))
                      (#\/ (write-char #\/ out))
                      (#\b (write-char (code-char 8) out))
                      (#\f (write-char (code-char 12) out))
                      (#\n (write-char #\Newline out))
                      (#\r (write-char #\Return out))
                      (#\t (write-char #\Tab out))
                      (#\u
                       (let ((cp (hex4)))
                         (when (and (>= cp #xD800) (<= cp #xDBFF)
                                    (<= (+ i 6) n)
                                    (char= (char str i) #\\)
                                    (char= (char str (1+ i)) #\u))
                           (incf i 2)
                           (let ((lo (hex4)))
                             (when (and (>= lo #xDC00) (<= lo #xDFFF))
                               (setf cp (+ #x10000 (* 1024 (- cp #xD800)) (- lo #xDC00))))))
                         (write-char (code-char cp) out)))
                      (t (err "未知转义")))))
                 (t (write-char c out) (incf i)))))))
       (pnum ()
         (let ((st i))
           (loop while (and (< i n) (find (char str i) "0123456789+-.eE")) do (incf i))
           (let ((tok (subseq str st i)))
             (if (or (find #\. tok) (find #\e tok) (find #\E tok))
                 (let ((*read-default-float-format* 'double-float))
                   (coerce (read-from-string tok t nil) 'double-float))
                 (parse-integer tok)))))
       (pobj ()
         (eat #\{)
         (ws)
         (if (and (< i n) (char= (char str i) #\}))
             (progn (incf i) (obj nil))
             (let ((al '()))
               (loop
                 (ws)
                 (let ((k (pstr)))
                   (ws) (eat #\:)
                   (push (cons k (pval)) al))
                 (ws)
                 (cond ((and (< i n) (char= (char str i) #\,)) (incf i))
                       ((and (< i n) (char= (char str i) #\})) (incf i) (return))
                       (t (err "对象里期望 , 或 }"))))
               (obj (nreverse al)))))
       (parr ()
         (eat #\[)
         (ws)
         (if (and (< i n) (char= (char str i) #\]))
             (progn (incf i) (arr nil))
             (let ((l '()))
               (loop
                 (push (pval) l)
                 (ws)
                 (cond ((and (< i n) (char= (char str i) #\,)) (incf i))
                       ((and (< i n) (char= (char str i) #\])) (incf i) (return))
                       (t (err "数组里期望 , 或 ]"))))
               (arr (nreverse l)))))
       (pval ()
         (ws)
         (let ((c (peek)))
           (cond
             ((char= c #\{) (pobj))
             ((char= c #\[) (parr))
             ((char= c #\") (pstr))
             ((and (char= c #\t) (<= (+ i 4) n) (string= (subseq str i (+ i 4)) "true"))
              (incf i 4) :true)
             ((and (char= c #\f) (<= (+ i 5) n) (string= (subseq str i (+ i 5)) "false"))
              (incf i 5) :false)
             ((and (char= c #\n) (<= (+ i 4) n) (string= (subseq str i (+ i 4)) "null"))
              (incf i 4) :null)
             ((find c "-0123456789") (pnum))
             (t (err "未知值"))))))
      (let ((v (pval)))
        (ws)
        (when (< i n) (err "尾部多余内容"))
        v))))

;; ---------- JSON 写 ----------
(defun jnum (x)
  (cond
    ((integerp x) (format nil "~d" x))
    ((floatp x)
     (let ((s (format nil "~,6f" (coerce x 'double-float))))
       (let* ((dot (position #\. s))
              (end (length s)))
         (if dot
             (progn
               (loop while (and (> end (1+ dot)) (char= (char s (1- end)) #\0)) do (decf end))
               (when (char= (char s (1- end)) #\.) (decf end))
               (subseq s 0 end))
             s))))
    (t (format nil "~d" (round x)))))

(defun jwstr (s st)
  (write-char #\" st)
  (loop for ch across s do
    (cond
      ((char= ch #\") (write-string "\\\"" st))
      ((char= ch #\\) (write-string "\\\\" st))
      ((char= ch #\Newline) (write-string "\\n" st))
      ((char= ch #\Return) (write-string "\\r" st))
      ((char= ch #\Tab) (write-string "\\t" st))
      ((< (char-code ch) 32) (write-string (format nil "\\u~4,'0x" (char-code ch)) st))
      (t (write-char ch st))))
  (write-char #\" st))

(defun jw (v st)
  (cond
    ((eq v :null) (write-string "null" st))
    ((eq v :true) (write-string "true" st))
    ((eq v :false) (write-string "false" st))
    ((stringp v) (jwstr v st))
    ((numberp v) (write-string (jnum v) st))
    ((objp v)
     (write-char #\{ st)
     (let ((first t))
       (loop for (k . val) in (cdr v) do
         (if first (setf first nil) (write-char #\, st))
         (jwstr k st)
         (write-char #\: st)
         (jw val st)))
     (write-char #\} st))
    ((arrp v)
     (write-char #\[ st)
     (let ((first t))
       (loop for e in (cdr v) do
         (if first (setf first nil) (write-char #\, st))
         (jw e st)))
     (write-char #\] st))
    (t (write-string "null" st))))

;; ---------- alist 访问 ----------
(defun aget* (o k) (and (objp o) (assoc k (cdr o) :test #'string=)))
(defun aget (o k) (let ((c (aget* o k))) (and c (cdr c))))
(defun aset (o k v)
  (let ((c (assoc k (cdr o) :test #'string=)))
    (if c
        (setf (cdr c) v)
        (setf (cdr o) (append (cdr o) (list (cons k v)))))
    v))

;; ---------- 字段规整 ----------
(defun num-int (v d)
  (cond ((integerp v) v)
        ((numberp v) (round v))
        (t d)))
(defun clamp (x lo hi) (max lo (min hi x)))
(defun i-day (v) (clamp (num-int v 1) 1 7))
(defun i-per (v) (max 1 (num-int v 1)))
(defun default-weeks ()
  (obj (list (cons "type" "range") (cons "from" 1) (cons "to" 16))))
(defun norm-weeks (v) (if (and (objp v) (cdr v)) v (default-weeks)))

(defun make-course (src)
  (let* ((pf (i-per (aget src "periodFrom")))
         (pt (max (i-per (aget src "periodTo")) pf))
         (tv (aget src "tag")))
    (obj (list (cons "name" (let ((v (aget src "name"))) (if (stringp v) v "")))
               (cons "teacher" (let ((v (aget src "teacher"))) (if (stringp v) v "")))
               (cons "location" (let ((v (aget src "location"))) (if (stringp v) v "")))
               (cons "day" (i-day (aget src "day")))
               (cons "periodFrom" pf)
               (cons "periodTo" pt)
               (cons "weeks" (norm-weeks (aget src "weeks")))
               (cons "tag" (if (null tv) :null tv))))))

(defun apply-patch (c set)
  (when (objp set)
    (loop for (k . v) in (cdr set) do
      (cond ((string= k "day") (aset c k (i-day v)))
            ((string= k "periodFrom") (aset c k (i-per v)))
            ((string= k "periodTo") (aset c k (i-per v)))
            ((string= k "weeks") (aset c k (norm-weeks v)))
            (t (aset c k v)))))
  (let ((pf (aget c "periodFrom")) (pt (aget c "periodTo")))
    (when (and (numberp pf) (numberp pt) (> pf pt)) (aset c "periodTo" pf)))
  c)

(defun hits (courses m)
  (if (stringp m)
      (remove-if-not (lambda (c)
                       (let ((nm (aget c "name")))
                         (and (stringp nm) (search m nm) t)))
                     courses)
      '()))

;; ---------- op 执行 ----------
(defparameter +known+ '("add" "del" "edit" "move" "swap"))

(defun op-name (op) (let ((v (aget op "op"))) (if (stringp v) v "")))

(defun run-all (courses ops)
  (let ((log '()) (n 0))
    (labels ((emit (fmt &rest args)
               (push (format nil "~d) ~a" (length log) (apply #'format nil fmt args)) log))
             (bump (k) (incf n k)))
      (dolist (op ops)
        (let ((name (op-name op)))
          (cond
            ((string= name "add")
             (let ((c (make-course (aget op "course"))))
               (push c courses)
               (bump 1)
               (emit "加「~a」" (aget c "name"))))
            ((string= name "del")
             (let* ((m (aget op "match"))
                    (hs (hits courses m)))
               (if hs
                   (progn (setf courses (remove-if (lambda (c) (member c hs)) courses))
                          (bump (length hs))
                          (emit "删「~a」共 ~d 门" m (length hs)))
                   (emit "没找到「~a」" m))))
            ((string= name "edit")
             (let* ((m (aget op "match"))
                    (hs (hits courses m)))
               (if hs
                   (progn (dolist (c hs) (apply-patch c (aget op "set")))
                          (bump (length hs))
                          (emit "改「~a」共 ~d 门" m (length hs)))
                   (emit "没找到「~a」" m))))
            ((string= name "move")
             (let ((m (aget op "match")) (d (aget op "day"))
                   (pf (aget op "periodFrom")) (pt (aget op "periodTo")))
               (if (or (null m) (null d) (null pf) (null pt))
                   (emit "跳过：move 缺 day/periodFrom/periodTo")
                   (let ((hs (hits courses m)))
                     (if hs
                         (progn (dolist (c hs)
                                  (aset c "day" (i-day d))
                                  (aset c "periodFrom" (i-per pf))
                                  (aset c "periodTo" (i-per pt)))
                                (bump (length hs))
                                (emit "移动 ~d 门到第 ~d 天" (length hs) (i-day d)))
                         (emit "没找到「~a」" m))))))
            ((string= name "swap")
             (let* ((m (aget op "match")) (w (aget op "with"))
                    (a (hits courses m)) (b (hits courses w)))
               (if (and (= (length a) 1) (= (length b) 1))
                   (let ((ca (car a)) (cb (car b)))
                     (dolist (k '("day" "periodFrom" "periodTo"))
                       (let ((va (aget ca k)) (vb (aget cb k)))
                         (aset ca k vb)
                         (aset cb k va)))
                     (bump 2)
                     (emit "互换「~a」与「~a」" m w))
                   (emit "跳过：swap 需两侧各命中恰好 1 门"))))
            (t (emit "拒绝：未知 op ~a" name))))))
    (values courses (nreverse log) n)))

;; ---------- 入口 ----------
(defun slurp (path)
  (with-open-file (s path :external-format :utf-8)
    (let ((out (make-string-output-stream)))
      (loop for line = (read-line s nil nil)
            while line
            do (write-string line out) (write-char #\Newline out))
      (get-output-stream-string out))))

(defun main ()
  (let* ((path (car (last sb-ext:*posix-argv*)))
         (root (jparse (slurp path)))
         (courses (let ((v (aget root "courses"))) (if (arrp v) (copy-list (cdr v)) '())))
         (ops (let ((v (aget root "ops"))) (if (arrp v) (cdr v) '())))
         (bad (find-if (lambda (op)
                         (let ((nm (op-name op)))
                           (not (member nm +known+ :test #'string=))))
                       ops)))
    (if bad
        (jw (obj (list (cons "opsText" "")
                       (cons "courses" (arr courses))
                       (cons "log" (arr (list (format nil "1) 拒绝：未知 op ~a" (op-name bad)))))
                       (cons "n" 0)))
            *standard-output*)
        (multiple-value-bind (cs lg n) (run-all courses ops)
          (jw (obj (list (cons "opsText" (format nil "~{~a~^ ~}" (mapcar #'op-name ops)))
                         (cons "courses" (arr cs))
                         (cons "log" (arr lg))
                         (cons "n" n)))
              *standard-output*)))
    (terpri *standard-output*)
    (finish-output *standard-output*)))

(main)
