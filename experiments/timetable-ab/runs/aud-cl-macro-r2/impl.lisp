;;;; v3 timetable ops executor -- macro style.
;;;; One DEFOP form per op: arity check, range check, dispatch,
;;;; registration and the ok/err text are all generated by the macro.

(defstruct course name teacher loc day from to)

(defvar *courses* nil)
(defvar *ops* nil)

(defun word-p (s)
  (and (stringp s) (plusp (length s)) (<= (length s) 12)))

(defun int-any (s)
  (ignore-errors (parse-integer s :junk-allowed nil)))

(defun int-in (s lo hi)
  (let ((v (int-any s)))
    (and v (<= lo v hi) v)))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'equal))

(defun busy-p (day from to &optional except)
  (some (lambda (c)
          (and (eql (course-day c) day)
               (not (eq c except))
               (<= from (course-to c))
               (<= (course-from c) to)))
        *courses*))

(defun full-p () (>= (length *courses*) 20))

(defmacro ok (n) `(return-from op-body (values :ok ,n)))
(defmacro err (code) `(return-from op-body (values ,code 0)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun arg-form (spec raw)
    (ecase (first spec)
      (:word `(and (word-p ,raw) ,raw))
      (:num `(int-any ,raw))
      (:rng `(int-in ,raw ,(third spec) ,(fourth spec)))))
  ;; BINDINGS flattens into ONE let*, so the bindings stay visible to the
  ;; generated range checks and to the op body that follow it.
  (defun arg-binds (specs i raw)
    (when specs
      (let* ((spec (first specs))
             (g (gensym "A")))
        (list* (list g `(nth ,i ,raw))
               (list (second spec) (arg-form spec g))
               (arg-binds (rest specs) (1+ i) raw))))))

(defmacro defop (name specs checks &body body)
  (let ((raw (gensym "RAW"))
        (vars (mapcar #'second specs)))
    `(setf *ops*
           (acons ,name
                  (lambda (,raw)
                    (block op-body
                      (unless (= (length ,raw) ,(length specs))
                        (return-from op-body (values :badarg 0)))
                      (let* ,(arg-binds specs 0 raw)
                        (unless (and ,@vars)
                          (return-from op-body (values :badarg 0)))
                        ,@(when checks
                            `((unless (and ,@checks)
                                (return-from op-body (values :badarg 0)))))
                        ,@body)))
                  *ops*))))

(defop "add"
  ((:word name) (:word teacher) (:word loc)
   (:rng day 1 7) (:rng from 1 12) (:rng to 1 12))
  ((<= from to))
  (when (find-course name) (err :dup))
  (when (busy-p day from to) (err :conflict))
  (when (full-p) (err :limit))
  (push (make-course :name name :teacher teacher :loc loc
                     :day day :from from :to to)
        *courses*)
  (ok 1))

(defop "del" ((:word name)) ()
  (let ((c (find-course name)))
    (unless c (err :notfound))
    (setf *courses* (delete c *courses*))
    (ok 1)))

(defop "edit" ((:word name) (:word teacher) (:word loc)) ()
  (let ((c (find-course name)))
    (unless c (err :notfound))
    (setf (course-teacher c) teacher
          (course-loc c) loc)
    (ok 1)))

(defop "move"
  ((:word name) (:rng day 1 7) (:rng from 1 12) (:rng to 1 12))
  ((<= from to))
  (let ((c (find-course name)))
    (unless c (err :notfound))
    (when (busy-p day from to c) (err :conflict))
    (setf (course-day c) day
          (course-from c) from
          (course-to c) to)
    (ok 1)))

(defop "swap" ((:word a) (:word b)) ()
  (let ((x (find-course a)) (y (find-course b)))
    (unless (and x y) (err :notfound))
    (rotatef (course-day x) (course-day y))
    (rotatef (course-from x) (course-from y))
    (rotatef (course-to x) (course-to y))
    (ok 2)))

(defop "rename" ((:word old) (:word new)) ()
  (let ((c (find-course old)))
    (unless c (err :notfound))
    (when (find-course new) (err :dup))
    (setf (course-name c) new)
    (ok 1)))

(defop "duplicate" ((:word name) (:word newname)) ()
  (let ((c (find-course name)))
    (unless c (err :notfound))
    (when (find-course newname) (err :dup))
    (when (full-p) (err :limit))
    (push (copy-course c :name newname) *courses*)
    (ok 1)))

(defop "trim" ((:rng day 1 7) (:rng to 1 12)) ()
  (let ((n 0))
    (dolist (c *courses*)
      (when (and (eql (course-day c) day)
                 (<= (course-from c) to)
                 (< to (course-to c)))
        (setf (course-to c) to)
        (incf n)))
    (ok n)))

(defop "clear" ((:rng day 1 7)) ()
  (let ((n (count day *courses* :key #'course-day :test #'eql)))
    (setf *courses* (remove day *courses* :key #'course-day :test #'eql))
    (ok n)))

(defop "shift" ((:rng day 1 7) (:num delta)) ()
  (let ((nd (+ day delta)))
    (unless (<= 1 nd 7) (err :badarg))
    (let ((n 0))
      (dolist (c *courses*)
        (when (eql (course-day c) day)
          (setf (course-day c) nd)
          (incf n)))
      (ok n))))

(defop "copy" ((:word name) (:rng day 1 7)) ()
  (let ((c (find-course name)))
    (unless c (err :notfound))
    (let ((newname (concatenate 'string (course-name c) "_2")))
      (when (find-course newname) (err :dup))
      (when (full-p) (err :limit))
      (push (copy-course c :name newname :day day) *courses*)
      (ok 1))))

(defop "merge" ((:word a) (:word b)) ()
  (let ((x (find-course a)) (y (find-course b)))
    (unless (and x y) (err :notfound))
    (setf (course-teacher x) (course-teacher y)
          (course-loc x) (course-loc y))
    (setf *courses* (delete y *courses*))
    (ok 2)))

(defop "sort" () ()
  (setf *courses* (sort *courses* #'string< :key #'course-name))
  (ok 0))

(defop "filter" ((:rng day 1 7)) ()
  (ok (count day *courses* :key #'course-day :test #'eql)))

(defop "count" () ()
  (ok (length *courses*)))

(defun tokenize (line)
  (let ((tokens nil) (start nil) (len (length line)))
    (dotimes (i len)
      (if (or (char= (char line i) #\Space)
              (char= (char line i) #\Tab))
          (when start
            (push (subseq line start i) tokens)
            (setf start nil))
          (unless start (setf start i))))
    (when start (push (subseq line start) tokens))
    (nreverse tokens)))

(defun drop-launcher (args)
  (loop while (and args
                   (let ((a (first args)))
                     (or (and (plusp (length a)) (char= (char a 0) #\-))
                         (search ".lisp" a)
                         (search "sbcl" (string-downcase a)))))
        do (pop args)
        finally (return args)))

(defun code-name (code)
  (case code
    (:dup "DUP")
    (:notfound "NOTFOUND")
    (:badarg "BADARG")
    (:conflict "CONFLICT")
    (:limit "LIMIT")
    (t "BADARG")))

(defun run-command (line)
  (let* ((tokens (tokenize line))
         (verb (first tokens))
         (hit (and verb (assoc verb *ops* :test #'equal))))
    (if hit
        (multiple-value-bind (status n) (funcall (cdr hit) (rest tokens))
          (values status n verb))
        (values :badarg 0 ""))))

(defun print-state ()
  (format t "#state~%")
  (dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
    (format t "~a|~a|~a|~d|~d-~d~%"
            (course-name c) (course-teacher c) (course-loc c)
            (course-day c) (course-from c) (course-to c))))

(defun main ()
  (dolist (cmd (drop-launcher sb-ext:*posix-argv*))
    (multiple-value-bind (status n verb) (run-command cmd)
      (if (eq status :ok)
          (format t "ok ~a ~d~%" verb n)
          (format t "err ~a~%" (code-name status)))))
  (print-state)
  (finish-output))

(main)
