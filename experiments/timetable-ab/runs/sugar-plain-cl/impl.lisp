;;;; impl.lisp —— plain-cl 形态
;;;; 强制：do 宏 / labels 手写递归 / concatenate 拼串 / cond 显式分支 / push + nreverse 累积
;;;; 全程只用正规形式：不写宏糖、不做格式化输出、不传函数给库函数

(defun split-on (str sep)
  (labels ((walk (i start acc)
             (cond ((>= i (length str))
                    (nreverse (cons (subseq str start i) acc)))
                   ((char= (char str i) sep)
                    (walk (1+ i) (1+ i) (cons (subseq str start i) acc)))
                   (t (walk (1+ i) start acc)))))
    (walk 0 0 nil)))

(defun before-p (a b kind)
  (cond ((eq kind :key) (< (car a) (car b)))
        ((eq kind :slot)
         (let ((da (getf a :day))
               (db (getf b :day)))
           (cond ((< da db) t)
                 ((> da db) nil)
                 (t (< (getf a :pf) (getf b :pf))))))
        (t nil)))

(defun arrange (lst kind)
  (labels ((take-n (l n acc)
             (cond ((or (zerop n) (null l)) (nreverse acc))
                   (t (take-n (cdr l) (1- n) (cons (car l) acc)))))
           (drop-n (l n)
             (cond ((or (zerop n) (null l)) l)
                   (t (drop-n (cdr l) (1- n)))))
           (merge2 (a b acc)
             (cond ((null a) (append (nreverse acc) b))
                   ((null b) (append (nreverse acc) a))
                   ((before-p (car a) (car b) kind)
                    (merge2 (cdr a) b (cons (car a) acc)))
                   (t (merge2 a (cdr b) (cons (car b) acc)))))
           (mix (l)
             (cond ((null l) nil)
                   ((null (cdr l)) l)
                   (t (let* ((n (length l))
                             (h (floor n 2)))
                        (merge2 (mix (take-n l h nil))
                                (mix (drop-n l h))
                                nil))))))
    (mix lst)))

(defun sum-by (lst key)
  (let ((acc nil))
    (do ((rest lst (cdr rest)))
        ((endp rest) (arrange acc :key))
      (let* ((item (car rest))
             (k (getf item key))
             (v (getf item :v))
             (cell (and k (assoc k acc))))
        (cond ((null k) nil)
              ((not (numberp v)) nil)
              (cell (setf (cdr cell) (+ (cdr cell) v)))
              (t (push (cons k v) acc)))))))

(defun pick (obj path)
  (labels ((key-of (seg) (intern (string-upcase seg) :keyword))
           (walk (node segs)
             (cond ((null segs) node)
                   ((null node) nil)
                   ((not (listp node)) nil)
                   (t (let ((next (getf node (key-of (car segs)))))
                        (cond ((null next) nil)
                              (t (walk next (cdr segs)))))))))
    (cond ((null obj) nil)
          ((string= path "") nil)
          (t (walk obj (split-on path #\.))))))

(defun day-name (n)
  (cond ((= n 1) "周一")
        ((= n 2) "周二")
        ((= n 3) "周三")
        ((= n 4) "周四")
        ((= n 5) "周五")
        ((= n 6) "周六")
        ((= n 7) "周日")
        (t (concatenate 'string "周" (princ-to-string n)))))

(defun fmt-one (item)
  (concatenate 'string
               (day-name (getf item :day))
               " "
               (princ-to-string (getf item :pf))
               "-"
               (princ-to-string (getf item :pt))
               " "
               (getf item :name)))

(defun join-strings (lst sep)
  (labels ((walk (l acc)
             (cond ((null l) (cond ((null acc) "") (t acc)))
                   ((null acc) (walk (cdr l) (car l)))
                   (t (walk (cdr l) (concatenate 'string acc sep (car l)))))))
    (walk lst nil)))

(defun fmt (lst)
  (let ((items (arrange lst :slot))
        (parts nil))
    (do ((rest items (cdr rest)))
        ((endp rest))
      (push (fmt-one (car rest)) parts))
    (join-strings (nreverse parts) "；")))
