;; ctl8b —— scale.spec 前 5 个 op（add/del/edit/move/swap）+ 输出契约
;; 边界：JSON 读出的 (:obj . alist) 只在 un / wr 两处与裸 alist 互转

;; ===== JSON 读 =====
(defun wsp (s i)
  (loop while (and (< i (length s)) (find (char s i) '(#\Space #\Tab #\Newline #\Return)))
        do (incf i) finally (return i)))

(defun rstr (s i)
  (let ((o (make-string-output-stream)))
    (loop
      (let ((c (char s i)))
        (cond ((char= c #\") (return (values (get-output-stream-string o) (1+ i))))
              ((char= c #\\)
               (incf i)
               (let ((e (char s i)))
                 (case e
                   (#\n (write-char #\Newline o))
                   (#\t (write-char #\Tab o))
                   (#\r (write-char #\Return o))
                   (#\b (write-char (code-char 8) o))
                   (#\f (write-char (code-char 12) o))
                   (#\u (write-char (code-char (parse-integer s :start (1+ i) :end (+ i 5) :radix 16)) o)
                        (incf i 4))
                   (t (write-char e o)))
                 (incf i)))
              (t (write-char c o) (incf i)))))))

(defun rnum (s i)
  (let ((j i))
    (loop while (and (< j (length s)) (find (char s j) "+-.eE0123456789")) do (incf j))
    (values (read-from-string (subseq s i j)) j)))

(defun rval (s i)
  (let ((i (wsp s i)))
    (case (char s i)
      (#\{ (robj s (1+ i)))
      (#\[ (rarr s (1+ i)))
      (#\" (rstr s (1+ i)))
      (#\t (values t (+ i 4)))
      (#\f (values :false (+ i 5)))
      (#\n (values :null (+ i 4)))
      (t (rnum s i)))))

(defun robj (s i)
  (let ((acc '()) (i (wsp s i)))
    (if (char= (char s i) #\})
        (values (cons :obj nil) (1+ i))
        (loop
          (multiple-value-bind (k j) (rstr s (1+ i))
            (multiple-value-bind (v j2) (rval s (wsp s (1+ (wsp s j))))
              (push (cons k v) acc)
              (let ((j3 (wsp s j2)))
                (if (char= (char s j3) #\,)
                    (setf i (1+ j3))
                    (return (values (cons :obj (nreverse acc)) (1+ j3)))))))))))

(defun rarr (s i)
  (let ((acc '()) (i (wsp s i)))
    (if (char= (char s i) #\])
        (values '() (1+ i))
        (loop
          (multiple-value-bind (v j) (rval s i)
            (push v acc)
            (let ((j2 (wsp s j)))
              (if (char= (char s j2) #\,)
                  (setf i (1+ j2))
                  (return (values (nreverse acc) (1+ j2))))))))))

;; ===== 边界：标签 ⇄ 裸值 =====
(defun un (v)
  (cond ((and (consp v) (eq (car v) :obj))
         (if (cdr v) (mapcar (lambda (p) (cons (car p) (un (cdr p)))) (cdr v)) :eobj))
        ((consp v) (mapcar #'un v))
        (t v)))

(defun wr (v)
  (cond ((eq v :eobj) '(:obj))
        ((and (consp v) (consp (car v)))
         (cons :obj (mapcar (lambda (p) (cons (car p) (wr (cdr p)))) v)))
        ((consp v) (mapcar #'wr v))
        (t v)))

;; ===== JSON 写 =====
(defun jn (l sep)
  (if l (with-output-to-string (o)
          (write-string (car l) o)
          (dolist (x (cdr l)) (write-string sep o) (write-string x o)))
      ""))

(defun wstr (v)
  (with-output-to-string (o)
    (write-char #\" o)
    (loop for c across v do
          (case c
            (#\" (write-string "\\\"" o))
            (#\\ (write-string "\\\\" o))
            (#\Newline (write-string "\\n" o))
            (#\Tab (write-string "\\t" o))
            (#\Return (write-string "\\r" o))
            (t (if (< (char-code c) 32)
                   (format o "\\u~4,'0x" (char-code c))
                   (write-char c o)))))
    (write-char #\" o)))

(defun jw (v)
  (cond ((eq v :null) "null")
        ((eq v :false) "false")
        ((eq v t) "true")
        ((null v) "[]")
        ((eq v :eobj) "{}")
        ((and (consp v) (eq (car v) :obj))
         (format nil "{~a}" (jn (loop for (k . x) in (cdr v)
                                      collect (format nil "~a:~a" (wstr k) (jw x)))
                                ",")))
        ((consp v) (format nil "[~a]" (jn (mapcar #'jw v) ",")))
        ((stringp v) (wstr v))
        ((integerp v) (format nil "~d" v))
        ((realp v) (format nil "~f" v))
        (t (format nil "~a" v))))

;; ===== 业务层：只看到裸 alist 与标量 =====
(defvar *c* nil)
(defvar *l* nil)
(defvar *n* 0)

(defun cget (a k) (cdr (assoc k a :test #'equal)))
(defun cset (a k v)
  (let ((p (assoc k a :test #'equal)))
    (if p (setf (cdr p) v) (nconc a (list (cons k v)))))
  v)
(defun emit (f &rest a) (push (apply #'format nil f a) *l*))
(defun ci (x lo hi) (max lo (min hi (if (realp x) (round x) lo))))

(defun norm (c)
  (cset c "day" (ci (cget c "day") 1 7))
  (cset c "periodFrom" (ci (cget c "periodFrom") 1 99))
  (cset c "periodTo" (ci (cget c "periodTo") 1 99))
  (when (> (cget c "periodFrom") (cget c "periodTo"))
    (cset c "periodTo" (cget c "periodFrom")))
  c)

(defun op-add (op)
  (let ((c (copy-tree (cget op "course"))))
    (unless (cget c "weeks")
      (cset c "weeks" '(("type" . "range") ("from" . 1) ("to" . 16))))
    (norm c)
    (setf *c* (append *c* (list c)))
    (emit "加「~a」" (cget c "name"))
    1))

(defun op-del (op)
  (let* ((m (or (cget op "match") ""))
         (old *c*)
         (new (remove-if (lambda (c) (search m (cget c "name"))) old)))
    (if (= (length old) (length new))
        (progn (emit "没找到「~a」" m) 0)
        (progn (setf *c* new)
               (emit "删掉 ~d 条「~a」" (- (length old) (length new)) m)
               (- (length old) (length new))))))

(defun op-edit (op)
  (let ((m (or (cget op "match") "")) (set (cget op "set")) (k 0))
    (dolist (c *c*)
      (when (search m (cget c "name"))
        (dolist (p set) (cset c (car p) (cdr p)))
        (norm c)
        (incf k)))
    (if (plusp k) (emit "改 ~d 门「~a」" k m) (emit "没找到「~a」" m))
    k))

(defun op-move (op)
  (let ((m (or (cget op "match") "")) (d (cget op "day"))
        (f (cget op "periodFrom")) (pt (cget op "periodTo")))
    (if (or (null d) (null f) (null pt))
        (progn (emit "缺字段，不执行") 0)
        (let ((k 0))
          (dolist (c *c*)
            (when (search m (cget c "name"))
              (cset c "day" (ci d 1 7))
              (cset c "periodFrom" (ci f 1 99))
              (cset c "periodTo" (ci pt 1 99))
              (norm c)
              (incf k)))
          (if (plusp k) (emit "移动 ~d 门到周 ~d" k (ci d 1 7)) (emit "没找到「~a」" m))
          k))))

(defun op-swap (op)
  (let* ((m (or (cget op "match") "")) (w (or (cget op "with") ""))
         (a (remove-if-not (lambda (c) (search m (cget c "name"))) *c*))
         (b (remove-if-not (lambda (c) (search w (cget c "name"))) *c*)))
    (if (and (= (length a) 1) (= (length b) 1))
        (let ((x (car a)) (y (car b)))
          (dolist (k '("day" "periodFrom" "periodTo"))
            (rotatef (cdr (assoc k x :test #'equal)) (cdr (assoc k y :test #'equal))))
          (emit "换「~a」和「~a」的时间" (cget x "name") (cget y "name"))
          2)
        (progn (emit "「~a」匹配数不为 1，跳过" m) 0))))

(defparameter *ops*
  (list (cons "add" #'op-add) (cons "del" #'op-del) (cons "edit" #'op-edit)
        (cons "move" #'op-move) (cons "swap" #'op-swap)))

(defun slurp (p)
  (with-open-file (s p :external-format :utf-8)
    (with-output-to-string (o)
      (loop for l = (read-line s nil nil) while l do (write-string l o)))))

(defun main ()
  (let* ((doc (un (rval (slurp (car (last sb-ext:*posix-argv*))) 0)))
         (ops (cget doc "ops"))
         (orig (cget doc "courses"))
         (bad nil))
    (setf *c* (copy-tree orig) *l* nil *n* 0)
    (dolist (op ops)
      (let ((f (cdr (assoc (cget op "op") *ops* :test #'equal))))
        (if f
            (incf *n* (funcall f op))
            (progn (setf bad (cget op "op")) (return)))))
    (let ((msgs (reverse *l*)))
      (write-string
       (jw (list :obj
                 (cons "opsText" (if bad "" (jn msgs "；")))
                 (cons "courses" (mapcar #'wr (if bad orig *c*)))
                 (cons "log" (if bad (list (format nil "1) 拒绝：未知 op ~a" bad))
                               (loop for m in msgs for i from 1
                                     collect (format nil "~d) ~a" i m))))
                 (cons "n" (if bad 0 *n*))))
       *standard-output*)
      (terpri))))

(main)
