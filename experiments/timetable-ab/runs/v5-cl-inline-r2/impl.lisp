(defvar *courses* nil)

(defstruct course name teacher loc day from to)

(defun word-p (s)
  (and (stringp s) (>= (length s) 1) (<= (length s) 12)))

(defun parse-int (s)
  (when (and (stringp s) (plusp (length s)))
    (let ((i 0) (neg nil) (num 0) (valid t))
      (cond ((char= (char s 0) #\-) (setf neg t i 1))
            ((char= (char s 0) #\+) (setf i 1)))
      (if (>= i (length s))
          nil
          (progn
            (loop for j from i below (length s)
                  do (let ((d (digit-char-p (char s j))))
                       (if d
                           (setf num (+ (* num 10) d))
                           (setf valid nil))))
            (when valid (if neg (- num) num)))))))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun conflict-p (day from to &optional exclude-name)
  (some (lambda (c)
          (and (or (null exclude-name) (not (string= (course-name c) exclude-name)))
               (= (course-day c) day)
               (<= from (course-to c))
               (<= (course-from c) to)))
        *courses*))

(defun split-string (str)
  (let ((res nil) (start 0) (len (length str)))
    (loop for i from 0 to len
          do (when (or (= i len) (char= (char str i) #\Space))
               (let ((part (subseq str start i)))
                 (when (plusp (length part))
                   (push part res)))
               (setf start (1+ i))))
    (nreverse res)))

(defun cmd-add (args)
  (if (not (= (length args) 6))
      (format t "err BADARG~%")
      (let ((name (nth 0 args))
            (teacher (nth 1 args))
            (loc (nth 2 args))
            (day-s (nth 3 args))
            (from-s (nth 4 args))
            (to-s (nth 5 args)))
        (let ((day (parse-int day-s))
              (from (parse-int from-s))
              (to (parse-int to-s)))
          (if (or (not (word-p name))
                  (not (word-p teacher))
                  (not (word-p loc))
                  (null day) (null from) (null to)
                  (not (<= 1 day 7))
                  (not (<= 1 from 12))
                  (not (<= 1 to 12))
                  (> from to))
              (format t "err BADARG~%")
              (if (find-course name)
                  (format t "err DUP~%")
                  (if (>= (length *courses*) 20)
                      (format t "err LIMIT~%")
                      (if (conflict-p day from to)
                          (format t "err CONFLICT~%")
                          (progn
                            (push (make-course :name name :teacher teacher :loc loc :day day :from from :to to)
                                  *courses*)
                            (format t "ok add 1~%"))))))))))

(defun cmd-del (args)
  (if (not (= (length args) 1))
      (format t "err BADARG~%")
      (let ((name (first args)))
        (if (not (word-p name))
            (format t "err BADARG~%")
            (if (not (find-course name))
                (format t "err NOTFOUND~%")
                (progn
                  (setf *courses* (remove name *courses* :key #'course-name :test #'string=))
                  (format t "ok del 1~%")))))))

(defun cmd-edit (args)
  (if (not (= (length args) 3))
      (format t "err BADARG~%")
      (let ((name (nth 0 args))
            (teacher (nth 1 args))
            (loc (nth 2 args)))
        (if (or (not (word-p name))
                (not (word-p teacher))
                (not (word-p loc)))
            (format t "err BADARG~%")
            (let ((c (find-course name)))
              (if (null c)
                  (format t "err NOTFOUND~%")
                  (progn
                    (setf (course-teacher c) teacher
                          (course-loc c) loc)
                    (format t "ok edit 1~%"))))))))

(defun cmd-move (args)
  (if (not (= (length args) 4))
      (format t "err BADARG~%")
      (let ((name (nth 0 args))
            (day-s (nth 1 args))
            (from-s (nth 2 args))
            (to-s (nth 3 args)))
        (let ((day (parse-int day-s))
              (from (parse-int from-s))
              (to (parse-int to-s)))
          (if (or (not (word-p name))
                  (null day) (null from) (null to)
                  (not (<= 1 day 7))
                  (not (<= 1 from 12))
                  (not (<= 1 to 12))
                  (> from to))
              (format t "err BADARG~%")
              (let ((c (find-course name)))
                (if (null c)
                    (format t "err NOTFOUND~%")
                    (if (conflict-p day from to name)
                        (format t "err CONFLICT~%")
                        (progn
                          (setf (course-day c) day
                                (course-from c) from
                                (course-to c) to)
                          (format t "ok move 1~%"))))))))))

(defun cmd-swap (args)
  (if (not (= (length args) 2))
      (format t "err BADARG~%")
      (let ((a-name (nth 0 args))
            (b-name (nth 1 args)))
        (if (or (not (word-p a-name))
                (not (word-p b-name)))
            (format t "err BADARG~%")
            (let ((a (find-course a-name))
                  (b (find-course b-name)))
              (if (or (null a) (null b))
                  (format t "err NOTFOUND~%")
                  (if (string= a-name b-name)
                      (format t "ok swap 2~%")
                      (let ((a-day (course-day a)) (a-from (course-from a)) (a-to (course-to a))
                            (b-day (course-day b)) (b-from (course-from b)) (b-to (course-to b)))
                        (setf (course-day a) b-day
                              (course-from a) b-from
                              (course-to a) b-to
                              (course-day b) a-day
                              (course-from b) a-from
                              (course-to b) a-to)
                        (format t "ok swap 2~%")))))))))

(defun cmd-rename (args)
  (if (not (= (length args) 2))
      (format t "err BADARG~%")
      (let ((old-name (nth 0 args))
            (new-name (nth 1 args)))
        (if (or (not (word-p old-name))
                (not (word-p new-name)))
            (format t "err BADARG~%")
            (let ((c (find-course old-name)))
              (if (null c)
                  (format t "err NOTFOUND~%")
                  (if (find-course new-name)
                      (format t "err DUP~%")
                      (progn
                        (setf (course-name c) new-name)
                        (format t "ok rename 1~%")))))))))

(defun cmd-duplicate (args)
  (if (not (= (length args) 2))
      (format t "err BADARG~%")
      (let ((name (nth 0 args))
            (newname (nth 1 args)))
        (if (or (not (word-p name))
                (not (word-p newname)))
            (format t "err BADARG~%")
            (let ((c (find-course name)))
              (if (null c)
                  (format t "err NOTFOUND~%")
                  (if (find-course newname)
                      (format t "err DUP~%")
                      (if (>= (length *courses*) 20)
                          (format t "err LIMIT~%")
                          (progn
                            (push (make-course :name newname
                                               :teacher (course-teacher c)
                                               :loc (course-loc c)
                                               :day (course-day c)
                                               :from (course-from c)
                                               :to (course-to c))
                                  *courses*)
                            (format t "ok duplicate 1~%"))))))))))

(defun cmd-trim (args)
  (if (not (= (length args) 2))
      (format t "err BADARG~%")
      (let ((day-s (nth 0 args))
            (to-s (nth 1 args)))
        (let ((day (parse-int day-s))
              (to (parse-int to-s)))
          (if (or (null day) (null to)
                  (not (<= 1 day 7))
                  (not (<= 1 to 12)))
              (format t "err BADARG~%")
              (let ((count 0))
                (dolist (c *courses*)
                  (when (and (= (course-day c) day)
                             (<= (course-from c) to)
                             (< to (course-to c)))
                    (setf (course-to c) to)
                    (incf count)))
                (format t "ok trim ~a~%" count)))))))

(defun cmd-clear (args)
  (if (not (= (length args) 1))
      (format t "err BADARG~%")
      (let ((day-s (first args)))
        (let ((day (parse-int day-s)))
          (if (or (null day) (not (<= 1 day 7)))
              (format t "err BADARG~%")
              (let ((old-count (length *courses*)))
                (setf *courses* (remove day *courses* :key #'course-day :test #'=))
                (format t "ok clear ~a~%" (- old-count (length *courses*)))))))))

(defun cmd-shift (args)
  (if (not (= (length args) 2))
      (format t "err BADARG~%")
      (let ((day-s (nth 0 args))
            (delta-s (nth 1 args)))
        (let ((day (parse-int day-s))
              (delta (parse-int delta-s)))
          (if (or (null day) (null delta)
                  (not (<= 1 day 7)))
              (format t "err BADARG~%")
              (let ((new-day (+ day delta)))
                (if (not (<= 1 new-day 7))
                    (format t "err BADARG~%")
                    (let ((count 0))
                      (dolist (c *courses*)
                        (when (= (course-day c) day)
                          (setf (course-day c) new-day)
                          (incf count)))
                      (format t "ok shift ~a~%" count)))))))))

(defun cmd-copy (args)
  (if (not (= (length args) 2))
      (format t "err BADARG~%")
      (let ((name (nth 0 args))
            (day-s (nth 1 args)))
        (let ((day (parse-int day-s)))
          (if (or (not (word-p name))
                  (null day)
                  (not (<= 1 day 7)))
              (format t "err BADARG~%")
              (let ((c (find-course name)))
                (if (null c)
                    (format t "err NOTFOUND~%")
                    (let ((newname (concatenate 'string name "_2")))
                      (if (> (length newname) 12)
                          (format t "err BADARG~%")
                          (if (find-course newname)
                              (format t "err DUP~%")
                              (if (>= (length *courses*) 20)
                                  (format t "err LIMIT~%")
                                  (progn
                                    (push (make-course :name newname
                                                       :teacher (course-teacher c)
                                                       :loc (course-loc c)
                                                       :day day
                                                       :from (course-from c)
                                                       :to (course-to c))
                                          *courses*)
                                    (format t "ok copy 1~%")))))))))))))

(defun cmd-merge (args)
  (if (not (= (length args) 2))
      (format t "err BADARG~%")
      (let ((a-name (nth 0 args))
            (b-name (nth 1 args)))
        (if (or (not (word-p a-name))
                (not (word-p b-name)))
            (format t "err BADARG~%")
            (if (string= a-name b-name)
                (format t "err BADARG~%")
                (let ((a (find-course a-name))
                      (b (find-course b-name)))
                  (if (or (null a) (null b))
                      (format t "err NOTFOUND~%")
                      (progn
                        (setf (course-teacher a) (course-teacher b)
                              (course-loc a) (course-loc b))
                        (setf *courses* (remove b *courses* :test #'eq))
                        (format t "ok merge 2~%")))))))))

(defun cmd-sort (args)
  (if (not (null args))
      (format t "err BADARG~%")
      (format t "ok sort 0~%")))

(defun cmd-filter (args)
  (if (not (= (length args) 1))
      (format t "err BADARG~%")
      (let ((day-s (first args)))
        (let ((day (parse-int day-s)))
          (if (or (null day) (not (<= 1 day 7)))
              (format t "err BADARG~%")
              (let ((count (count-if (lambda (c) (= (course-day c) day)) *courses*)))
                (format t "ok filter ~a~%" count)))))))

(defun cmd-count (args)
  (if (not (null args))
      (format t "err BADARG~%")
      (format t "ok count ~a~%" (length *courses*))))

(defun execute-command (cmd)
  (let* ((tokens (split-string cmd))
         (verb (and tokens (first tokens)))
         (args (rest tokens)))
    (if (null tokens)
        (format t "err BADARG~%")
        (cond
          ((string= verb "add") (cmd-add args))
          ((string= verb "del") (cmd-del args))
          ((string= verb "edit") (cmd-edit args))
          ((string= verb "move") (cmd-move args))
          ((string= verb "swap") (cmd-swap args))
          ((string= verb "rename") (cmd-rename args))
          ((string= verb "duplicate") (cmd-duplicate args))
          ((string= verb "trim") (cmd-trim args))
          ((string= verb "clear") (cmd-clear args))
          ((string= verb "shift") (cmd-shift args))
          ((string= verb "copy") (cmd-copy args))
          ((string= verb "merge") (cmd-merge args))
          ((string= verb "sort") (cmd-sort args))
          ((string= verb "filter") (cmd-filter args))
          ((string= verb "count") (cmd-count args))
          (t (format t "err BADARG~%"))))))

(defun get-command-args ()
  (let ((argv sb-ext:*posix-argv*))
    (if (null argv)
        nil
        (let ((idx (position-if (lambda (s)
                                  (and (stringp s)
                                       (>= (length s) 9)
                                       (string= (subseq s (- (length s) 9)) "impl.lisp")))
                                argv)))
          (if idx
              (nthcdr (1+ idx) argv)
              (let ((args (cdr argv)))
                (when (and args (string= (first args) "--script"))
                  (pop args))
                (when (and args (stringp (first args))
                           (>= (length (first args)) 5)
                           (string= (subseq (first args) (- (length (first args)) 5)) ".lisp"))
                  (pop args))
                args))))))

(defun output-state ()
  (format t "#state~%")
  (let ((sorted (sort (copy-list *courses*) #'string< :key #'course-name)))
    (dolist (c sorted)
      (format t "~a|~a|~a|~a|~a-~a~%"
              (course-name c)
              (course-teacher c)
              (course-loc c)
              (course-day c)
              (course-from c)
              (course-to c)))))

(defun main ()
  (let ((*courses* nil))
    (dolist (cmd (get-command-args))
      (execute-command cmd))
    (output-state)))

(main)
