;;; impl.lisp -- timetable scale arm, ops: add / del / edit / move / swap / stats
;;; 边界契约: :obj 标签只出现在本文件的三处 (reader 产出 / unwrap / wrap)。

;;; ============ 边界层 1: 读 ============
(defvar *src* "")
(defvar *pos* 0)

(defun pk () (if (< *pos* (length *src*)) (char *src* *pos*) nil))
(defun eat () (prog1 (char *src* *pos*) (incf *pos*)))
(defun ws-c (c) (member c '(#\Space #\Tab #\Newline #\Return) :test #'char=))
(defun skip-ws ()
  (loop while (and (< *pos* (length *src*)) (ws-c (char *src* *pos*))) do (incf *pos*))
  *pos*)
(defun hex4 ()
  (let ((v (parse-integer *src* :start *pos* :end (+ *pos* 4) :radix 16)))
    (incf *pos* 4) v))

(defun jstr ()
  (let ((out (make-string-output-stream)))
    (eat)                                       ; opening quote
    (loop
      (let ((c (eat)))
        (if (char= c #\")
            (return (get-output-stream-string out))
            (if (char= c #\\)
                (let ((e (eat)))
                  (case e
                    (#\" (write-char #\" out))
                    (#\\ (write-char #\\ out))
                    (#\/ (write-char #\/ out))
                    (#\b (write-char (code-char 8) out))
                    (#\f (write-char (code-char 12) out))
                    (#\n (write-char #\Newline out))
                    (#\r (write-char #\Return out))
                    (#\t (write-char #\Tab out))
                    (#\u (let ((cp (hex4)))
                           ;; 增补平面: 高代理 + 低代理 -> 一个码点
                           (when (and (<= #xD800 cp #xDBFF)
                                      (eql (pk) #\\) (eql (char *src* (1+ *pos*)) #\u))
                             (incf *pos* 2)
                             (let ((lo (hex4)))
                               (setf cp (+ #x10000 (* (- cp #xD800) #x400) (- lo #xDC00)))))
                           (write-char (code-char cp) out)))
                    (t (write-char e out))))
                (write-char c out)))))))

(defun jnum ()
  (let ((start *pos*))
    (loop while (and (< *pos* (length *src*))
                     (find (char *src* *pos*) "-+.eE0123456789" :test #'char=))
          do (incf *pos*))
    (let* ((txt (subseq *src* start *pos*))
           (*read-default-float-format* 'single-float))
      (if (find-if (lambda (c) (find c ".eE" :test #'char=)) txt)
          (let ((v (read-from-string txt))) (coerce v 'single-float))
          (parse-integer txt)))))

(defun jobj ()
  (eat)                                          ; {
  (let ((pairs '()))
    (skip-ws)
    (if (eql (pk) #\})
        (eat)
        (loop
          (skip-ws)
          (let ((k (jstr)))
            (skip-ws) (eat)                      ; :
            (skip-ws)
            (push (cons k (jval)) pairs))
          (skip-ws)
          (unless (eql (eat) #\,) (return))))
    (cons :obj (nreverse pairs))))

(defun jarr ()
  (eat)                                          ; [
  (let ((xs '()))
    (skip-ws)
    (if (eql (pk) #\])
        (eat)
        (loop
          (skip-ws)
          (push (jval) xs)
          (skip-ws)
          (unless (eql (eat) #\,) (return))))
    (nreverse xs)))

(defun jval ()
  (skip-ws)
  (let ((c (pk)))
    (cond ((null c) :null)
          ((eql c #\{) (jobj))
          ((eql c #\[) (jarr))
          ((eql c #\") (jstr))
          ((eql c #\t) (dotimes (i 4) (eat)) :true)
          ((eql c #\f) (dotimes (i 5) (eat)) :false)
          ((eql c #\n) (dotimes (i 4) (eat)) :null)
          (t (jnum)))))

;;; ============ 边界层 2: 写 ============
(defun jwstr (s out)
  (write-char #\" out)
  (loop for c across s do
        (cond ((char= c #\") (write-string "\\\"" out))
              ((char= c #\\) (write-string "\\\\" out))
              ((< (char-code c) 32) (format out "\\u~4,'0x" (char-code c)))
              (t (write-char c out))))
  (write-char #\" out))

(defun jwrite (v out)
  (cond ((null v) (write-string "[]" out))
        ((eq v :null) (write-string "null" out))
        ((eq v :true) (write-string "true" out))
        ((eq v :false) (write-string "false" out))
        ((and (consp v) (eq (car v) :obj))
         (write-char #\{ out)
         (loop for (k . val) in (cdr v) for first = t then nil
               do (unless first (write-char #\, out))
                  (jwstr k out) (write-char #\: out) (jwrite val out))
         (write-char #\} out))
        ((consp v)
         (write-char #\[ out)
         (loop for x in v for first = t then nil
               do (unless first (write-char #\, out)) (jwrite x out))
         (write-char #\] out))
        ((stringp v) (jwstr v out))
        ((integerp v) (format out "~d" v))
        ((numberp v) (write-string (substitute #\e #\d (substitute #\e #\D (format nil "~a" v))) out))
        (t (write-string "null" out))))

;;; ============ 业务层: 只认裸 alist ============
(defun bare (o) (if (and (consp o) (eq (car o) :obj)) (cdr o) o))
(defun cget (al k) (let ((p (assoc k al :test #'string=))) (and p (cdr p))))
(defun cset (al k v)
  (let ((p (assoc k al :test #'string=)))
    (if p
        (setf (cdr p) v)
        (setf al (nconc al (list (cons k v))))))
  al)
(defun s-of (v) (if (stringp v) v ""))
(defun intr (v) (and (numberp v) (if (integerp v) v (round v))))
(defun clamp (v lo hi) (let ((n (intr v))) (and n (max lo (if hi (min hi n) n)))))
(defun fix-inv (c)
  (let ((a (cget c "periodFrom")) (b (cget c "periodTo")))
    (when (and (numberp a) (numberp b) (> a b)) (cset c "periodTo" a)))
  c)
(defun dflt-weeks ()
  (cons :obj (list (cons "type" "range") (cons "from" 1) (cons "to" 16))))

(defun norm-course (c)                            ; c: 裸 alist -> 规整后的裸 alist
  ;; cset 对「新键」是 append，必须接返回值；只有「已有键」才是就地改。
  (let ((o nil) (c (or c nil)))
    (dolist (k '("name" "teacher" "location"))
      (setf o (cset o k (s-of (cget c k)))))
    (setf o (cset o "day" (or (clamp (cget c "day") 1 7) 1)))
    (let ((pf (or (clamp (cget c "periodFrom") 1 nil) 1)))
      (setf o (cset o "periodFrom" pf))
      (setf o (cset o "periodTo" (or (clamp (cget c "periodTo") 1 nil) pf))))
    (fix-inv o)
    (setf o (cset o "weeks" (or (cget c "weeks") (dflt-weeks))))
    (setf o (cset o "tag" (let ((tg (cget c "tag"))) (or tg :null))))
    o))

(defvar *courses* nil)
(defvar *log* nil)
(defvar *n* 0)
(defun emit (s) (push s *log*) s)
(defun unobj (v) (if (and (consp v) (eq (car v) :obj)) (cdr v) v))
(defun course-list (v)
  (let ((v (unobj v)))
    (if (listp v)
        (mapcar (lambda (o) (copy-tree (unobj o))) v)
        nil)))
(defun hits-of (m) (remove-if-not (lambda (c) (search m (s-of (cget c "name")))) *courses*))

;;; ============ 每个 op ============
(defun op-add (op)
  (let ((c (cget op "course")))
    (if (null c)
        (emit "add：缺 course，不执行")
        (let ((cc (norm-course (copy-tree (unobj c)))))
          (setf *courses* (append *courses* (list cc)))
          (incf *n*)
          (emit (format nil "加「~a」" (cget cc "name")))))))

(defun op-del (op)
  (let* ((m (s-of (cget op "match")))
         (hits (hits-of m))
         (k (length hits)))
    (if (zerop k)
        (emit (format nil "没找到「~a」" m))
        (progn
          (setf *courses* (remove-if (lambda (c) (search m (s-of (cget c "name")))) *courses*))
          (incf *n* k)
          (emit (format nil "删 ~a 门（~a）" k m))))))

(defun op-edit (op)
  (let* ((m (s-of (cget op "match")))
         (pairs (course-list (cget op "set")))
         (hits (hits-of m))
         (k 0))
    (dolist (c hits)
      (dolist (p pairs)
        (let ((key (car p)) (val (cdr p)))
          (cond ((member key '("name" "teacher" "location") :test #'string=)
                 (when (stringp val) (cset c key val)))
                ((string= key "day")
                 (let ((v (clamp val 1 7))) (when v (cset c key v))))
                ((member key '("periodFrom" "periodTo") :test #'string=)
                 (let ((v (clamp val 1 nil))) (when v (cset c key v))))
                ((string= key "weeks") (when (consp val) (cset c key val)))
                ((string= key "tag") (cset c key val)))))
      (fix-inv c)
      (incf k))
    (if (zerop k)
        (emit (format nil "没找到「~a」" m))
        (progn (incf *n* k)
               (emit (format nil "改 ~a 门" k))))))

(defun op-move (op)
  (let ((m (s-of (cget op "match")))
        (d (clamp (cget op "day") 1 7))
        (pf (clamp (cget op "periodFrom") 1 nil))
        (pt (clamp (cget op "periodTo") 1 nil)))
    (if (or (null d) (null pf) (null pt))
        (emit "move：缺 day/periodFrom/periodTo，不执行")
        (let ((hits (hits-of m)))
          (if (null hits)
              (emit (format nil "没找到「~a」" m))
              (progn
                (dolist (c hits)
                  (cset c "day" d) (cset c "periodFrom" pf) (cset c "periodTo" pt)
                  (fix-inv c))
                (incf *n* (length hits))
                (emit (format nil "移动 ~a 门" (length hits)))))))))

(defun op-swap (op)
  (let* ((a (hits-of (s-of (cget op "match"))))
         (b (hits-of (s-of (cget op "with")))))
    (if (and (= (length a) 1) (= (length b) 1) (not (eq (car a) (car b))))
        (let ((c1 (car a)) (c2 (car b)))
          (dolist (k '("day" "periodFrom" "periodTo"))
            (let ((v (cget c1 k)))
              (cset c1 k (cget c2 k)) (cset c2 k v)))
          (incf *n* 2)
          (emit "互换 2 门"))
        (emit (format nil "swap：两侧各需恰好 1 门（得到 ~a/~a），不执行"
                      (length a) (length b))))))

(defun op-stats (op)
  (declare (ignore op))
  (let ((slots (loop for c in *courses*
                     sum (1+ (- (cget c "periodTo") (cget c "periodFrom"))))))
    (emit (format nil "共 ~a 门课，~a 个时段被占" (length *courses*) slots))))

(defparameter *ops*
  (list (cons "add" #'op-add) (cons "del" #'op-del) (cons "edit" #'op-edit)
        (cons "move" #'op-move) (cons "swap" #'op-swap) (cons "stats" #'op-stats)))
(defun op-fn (name) (cdr (assoc name *ops* :test #'string=)))
(defun op-name (o) (s-of (cget (unobj o) "op")))

;;; ============ 入口 ============
(defun slurp (path)
  (with-open-file (s path :external-format :utf-8)
    (let* ((buf (make-string (max 1 (file-length s))))
           (k (read-sequence buf s)))
      (subseq buf 0 k))))

(defun main ()
  (let* ((path (car (last sb-ext:*posix-argv*)))
         (root (let ((*src* (if (and path (probe-file path)) (slurp path) ""))
                     (*pos* 0))
                 (jval)))
         (top (unobj root))
         (raw (mapcar (lambda (o) (copy-tree (unobj o))) (course-list (cget top "courses"))))
         (*log* nil) (*n* 0)
         (ops-raw (cget top "ops"))
         (ops (if (listp ops-raw) ops-raw nil))
         (names (mapcar #'op-name ops))
         (bad (find-if-not #'op-fn names))
         (ops-text "")
         (*courses* (mapcar #'norm-course raw)))
    (if bad
        (setf *log* (list (format nil "拒绝：未知 op ~a" bad)) *n* 0
              *courses* (mapcar #'norm-course raw))
        (progn
          (setf ops-text (format nil "~{~a~^ ~}" names))
          (dolist (o ops) (funcall (op-fn (op-name o)) (unobj o)))))
    (let* ((log-lines (loop for x in (reverse *log*) for i from 2
                            collect (format nil "~a) ~a" i x)))
           (doc (cons :obj (list (cons "opsText" ops-text)
                                 (cons "courses" (mapcar (lambda (c) (cons :obj c)) *courses*))
                                 (cons "log" log-lines)
                                 (cons "n" *n*))))
           (s (with-output-to-string (out) (jwrite doc out))))
      (write-string s)
      (terpri))))

(main)
