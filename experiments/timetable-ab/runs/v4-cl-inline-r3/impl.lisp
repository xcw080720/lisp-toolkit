(defstruct course name teacher loc day from to)

(defparameter *courses* nil)

(defparameter *op-names*
  '("add" "del" "edit" "move" "swap" "rename" "duplicate" "trim"
    "clear" "shift" "copy" "merge" "sort" "filter" "count"))

(defun split-ws (s)
  (let ((tokens '())
        (n (length s))
        (start 0))
    (loop for i from 0 to n
          when (or (= i n) (member (char s i) '(#\Space #\Tab)))
            do (when (< start i)
                 (push (subseq s start i) tokens))
               (setf start (1+ i)))
    (nreverse tokens)))

(defun parse-int-token (s)
  (handler-case
      (parse-integer s :junk-allowed nil)
    (error () nil)))

(defun valid-word-p (s)
  (and (stringp s)
       (<= 1 (length s) 12)))

(defun find-course-by-name (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun overlap-p (from1 to1 from2 to2)
  (and (<= from1 to2) (<= from2 to1)))

(defun conflict-p (day from to &optional exclude)
  (some (lambda (c)
          (and (not (eq c exclude))
               (= (course-day c) day)
               (overlap-p from to (course-from c) (course-to c))))
        *courses*))

(defun out-ok (verb n)
  (format t "ok ~a ~d~%" verb n))

(defun out-err (code)
  (format t "err ~a~%" code))

(defun command-tail (argv)
  (loop for tail on argv
        when (member (car tail) *op-names* :test #'string=)
          return tail))

(let ((commands (command-tail sb-ext:*posix-argv*)))
  (dolist (cmd commands)
    (let* ((tokens (split-ws cmd))
           (op (first tokens))
           (args (rest tokens)))
      (cond
        ((null op) (out-err "BADARG"))
        ((string= op "add")
         (if (/= (length args) 6)
             (out-err "BADARG")
             (let ((name (nth 0 args))
                   (teacher (nth 1 args))
                   (loc (nth 2 args))
                   (day-s (nth 3 args))
                   (from-s (nth 4 args))
                   (to-s (nth 5 args)))
               (let ((day (parse-int-token day-s))
                     (from (parse-int-token from-s))
                     (to (parse-int-token to-s)))
                 (if (or (not (valid-word-p name))
                         (not (valid-word-p teacher))
                         (not (valid-word-p loc))
                         (null day) (< day 1) (> day 7)
                         (null from) (< from 1) (> from 12)
                         (null to) (< to 1) (> to 12)
                         (< to from))
                     (out-err "BADARG")
                     (if (find-course-by-name name)
                         (out-err "DUP")
                         (if (>= (length *courses*) 20)
                             (out-err "LIMIT")
                             (if (conflict-p day from to)
                                 (out-err "CONFLICT")
                                 (progn
                                   (push (make-course :name name
                                                      :teacher teacher
                                                      :loc loc
                                                      :day day
                                                      :from from
                                                      :to to)
                                         *courses*)
                                   (out-ok "add" 1))))))))))
        ((string= op "del")
         (if (/= (length args) 1)
             (out-err "BADARG")
             (let ((name (nth 0 args)))
               (if (not (valid-word-p name))
                   (out-err "BADARG")
                   (if (find-course-by-name name)
                       (progn
                         (setf *courses* (remove name *courses* :key #'course-name :test #'string=))
                         (out-ok "del" 1))
                       (out-err "NOTFOUND"))))))
        ((string= op "edit")
         (if (/= (length args) 3)
             (out-err "BADARG")
             (let ((name (nth 0 args))
                   (teacher (nth 1 args))
                   (loc (nth 2 args)))
               (if (or (not (valid-word-p name))
                       (not (valid-word-p teacher))
                       (not (valid-word-p loc)))
                   (out-err "BADARG")
                   (let ((c (find-course-by-name name)))
                     (if c
                         (progn
                           (setf (course-teacher c) teacher
                                 (course-loc c) loc)
                           (out-ok "edit" 1))
                         (out-err "NOTFOUND")))))))
        ((string= op "move")
         (if (/= (length args) 4)
             (out-err "BADARG")
             (let ((name (nth 0 args))
                   (day-s (nth 1 args))
                   (from-s (nth 2 args))
                   (to-s (nth 3 args)))
               (let ((day (parse-int-token day-s))
                     (from (parse-int-token from-s))
                     (to (parse-int-token to-s)))
                 (if (or (not (valid-word-p name))
                         (null day) (< day 1) (> day 7)
                         (null from) (< from 1) (> from 12)
                         (null to) (< to 1) (> to 12)
                         (< to from))
                     (out-err "BADARG")
                     (let ((c (find-course-by-name name)))
                       (if (null c)
                           (out-err "NOTFOUND")
                           (if (conflict-p day from to c)
                               (out-err "CONFLICT")
                               (progn
                                 (setf (course-day c) day
                                       (course-from c) from
                                       (course-to c) to)
                                 (out-ok "move" 1))))))))))
        ((string= op "swap")
         (if (/= (length args) 2)
             (out-err "BADARG")
             (let ((a-name (nth 0 args))
                   (b-name (nth 1 args)))
               (if (or (not (valid-word-p a-name))
                       (not (valid-word-p b-name)))
                   (out-err "BADARG")
                   (let ((a (find-course-by-name a-name))
                         (b (find-course-by-name b-name)))
                     (if (or (null a) (null b))
                         (out-err "NOTFOUND")
                         (progn
                           (unless (eq a b)
                             (let ((a-day (course-day a))
                                   (a-from (course-from a))
                                   (a-to (course-to a)))
                               (setf (course-day a) (course-day b)
                                     (course-from a) (course-from b)
                                     (course-to a) (course-to b)
                                     (course-day b) a-day
                                     (course-from b) a-from
                                     (course-to b) a-to)))
                           (out-ok "swap" 2))))))))
        ((string= op "rename")
         (if (/= (length args) 2)
             (out-err "BADARG")
             (let ((old (nth 0 args))
                   (new (nth 1 args)))
               (if (or (not (valid-word-p old))
                       (not (valid-word-p new)))
                   (out-err "BADARG")
                   (let ((c (find-course-by-name old)))
                     (if (null c)
                         (out-err "NOTFOUND")
                         (if (and (not (string= old new))
                                  (find-course-by-name new))
                             (out-err "DUP")
                             (progn
                               (setf (course-name c) new)
                               (out-ok "rename" 1)))))))))
        ((string= op "duplicate")
         (if (/= (length args) 2)
             (out-err "BADARG")
             (let ((name (nth 0 args))
                   (newname (nth 1 args)))
               (if (or (not (valid-word-p name))
                       (not (valid-word-p newname)))
                   (out-err "BADARG")
                   (let ((c (find-course-by-name name)))
                     (if (null c)
                         (out-err "NOTFOUND")
                         (if (find-course-by-name newname)
                             (out-err "DUP")
                             (if (>= (length *courses*) 20)
                                 (out-err "LIMIT")
                                 (progn
                                   (push (make-course :name newname
                                                      :teacher (course-teacher c)
                                                      :loc (course-loc c)
                                                      :day (course-day c)
                                                      :from (course-from c)
                                                      :to (course-to c))
                                         *courses*)
                                   (out-ok "duplicate" 1))))))))))
        ((string= op "trim")
         (if (/= (length args) 2)
             (out-err "BADARG")
             (let ((day-s (nth 0 args))
                   (to-s (nth 1 args)))
               (let ((day (parse-int-token day-s))
                     (new-to (parse-int-token to-s)))
                 (if (or (null day) (< day 1) (> day 7)
                         (null new-to) (< new-to 1) (> new-to 12))
                     (out-err "BADARG")
                     (let ((n 0))
                       (dolist (c *courses*)
                         (when (and (= (course-day c) day)
                                    (<= (course-from c) new-to)
                                    (< new-to (course-to c)))
                           (setf (course-to c) new-to)
                           (incf n)))
                       (out-ok "trim" n)))))))
        ((string= op "clear")
         (if (/= (length args) 1)
             (out-err "BADARG")
             (let ((day-s (nth 0 args)))
               (let ((day (parse-int-token day-s)))
                 (if (or (null day) (< day 1) (> day 7))
                     (out-err "BADARG")
                     (let ((n (count-if (lambda (c) (= (course-day c) day))
                                        *courses*)))
                       (setf *courses*
                             (remove-if (lambda (c) (= (course-day c) day))
                                        *courses*))
                       (out-ok "clear" n)))))))
        ((string= op "shift")
         (if (/= (length args) 2)
             (out-err "BADARG")
             (let ((day-s (nth 0 args))
                   (delta-s (nth 1 args)))
               (let ((day (parse-int-token day-s))
                     (delta (parse-int-token delta-s)))
                 (if (or (null day) (< day 1) (> day 7)
                         (null delta))
                     (out-err "BADARG")
                     (let ((new-day (+ day delta)))
                       (if (or (< new-day 1) (> new-day 7))
                           (out-err "BADARG")
                           (let ((n 0))
                             (dolist (c *courses*)
                               (when (= (course-day c) day)
                                 (setf (course-day c) new-day)
                                 (incf n)))
                             (out-ok "shift" n)))))))))
        ((string= op "copy")
         (if (/= (length args) 2)
             (out-err "BADARG")
             (let ((name (nth 0 args))
                   (day-s (nth 1 args)))
               (let ((day (parse-int-token day-s)))
                 (if (or (not (valid-word-p name))
                         (null day) (< day 1) (> day 7))
                     (out-err "BADARG")
                     (let ((c (find-course-by-name name)))
                       (if (null c)
                           (out-err "NOTFOUND")
                           (let ((newname (concatenate 'string name "_2")))
                             (if (> (length newname) 12)
                                 (out-err "BADARG")
                                 (if (find-course-by-name newname)
                                     (out-err "DUP")
                                     (if (>= (length *courses*) 20)
                                         (out-err "LIMIT")
                                         (progn
                                           (push (make-course :name newname
                                                              :teacher (course-teacher c)
                                                              :loc (course-loc c)
                                                              :day day
                                                              :from (course-from c)
                                                              :to (course-to c))
                                                 *courses*)
                                           (out-ok "copy" 1)))))))))))))
        ((string= op "merge")
         (if (/= (length args) 2)
             (out-err "BADARG")
             (let ((a-name (nth 0 args))
                   (b-name (nth 1 args)))
               (if (or (not (valid-word-p a-name))
                       (not (valid-word-p b-name)))
                   (out-err "BADARG")
                   (let ((a (find-course-by-name a-name))
                         (b (find-course-by-name b-name)))
                     (if (or (null a) (null b))
                         (out-err "NOTFOUND")
                         (progn
                           (unless (eq a b)
                             (setf (course-teacher a) (course-teacher b)
                                   (course-loc a) (course-loc b)))
                           (setf *courses* (remove b *courses* :test #'eq))
                           (out-ok "merge" 2))))))))
        ((string= op "sort")
         (if (not (null args))
             (out-err "BADARG")
             (progn
               (setf *courses* (sort (copy-list *courses*) #'string< :key #'course-name))
               (out-ok "sort" 0))))
        ((string= op "filter")
         (if (/= (length args) 1)
             (out-err "BADARG")
             (let ((day-s (nth 0 args)))
               (let ((day (parse-int-token day-s)))
                 (if (or (null day) (< day 1) (> day 7))
                     (out-err "BADARG")
                     (out-ok "filter"
                            (count-if (lambda (c) (= (course-day c) day))
                                      *courses*)))))))
        ((string= op "count")
         (if (not (null args))
             (out-err "BADARG")
             (out-ok "count" (length *courses*))))
        (t (out-err "BADARG")))))
  (format t "#state~%")
  (dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
    (format t "~a|~a|~a|~d|~d-~d~%"
            (course-name c)
            (course-teacher c)
            (course-loc c)
            (course-day c)
            (course-from c)
            (course-to c))))
