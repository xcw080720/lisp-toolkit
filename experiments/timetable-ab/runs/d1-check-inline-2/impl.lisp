(defvar *cs* nil)

(defstruct (c (:constructor mk (nm te lo dy fr to))) nm te lo dy fr to)

(defun w? (s) (and (stringp s) (<= 1 (length s) 12)))

(defun i? (s)
  (and (stringp s)
       (let ((n (length s)))
         (and (plusp n)
              (let ((b (if (member (char s 0) '(#\+ #\-) :test #'char=) 1 0)))
                (and (< b n) (every #'digit-char-p (subseq s b))))
              (parse-integer s)))))

(defun in? (x lo hi) (and x (<= lo x hi)))

(defun fnd (nm) (find nm *cs* :key #'c-nm :test #'string=))

(defun ovl (dy fr to skip)
  (find-if (lambda (x)
             (and (= (c-dy x) dy) (<= (c-fr x) to) (<= fr (c-to x))
                  (or (null skip) (not (string= (c-nm x) skip)))))
           *cs*))

(defun bad? (l)
  (let ((r nil))
    (dolist (a l)
      (dolist (b l)
        (when (and (not (eq a b)) (= (c-dy a) (c-dy b))
                   (<= (c-fr a) (c-to b)) (<= (c-fr b) (c-to a)))
          (setf r t))))
    r))

(defun ord (l) (sort (copy-list l) #'string< :key #'c-nm))

(defun sp (s)
  (let ((res nil) (st nil))
    (dotimes (i (length s))
      (let ((ch (char s i)))
        (if (or (char= ch #\Space) (char= ch #\Tab))
            (when st (push (subseq s st i) res) (setf st nil))
            (unless st (setf st i)))))
    (when st (push (subseq s st) res))
    (nreverse res)))

(defun e (x) (format t "err ~a~%" x))

(defun o (v n) (format t "ok ~a ~a~%" v n))

(defun argv* ()
  (let ((a (cdr sb-ext:*posix-argv*)))
    (loop while (and a
                     (let ((s (car a)))
                       (and (not (and (>= (length s) 5) (string= "--dry" s :end2 5)))
                            (or (and (>= (length s) 2) (string= "--" s :end2 2))
                                (let ((n (length s)))
                                  (and (>= n 5)
                                       (string= ".lisp" s :start2 (- n 5))))))))
          do (pop a))
    a))

(defun run (v a dry)
  (cond
   ((string= v "add")
    (if (/= 6 (length a)) (e "BADARG")
        (let ((nm (nth 0 a)) (te (nth 1 a)) (lo (nth 2 a))
              (dy (i? (nth 3 a))) (fr (i? (nth 4 a))) (to (i? (nth 5 a))))
          (if (not (and (w? nm) (w? te) (w? lo) (in? dy 1 7)
                        (in? fr 1 12) (in? to 1 12) (<= fr to)))
              (e "BADARG")
              (cond ((fnd nm) (e "DUP"))
                    ((>= (length *cs*) 20) (e "LIMIT"))
                    ((ovl dy fr to nil) (e "CONFLICT"))
                    (t (unless dry (push (mk nm te lo dy fr to) *cs*))
                       (o "add" 1)))))))
   ((string= v "del")
    (if (/= 1 (length a)) (e "BADARG")
        (if (not (w? (car a))) (e "BADARG")
            (if (fnd (car a))
                (progn (unless dry
                         (setf *cs* (remove (car a) *cs* :key #'c-nm :test #'string=)))
                       (o "del" 1))
                (e "NOTFOUND")))))
   ((string= v "edit")
    (if (/= 3 (length a)) (e "BADARG")
        (let ((nm (nth 0 a)) (te (nth 1 a)) (lo (nth 2 a)))
          (if (not (and (w? nm) (w? te) (w? lo))) (e "BADARG")
              (let ((x (fnd nm)))
                (if (null x) (e "NOTFOUND")
                    (progn (unless dry (setf (c-te x) te (c-lo x) lo))
                           (o "edit" 1))))))))
   ((string= v "move")
    (if (/= 4 (length a)) (e "BADARG")
        (let ((nm (nth 0 a)) (dy (i? (nth 1 a)))
              (fr (i? (nth 2 a))) (to (i? (nth 3 a))))
          (if (not (and (w? nm) (in? dy 1 7) (in? fr 1 12)
                        (in? to 1 12) (<= fr to)))
              (e "BADARG")
              (let ((x (fnd nm)))
                (cond ((null x) (e "NOTFOUND"))
                      ((ovl dy fr to nm) (e "CONFLICT"))
                      (t (unless dry (setf (c-dy x) dy (c-fr x) fr (c-to x) to))
                         (o "move" 1))))))))
   ((string= v "swap")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((ca (fnd x)) (cb (fnd y)))
                (cond ((or (null ca) (null cb)) (e "NOTFOUND"))
                      (t (unless dry
                           (rotatef (c-dy ca) (c-dy cb))
                           (rotatef (c-fr ca) (c-fr cb))
                           (rotatef (c-to ca) (c-to cb)))
                         (o "swap" 2))))))))
   ((string= v "rename")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((cx (fnd x)))
                (cond ((null cx) (e "NOTFOUND"))
                      ((fnd y) (e "DUP"))
                      (t (unless dry (setf (c-nm cx) y)) (o "rename" 1))))))))
   ((string= v "duplicate")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((cx (fnd x)))
                (cond ((null cx) (e "NOTFOUND"))
                      ((fnd y) (e "DUP"))
                      ((>= (length *cs*) 20) (e "LIMIT"))
                      (t (unless dry
                           (push (mk y (c-te cx) (c-lo cx) (c-dy cx)
                                    (c-fr cx) (c-to cx))
                                 *cs*))
                         (o "duplicate" 1))))))))
   ((string= v "trim")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((dy (i? (nth 0 a))) (to (i? (nth 1 a))))
          (if (not (and (in? dy 1 7) (in? to 1 12))) (e "BADARG")
              (let ((k 0))
                (dolist (x *cs*)
                  (when (and (= (c-dy x) dy) (<= (c-fr x) to) (< to (c-to x)))
                    (incf k)
                    (unless dry (setf (c-to x) to))))
                (o "trim" k))))))
   ((string= v "clear")
    (if (/= 1 (length a)) (e "BADARG")
        (let ((dy (i? (car a))))
          (if (not (in? dy 1 7)) (e "BADARG")
              (let ((k (count-if (lambda (x) (= (c-dy x) dy)) *cs*)))
                (unless dry
                  (setf *cs* (remove-if (lambda (x) (= (c-dy x) dy)) *cs*)))
                (o "clear" k))))))
   ((string= v "shift")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((dy (i? (nth 0 a))) (dl (i? (nth 1 a))))
          (if (not (and (in? dy 1 7) dl (in? (+ dy dl) 1 7))) (e "BADARG")
              (let ((k 0) (nd (+ dy dl)))
                (dolist (x *cs*)
                  (when (= (c-dy x) dy) (incf k) (unless dry (setf (c-dy x) nd))))
                (o "shift" k))))))
   ((string= v "copy")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((nm (nth 0 a)) (dy (i? (nth 1 a))))
          (if (not (and (w? nm) (in? dy 1 7))) (e "BADARG")
              (let ((x (fnd nm)) (nn (concatenate 'string nm "_2")))
                (cond ((null x) (e "NOTFOUND"))
                      ((fnd nn) (e "DUP"))
                      ((>= (length *cs*) 20) (e "LIMIT"))
                      (t (unless dry
                           (push (mk nn (c-te x) (c-lo x) dy (c-fr x) (c-to x))
                                 *cs*))
                         (o "copy" 1))))))))
   ((string= v "merge")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((ca (fnd x)) (cb (fnd y)))
                (cond ((or (null ca) (null cb)) (e "NOTFOUND"))
                      (t (unless dry
                           (setf (c-te ca) (c-te cb) (c-lo ca) (c-lo cb))
                           (setf *cs* (remove cb *cs*)))
                         (o "merge" 2))))))))
   ((string= v "sort")
    (if a (e "BADARG") (o "sort" 0)))
   ((string= v "filter")
    (if (/= 1 (length a)) (e "BADARG")
        (let ((dy (i? (car a))))
          (if (not (in? dy 1 7)) (e "BADARG")
              (o "filter" (count-if (lambda (x) (= (c-dy x) dy)) *cs*))))))
   ((string= v "count")
    (if a (e "BADARG") (o "count" (length *cs*))))
   ((string= v "swapTeacher")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((ca (fnd x)) (cb (fnd y)))
                (cond ((or (null ca) (null cb)) (e "NOTFOUND"))
                      (t (unless dry (rotatef (c-te ca) (c-te cb)))
                         (o "swapTeacher" 2))))))))
   ((string= v "swapLoc")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((ca (fnd x)) (cb (fnd y)))
                (cond ((or (null ca) (null cb)) (e "NOTFOUND"))
                      (t (unless dry (rotatef (c-lo ca) (c-lo cb)))
                         (o "swapLoc" 2))))))))
   ((string= v "copyTo")
    (if (/= 4 (length a)) (e "BADARG")
        (let ((nm (nth 0 a)) (dy (i? (nth 1 a)))
              (fr (i? (nth 2 a))) (to (i? (nth 3 a))))
          (if (not (and (w? nm) (in? dy 1 7) (in? fr 1 12)
                        (in? to 1 12) (<= fr to)))
              (e "BADARG")
              (let ((x (fnd nm)) (nn (concatenate 'string nm "_3")))
                (cond ((null x) (e "NOTFOUND"))
                      ((fnd nn) (e "DUP"))
                      ((>= (length *cs*) 20) (e "LIMIT"))
                      ((ovl dy fr to nil) (e "CONFLICT"))
                      (t (unless dry
                           (push (mk nn (c-te x) (c-lo x) dy fr to) *cs*))
                         (o "copyTo" 1))))))))
   ((string= v "truncate")
    (if (/= 1 (length a)) (e "BADARG")
        (let ((dy (i? (car a))))
          (if (not (in? dy 1 7)) (e "BADARG")
              (let* ((ds (ord (remove-if-not (lambda (x) (= (c-dy x) dy)) *cs*)))
                     (kp (car ds))
                     (k (if ds (1- (length ds)) 0)))
                (unless dry
                  (setf *cs* (remove-if (lambda (x) (and (= (c-dy x) dy)
                                                         (not (eq x kp))))
                                        *cs*)))
                (o "truncate" k))))))
   ((string= v "keep")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((dy (i? (nth 0 a))) (nn (i? (nth 1 a))))
          (if (not (and (in? dy 1 7) nn (>= nn 0))) (e "BADARG")
              (let* ((ds (ord (remove-if-not (lambda (x) (= (c-dy x) dy)) *cs*)))
                     (kp (if (> nn (length ds)) ds (subseq ds 0 nn))))
                (unless dry
                  (setf *cs* (remove-if (lambda (x) (and (= (c-dy x) dy)
                                                         (not (member x kp :test #'eq))))
                                        *cs*)))
                (o "keep" (- (length ds) (length kp))))))))
   ((string= v "renameTeacher")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((k 0))
                (dolist (c0 *cs*)
                  (when (string= (c-te c0) x)
                    (incf k)
                    (unless dry (setf (c-te c0) y))))
                (o "renameTeacher" k))))))
   ((string= v "renameLoc")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((k 0))
                (dolist (c0 *cs*)
                  (when (string= (c-lo c0) x)
                    (incf k)
                    (unless dry (setf (c-lo c0) y))))
                (o "renameLoc" k))))))
   ((string= v "dedupe")
    (if a (e "BADARG")
        (let ((seen (make-hash-table :test #'equal)) (del nil))
          (dolist (c0 (ord *cs*))
            (let ((key (list (c-te c0) (c-lo c0) (c-dy c0)
                             (c-fr c0) (c-to c0))))
              (if (gethash key seen)
                  (push (c-nm c0) del)
                  (setf (gethash key seen) t))))
          (unless dry
            (setf *cs* (remove-if (lambda (x) (member (c-nm x) del :test #'string=))
                                  *cs*)))
          (o "dedupe" (length del)))))
   ((string= v "compress")
    (if (/= 1 (length a)) (e "BADARG")
        (let ((dy (i? (car a))))
          (if (not (in? dy 1 7)) (e "BADARG")
              (let ((k 0) (i 0))
                (dolist (x (sort (remove-if-not (lambda (y) (= (c-dy y) dy)) *cs*)
                                 #'< :key #'c-fr))
                  (incf i)
                  (unless (and (= (c-fr x) i) (= (c-to x) (1+ i))) (incf k))
                  (unless dry (setf (c-fr x) i (c-to x) (1+ i))))
                (o "compress" k))))))
   ((string= v "compact")
    (if a (e "BADARG")
        (let ((k 0))
          (dotimes (j 7)
            (let ((dy (1+ j)) (i 0))
              (dolist (x (sort (remove-if-not (lambda (y) (= (c-dy y) dy)) *cs*)
                               #'< :key #'c-fr))
                (incf i)
                (unless (and (= (c-fr x) i) (= (c-to x) (1+ i))) (incf k))
                (unless dry (setf (c-fr x) i (c-to x) (1+ i))))))
          (o "compact" k))))
   ((string= v "mirror")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((d1 (i? (nth 0 a))) (d2 (i? (nth 1 a))))
          (if (not (and (in? d1 1 7) (in? d2 1 7))) (e "BADARG")
              (let ((src (remove-if-not (lambda (x) (= (c-dy x) d1)) *cs*)))
                (if (find-if (lambda (x) (fnd (concatenate 'string (c-nm x) "_m")))
                             src)
                    (e "DUP")
                    (progn
                      (unless dry
                        (dolist (x src)
                          (push (mk (concatenate 'string (c-nm x) "_m")
                                    (c-te x) (c-lo x) d2 (c-fr x) (c-to x))
                                *cs*)))
                      (o "mirror" (length src)))))))))
   ((string= v "absorb")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((x (nth 0 a)) (y (nth 1 a)))
          (if (not (and (w? x) (w? y))) (e "BADARG")
              (let ((ca (fnd x)) (cb (fnd y)))
                (cond ((or (null ca) (null cb)) (e "NOTFOUND"))
                      (t (unless dry
                           (setf (c-te ca) (c-te cb) (c-lo ca) (c-lo cb)))
                         (o "absorb" 2))))))))
   ((string= v "swapDays")
    (if (/= 2 (length a)) (e "BADARG")
        (let ((d1 (i? (nth 0 a))) (d2 (i? (nth 1 a))))
          (if (not (and (in? d1 1 7) (in? d2 1 7))) (e "BADARG")
              (let ((n1 0) (n2 0) (new nil))
                (dolist (x *cs*)
                  (cond ((= (c-dy x) d1)
                         (incf n1)
                         (let ((y (copy-c x)))
                           (setf (c-dy y) d2)
                           (push y new)))
                        ((= (c-dy x) d2)
                         (incf n2)
                         (let ((y (copy-c x)))
                           (setf (c-dy y) d1)
                           (push y new)))
                        (t (push x new))))
                (if (bad? new)
                    (e "CONFLICT")
                    (progn (unless dry (setf *cs* new))
                           (o "swapDays" (+ n1 n2)))))))))
   ((string= v "promote")
    (if (/= 1 (length a)) (e "BADARG")
        (let ((nm (car a)))
          (if (not (w? nm)) (e "BADARG")
              (let ((x (fnd nm)))
                (if (null x) (e "NOTFOUND")
                    (let ((dy (c-dy x))
                          (ln (1+ (- (c-to x) (c-fr x))))
                          (nd nil))
                      (do ((s 1 (1+ s)))
                          ((or nd (> (+ s ln -1) 12)))
                        (unless (ovl dy s (+ s ln -1) nm) (setf nd s)))
                      (when nd
                        (unless dry
                          (setf (c-fr x) nd (c-to x) (+ nd ln -1))))
                      (o "promote" 1))))))))
   ((string= v "purge")
    (if (/= 1 (length a)) (e "BADARG")
        (let ((te (car a)))
          (if (not (w? te)) (e "BADARG")
              (let ((k (count-if (lambda (x) (string= (c-te x) te)) *cs*)))
                (unless dry
                  (setf *cs* (remove-if (lambda (x) (string= (c-te x) te)) *cs*)))
                (o "purge" k))))))
   (t (e "BADARG"))))

(dolist (cmd (argv*))
  (let ((toks (sp cmd)) (dry nil))
    (if (null toks)
        (e "BADARG")
        (progn
          (when (string= (car toks) "--dry")
            (setf dry t toks (cdr toks)))
          (if (null toks)
              (e "BADARG")
              (run (car toks) (cdr toks) dry))))))

(format t "#state~%")

(dolist (x (ord *cs*))
  (format t "~a|~a|~a|~a|~a-~a~%"
          (c-nm x) (c-te x) (c-lo x) (c-dy x) (c-fr x) (c-to x)))
