(defstruct (course (:constructor make-course (name teacher loc day from to)))
  name teacher loc day from to)

(defvar *courses* nil)
(defvar *ops* (make-hash-table :test #'equal))

(defun whitespace-char-p (ch)
  (or (char= ch #\Space)
      (char= ch #\Tab)
      (char= ch #\Newline)
      (char= ch #\Return)
      (char= ch #\Page)))

(defun split-words (s)
  (let ((words nil) (start nil) (len (length s)))
    (loop for i from 0 below len do
      (let ((ch (char s i)))
        (if (whitespace-char-p ch)
            (when start
              (push (subseq s start i) words)
              (setf start nil))
            (unless start (setf start i)))))
    (when start (push (subseq s start len) words))
    (nreverse words)))

(defun parse-int-safe (s)
  (if (stringp s)
      (handler-case
          (parse-integer s :junk-allowed nil)
        (error () nil))
      nil))

(defun valid-word-p (s)
  (and (stringp s)
       (<= 1 (length s) 12)
       (every (lambda (ch) (not (whitespace-char-p ch))) s)))

(defun valid-day-p (x)
  (and (integerp x) (<= 1 x 7)))

(defun valid-time-p (x)
  (and (integerp x) (<= 1 x 12)))

(defun intervals-overlap-p (f1 t1 f2 t2)
  (and (<= f1 t2) (<= f2 t1)))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun conflicts-p (day from to &optional except)
  (some (lambda (c)
          (and (not (eq c except))
               (= (course-day c) day)
               (intervals-overlap-p from to (course-from c) (course-to c))))
        *courses*))

(defun any-conflict-with? (day from to exceptions)
  (some (lambda (c)
          (and (not (member c exceptions :test #'eq))
               (= (course-day c) day)
               (intervals-overlap-p from to (course-from c) (course-to c))))
        *courses*))

(defmacro fail (code)
  `(throw 'op-error (list :err ,code)))

(defmacro defop (name params &body body)
  (let ((fn (intern (format nil "OP-~A" (symbol-name name))))
        (verb (string-downcase (symbol-name name)))
        (arity (length params)))
    `(progn
       (defun ,fn (args)
         (if (/= (length args) ,arity)
             (list :err "BADARG")
             (destructuring-bind ,params args
               (catch 'op-error
                 (list :ok (progn ,@body))))))
       (setf (gethash ,verb *ops*) #',fn))))

(defop add (name teacher loc day from to)
  (unless (and (valid-word-p name)
               (valid-word-p teacher)
               (valid-word-p loc))
    (fail "BADARG"))
  (let ((d (parse-int-safe day))
        (f (parse-int-safe from))
        (tt (parse-int-safe to)))
    (unless (and (valid-day-p d)
                 (valid-time-p f)
                 (valid-time-p tt)
                 (<= f tt))
      (fail "BADARG"))
    (when (find-course name) (fail "DUP"))
    (when (>= (length *courses*) 20) (fail "LIMIT"))
    (when (conflicts-p d f tt) (fail "CONFLICT"))
    (push (make-course name teacher loc d f tt) *courses*)
    1))

(defop del (name)
  (unless (valid-word-p name) (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (setf *courses* (remove c *courses* :test #'eq))
    1))

(defop edit (name teacher loc)
  (unless (and (valid-word-p name)
               (valid-word-p teacher)
               (valid-word-p loc))
    (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (setf (course-teacher c) teacher
          (course-loc c) loc)
    1))

(defop move (name day from to)
  (unless (valid-word-p name) (fail "BADARG"))
  (let ((d (parse-int-safe day))
        (f (parse-int-safe from))
        (tt (parse-int-safe to)))
    (unless (and (valid-day-p d)
                 (valid-time-p f)
                 (valid-time-p tt)
                 (<= f tt))
      (fail "BADARG"))
    (let ((c (find-course name)))
      (unless c (fail "NOTFOUND"))
      (when (conflicts-p d f tt c) (fail "CONFLICT"))
      (setf (course-day c) d
            (course-from c) f
            (course-to c) tt)
      1)))

(defop swap (a b)
  (unless (and (valid-word-p a) (valid-word-p b)) (fail "BADARG"))
  (let ((ca (find-course a))
        (cb (find-course b)))
    (unless (and ca cb) (fail "NOTFOUND"))
    (unless (eq ca cb)
      (let ((ad (course-day ca)) (af (course-from ca)) (at (course-to ca))
            (bd (course-day cb)) (bf (course-from cb)) (bt (course-to cb)))
        (when (or (and (= bd ad) (intervals-overlap-p bf bt af at))
                  (any-conflict-with? bd bf bt (list ca cb))
                  (any-conflict-with? ad af at (list ca cb)))
          (fail "CONFLICT"))
        (setf (course-day ca) bd
              (course-from ca) bf
              (course-to ca) bt)
        (setf (course-day cb) ad
              (course-from cb) af
              (course-to cb) at)))
    2))

(defop rename (old new)
  (unless (and (valid-word-p old) (valid-word-p new)) (fail "BADARG"))
  (let ((c (find-course old)))
    (unless c (fail "NOTFOUND"))
    (when (find-course new) (fail "DUP"))
    (setf (course-name c) new)
    1))

(defop duplicate (name newname)
  (unless (and (valid-word-p name) (valid-word-p newname)) (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (when (find-course newname) (fail "DUP"))
    (when (>= (length *courses*) 20) (fail "LIMIT"))
    (push (make-course newname
                       (course-teacher c)
                       (course-loc c)
                       (course-day c)
                       (course-from c)
                       (course-to c))
          *courses*)
    1))

(defop trim (day to)
  (let ((d (parse-int-safe day))
        (tt (parse-int-safe to)))
    (unless (and (valid-day-p d) (valid-time-p tt)) (fail "BADARG"))
    (let ((n 0))
      (dolist (c *courses*)
        (when (and (= (course-day c) d)
                   (<= (course-from c) tt)
                   (< tt (course-to c)))
          (setf (course-to c) tt)
          (incf n)))
      n)))

(defop clear (day)
  (let ((d (parse-int-safe day)))
    (unless (valid-day-p d) (fail "BADARG"))
    (let ((old (length *courses*)))
      (setf *courses*
            (remove-if (lambda (c) (= (course-day c) d)) *courses*))
      (- old (length *courses*)))))

(defop shift (day delta)
  (let ((d (parse-int-safe day))
        (dd (parse-int-safe delta)))
    (unless (and (valid-day-p d) (integerp dd)) (fail "BADARG"))
    (let ((new (+ d dd)))
      (unless (valid-day-p new) (fail "BADARG"))
      (let ((affected (remove-if-not (lambda (c) (= (course-day c) d))
                                     *courses*)))
        (dolist (c affected)
          (when (any-conflict-with? new (course-from c) (course-to c) affected)
            (fail "CONFLICT")))
        (dolist (c affected)
          (setf (course-day c) new))
        (length affected)))))

(defop copy (name day)
  (unless (valid-word-p name) (fail "BADARG"))
  (let ((d (parse-int-safe day)))
    (unless (valid-day-p d) (fail "BADARG"))
    (let ((c (find-course name)))
      (unless c (fail "NOTFOUND"))
      (let ((newname (concatenate 'string name "_2")))
        (unless (valid-word-p newname) (fail "BADARG"))
        (when (find-course newname) (fail "DUP"))
        (when (>= (length *courses*) 20) (fail "LIMIT"))
        (when (conflicts-p d (course-from c) (course-to c))
          (fail "CONFLICT"))
        (push (make-course newname
                           (course-teacher c)
                           (course-loc c)
                           d
                           (course-from c)
                           (course-to c))
              *courses*)
        1))))

(defop merge (a b)
  (unless (and (valid-word-p a) (valid-word-p b)) (fail "BADARG"))
  (let ((ca (find-course a))
        (cb (find-course b)))
    (unless (and ca cb) (fail "NOTFOUND"))
    (unless (eq ca cb)
      (let ((bt (course-teacher cb))
            (bl (course-loc cb)))
        (unless (string= bt "-")
          (setf (course-teacher ca) bt))
        (unless (string= bl "-")
          (setf (course-loc ca) bl)))
      (setf *courses* (remove cb *courses* :test #'eq)))
    2))

(defop sort ()
  0)

(defop filter (day)
  (let ((d (parse-int-safe day)))
    (unless (valid-day-p d) (fail "BADARG"))
    (count-if (lambda (c) (= (course-day c) d)) *courses*)))

(defop count ()
  (length *courses*))

(defun sbcl-executable-p (s)
  (and (stringp s)
       (let ((low (string-downcase s)))
         (or (string= low "sbcl")
             (string= low "sbcl.exe")
             (not (null (search "sbcl" low)))))))

(defun lisp-script-name-p (s)
  (and (stringp s)
       (let ((n (length s)))
         (and (>= n 5)
              (string-equal (subseq s (- n 5)) ".lisp")))))

(defun command-args ()
  (let ((args (sb-ext:posix-argv)))
    (when (and args (sbcl-executable-p (first args)))
      (pop args))
    (when (and args (string= (first args) "--script"))
      (pop args)
      (when args (pop args)))
    (when (and args (lisp-script-name-p (first args)))
      (pop args))
    args))

(defun process-command (cmd)
  (let* ((tokens (split-words cmd))
         (verb (first tokens))
         (handler (and verb (gethash (string-downcase verb) *ops*))))
    (if handler
        (let ((res (funcall handler (rest tokens))))
          (if (eq (first res) :ok)
              (format t "ok ~A ~D~%" (string-downcase verb) (second res))
              (format t "err ~A~%" (second res))))
        (format t "err BADARG~%"))))

(defun main ()
  (dolist (cmd (command-args))
    (process-command cmd))
  (format t "#state~%")
  (dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
    (format t "~A|~A|~A|~D|~D-~D~%"
            (course-name c)
            (course-teacher c)
            (course-loc c)
            (course-day c)
            (course-from c)
            (course-to c))))

(main)
