;;;; v3 timetable ops executor - macro arm
;;;; ASCII only. No external data, no third-party libs, no persistence.
;;;; Input: sb-ext:*posix-argv*. Output: stdout, one line per command, then #state.

(defstruct course name teacher loc day from to)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defvar *courses* '())
  (defvar *op-registry* '())

  (defun register-op (name fn)
    (unless (member name *op-registry* :key #'car :test #'string=)
      (push (cons name fn) *op-registry*)))

  (defun op-fail (code) (throw 'op-fail (list :err code)))
  (defun badarg () (op-fail "BADARG"))
  (defun notfound () (op-fail "NOTFOUND"))
  (defun conflict () (op-fail "CONFLICT"))
  (defun err-dup () (op-fail "DUP"))
  (defun err-limit () (op-fail "LIMIT"))

  (defun blank-char-p (ch) (<= (char-code ch) 32))

  (defun digits-only-p (s) (and (> (length s) 0) (every #'digit-char-p s)))

  (defun parse-word (s)
    (let ((n (length s)))
      (when (or (< n 1) (> n 12)) (badarg))
      (dotimes (i n) (when (blank-char-p (char s i)) (badarg)))
      s))

  (defun parse-uint (s lo hi)
    (unless (digits-only-p s) (badarg))
    (let ((v (parse-integer s)))
      (when (or (< v lo) (> v hi)) (badarg))
      v))

  (defun parse-int (s)
    (cond ((digits-only-p s) (parse-integer s))
          ((and (> (length s) 1) (char= (char s 0) #\-) (digits-only-p (subseq s 1)))
           (- (parse-integer (subseq s 1))))
          (t (badarg))))

  (defun parser-form (type args i)
    (ecase type
      (:word `(parse-word (nth ,i ,args)))
      (:day `(parse-uint (nth ,i ,args) 1 7))
      (:slot `(parse-uint (nth ,i ,args) 1 12))
      (:nat `(parse-uint (nth ,i ,args) 0 9999))
      (:int `(parse-int (nth ,i ,args)))))

  (defun op-fn (name) (intern (format nil "OP-~:@(~a~)" name))))

(defmacro defop (name spec &body body)
  `(progn
     (defun ,(op-fn name) (args)
       (unless (= (length args) ,(length spec)) (badarg))
       (let* ,(loop for (var type) in spec
                    for i from 0
                    collect `(,var ,(parser-form type 'args i)))
         ,@body))
     (eval-when (:compile-toplevel :load-toplevel :execute)
       (register-op ,name ',(op-fn name)))))

(defmacro defdispatch ()
  `(defun dispatch (verb args)
     (cond
       ,@(loop for (name . fn) in (reverse *op-registry*)
               collect `((string= verb ,(string-downcase name)) (,fn args)))
       (t (badarg)))))

(defun find-course (nm) (find nm *courses* :key #'course-name :test #'string=))
(defun courses-on (dy) (remove-if-not (lambda (c) (eql (course-day c) dy)) *courses*))

(defun clash-p (dy fr tn &optional skip)
  (some (lambda (c)
          (and (eql (course-day c) dy)
               (not (eq c skip))
               (<= fr (course-to c))
               (<= (course-from c) tn)))
        *courses*))

(defun copy-courses (cs) (mapcar #'copy-course cs))
(defun schedule-free-p (tuples)
  (let ((sorted (sort (copy-list tuples) #'< :key #'first)))
    (loop for rest on sorted
          for a = (first rest)
          always (not (some (lambda (b)
                              (and (= (first a) (first b))
                                   (<= (second a) (third b))
                                   (<= (second b) (third a))))
                            (rest rest))))))
(defun compress-day (dy)
  (let* ((on (sort (courses-on dy) #'< :key #'course-from))
         (k 0)
         (n 0))
    (dolist (c on)
      (incf k)
      (unless (and (= (course-from c) k) (= (course-to c) (1+ k)))
        (setf (course-from c) k (course-to c) (1+ k))
        (incf n)))
    n))

(defop "add" ((nm :word) (tc :word) (lc :word) (dy :day) (fr :slot) (tn :slot))
  (when (< tn fr) (badarg))
  (when (find-course nm) (err-dup))
  (when (>= (length *courses*) 20) (err-limit))
  (when (clash-p dy fr tn) (conflict))
  (push (make-course :name nm :teacher tc :loc lc :day dy :from fr :to tn) *courses*)
  1)

(defop "del" ((nm :word))
  (let ((c (find-course nm)))
    (unless c (notfound))
    (setf *courses* (remove c *courses* :test #'eq))
    1))

(defop "edit" ((nm :word) (tc :word) (lc :word))
  (let ((c (find-course nm)))
    (unless c (notfound))
    (setf (course-teacher c) tc (course-loc c) lc)
    1))

(defop "move" ((nm :word) (dy :day) (fr :slot) (tn :slot))
  (when (< tn fr) (badarg))
  (let ((c (find-course nm)))
    (unless c (notfound))
    (when (clash-p dy fr tn c) (conflict))
    (setf (course-day c) dy (course-from c) fr (course-to c) tn)
    1))

(defop "swap" ((a :word) (b :word))
  (let ((ca (find-course a)) (cb (find-course b)))
    (unless ca (notfound))
    (unless cb (notfound))
    (rotatef (course-day ca) (course-day cb))
    (rotatef (course-from ca) (course-from cb))
    (rotatef (course-to ca) (course-to cb))
    2))

(defop "rename" ((old :word) (new :word))
  (let ((c (find-course old)))
    (unless c (notfound))
    (when (and (not (string= old new)) (find-course new)) (err-dup))
    (setf (course-name c) new)
    1))

(defop "duplicate" ((nm :word) (nn :word))
  (let ((c (find-course nm)))
    (unless c (notfound))
    (when (find-course nn) (err-dup))
    (let ((cc (copy-course c)))
      (setf (course-name cc) nn)
      (push cc *courses*))
    1))

(defop "trim" ((dy :day) (tn :slot))
  (let ((n 0))
    (dolist (c *courses*)
      (when (and (eql (course-day c) dy)
                 (<= (course-from c) tn)
                 (< tn (course-to c)))
        (setf (course-to c) tn)
        (incf n)))
    n))

(defop "clear" ((dy :day))
  (let ((n (length (courses-on dy))))
    (setf *courses* (remove-if (lambda (c) (eql (course-day c) dy)) *courses*))
    n))

(defop "shift" ((dy :day) (dl :int))
  (let ((nd (+ dy dl)))
    (unless (<= 1 nd 7) (badarg))
    (let ((n 0))
      (dolist (c *courses*)
        (when (eql (course-day c) dy)
          (setf (course-day c) nd)
          (incf n)))
      n)))

(defop "copy" ((nm :word) (dy :day))
  (let ((c (find-course nm)))
    (unless c (notfound))
    (let ((nn (concatenate 'string nm "_2")))
      (when (find-course nn) (err-dup))
      (let ((cc (copy-course c)))
        (setf (course-name cc) nn (course-day cc) dy)
        (push cc *courses*)))
    1))

(defop "merge" ((a :word) (b :word))
  (let ((ca (find-course a)) (cb (find-course b)))
    (unless ca (notfound))
    (unless cb (notfound))
    (setf (course-teacher ca) (course-teacher cb)
          (course-loc ca) (course-loc cb))
    (setf *courses* (remove cb *courses* :test #'eq))
    2))

(defop "sort" ()
  0)

(defop "filter" ((dy :day))
  (length (courses-on dy)))

(defop "count" ()
  (length *courses*))
(defop "swapTeacher" ((a :word) (b :word))
  (let ((ca (find-course a)) (cb (find-course b)))
    (unless ca (notfound))
    (unless cb (notfound))
    (rotatef (course-teacher ca) (course-teacher cb))
    2))

(defop "swapLoc" ((a :word) (b :word))
  (let ((ca (find-course a)) (cb (find-course b)))
    (unless ca (notfound))
    (unless cb (notfound))
    (rotatef (course-loc ca) (course-loc cb))
    2))

(defop "copyTo" ((nm :word) (dy :day) (fr :slot) (tn :slot))
  (when (< tn fr) (badarg))
  (let ((c (find-course nm)))
    (unless c (notfound))
    (let ((nn (concatenate 'string nm "_3")))
      (when (find-course nn) (err-dup))
      (when (clash-p dy fr tn) (conflict))
      (let ((cc (copy-course c)))
        (setf (course-name cc) nn (course-day cc) dy
              (course-from cc) fr (course-to cc) tn)
        (push cc *courses*)))
    1))

(defop "truncate" ((dy :day))
  (let ((on (courses-on dy)))
    (if (null on)
        0
        (let* ((ranked (sort (copy-list on) #'string< :key #'course-name))
               (keep-one (first ranked))
               (n (1- (length ranked))))
          (setf *courses*
                (remove-if (lambda (c)
                             (and (eql (course-day c) dy) (not (eq c keep-one))))
                           *courses*))
          n))))

(defop "keep" ((dy :day) (k :nat))
  (let* ((ranked (sort (courses-on dy) #'string< :key #'course-name))
         (drop (nthcdr k ranked)))
    (setf *courses* (remove-if (lambda (c) (member c drop)) *courses*))
    (length drop)))

(defop "renameTeacher" ((a :word) (b :word))
  (let ((n 0))
    (dolist (c *courses*)
      (when (string= (course-teacher c) a)
        (setf (course-teacher c) b)
        (incf n)))
    n))

(defop "renameLoc" ((a :word) (b :word))
  (let ((n 0))
    (dolist (c *courses*)
      (when (string= (course-loc c) a)
        (setf (course-loc c) b)
        (incf n)))
    n))

(defop "dedupe" ()
  (let ((seen '()) (n 0))
    (dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
      (let ((key (list (course-teacher c) (course-loc c) (course-day c)
                       (course-from c) (course-to c))))
        (if (member key seen :test #'equal)
            (progn (setf *courses* (remove c *courses* :test #'eq))
                   (incf n))
            (push key seen))))
    n))

(defop "compress" ((dy :day))
  (compress-day dy))

(defop "compact" ()
  (loop for d from 1 to 7 sum (compress-day d)))
(defop "mirror" ((d1 :day) (d2 :day))
  (let* ((on (courses-on d1))
         (pairs (mapcar (lambda (c)
                          (cons c (concatenate 'string (course-name c) "_m")))
                        on)))
    (dolist (p pairs)
      (when (find-course (cdr p)) (err-dup)))
    (dolist (p pairs)
      (let ((cc (copy-course (car p))))
        (setf (course-name cc) (cdr p) (course-day cc) d2)
        (push cc *courses*)))
    (length pairs)))

(defop "absorb" ((a :word) (b :word))
  (let ((ca (find-course a)) (cb (find-course b)))
    (unless ca (notfound))
    (unless cb (notfound))
    (setf (course-teacher ca) (course-teacher cb)
          (course-loc ca) (course-loc cb))
    2))

(defop "swapDays" ((d1 :day) (d2 :day))
  (let* ((n (+ (length (courses-on d1)) (length (courses-on d2))))
         (sim (mapcar (lambda (c)
                        (list (cond ((eql (course-day c) d1) d2)
                                    ((eql (course-day c) d2) d1)
                                    (t (course-day c)))
                              (course-from c)
                              (course-to c)))
                      *courses*)))
    (unless (schedule-free-p sim) (conflict))
    (dolist (c *courses*)
      (cond ((eql (course-day c) d1) (setf (course-day c) d2))
            ((eql (course-day c) d2) (setf (course-day c) d1))))
    n))

(defop "promote" ((nm :word))
  (let ((c (find-course nm)))
    (unless c (notfound))
    (let* ((len (1+ (- (course-to c) (course-from c))))
           (dy (course-day c))
           (slot (loop for f from 1 to (- 13 len)
                       unless (clash-p dy f (+ f (1- len)) c)
                         return f)))
      (unless slot (conflict))
      (setf (course-from c) slot
            (course-to c) (+ slot (1- len)))
      1)))

(defop "purge" ((tc :word))
  (let ((n (count-if (lambda (c) (string= (course-teacher c) tc)) *courses*)))
    (setf *courses* (remove-if (lambda (c) (string= (course-teacher c) tc)) *courses*))
    n))

(defdispatch)

(defun split-tokens (s)
  (let ((out '()) (start nil))
    (dotimes (i (length s))
      (if (blank-char-p (char s i))
          (when start (push (subseq s start i) out) (setf start nil))
          (unless start (setf start i))))
    (when start (push (subseq s start) out))
    (nreverse out)))

(defun command-args ()
  (let ((rest (rest sb-ext:*posix-argv*)))
    (when (and rest (string= (first rest) "--script"))
      (setf rest (rest rest))
      (when rest (setf rest (rest rest))))
    (when (and rest (script-file-p (first rest)))
      (setf rest (rest rest)))
    rest))

(defun script-file-p (s)
  (let ((n (length s))) (and (>= n 6) (string= s ".lisp" :start1 (- n 5)))))

(defun exec-command (cmd)
  (let ((tokens (split-tokens cmd)))
    (when (null tokens) (badarg))
    (let* ((dry (string= (first tokens) "--dry"))
           (rest (if dry (rest tokens) tokens)))
      (when (null rest) (badarg))
      (let ((verb (string-downcase (first rest)))
            (args (rest rest)))
        (values verb
                (if dry
                    (let ((*courses* (copy-courses *courses*)))
                      (dispatch verb args))
                    (dispatch verb args)))))))

(defun run-command (cmd)
  (let ((r (catch 'op-fail
             (multiple-value-bind (verb n) (exec-command cmd)
               (list :ok verb n)))))
    (if (eq (first r) :ok)
        (format t "ok ~a ~d~%" (second r) (third r))
        (format t "err ~a~%" (second r)))))

(defun print-state ()
  (write-line "#state")
  (dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
    (format t "~a|~a|~a|~d|~d-~d~%"
            (course-name c) (course-teacher c) (course-loc c)
            (course-day c) (course-from c) (course-to c))))

(defun main ()
  (dolist (cmd (command-args))
    (run-command cmd))
  (print-state)
  (finish-output))

(main)
