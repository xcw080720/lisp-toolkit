(defstruct course name teacher loc day from to)

(defvar *courses* nil)

(defun split-command (str)
  (let ((tokens '())
        (start 0)
        (len (length str)))
    (labels ((push-token (end)
               (when (> end start)
                 (push (subseq str start end) tokens))))
      (do ((i 0 (1+ i)))
          ((>= i len)
           (push-token len)
           (nreverse tokens))
        (let ((ch (char str i)))
          (when (or (char= ch #\Space) (char= ch #\Tab))
            (push-token i)
            (setf start (1+ i))))))))

(defun parse-int (s)
  (handler-case
      (parse-integer s :junk-allowed nil)
    (error () nil)))

(defun word-valid-p (s)
  (and (stringp s)
       (<= 1 (length s) 12)))

(defun valid-day-p (n)
  (and (integerp n) (<= 1 n 7)))

(defun valid-time-p (n)
  (and (integerp n) (<= 1 n 12)))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun conflicts-p (day from to exclude-name)
  (some (lambda (c)
          (and (or (null exclude-name)
                   (not (string= (course-name c) exclude-name)))
               (= (course-day c) day)
               (<= (course-from c) to)
               (<= from (course-to c))))
        *courses*))

(defun err (code)
  (format t "err ~A~%" code))

(defun ok (verb n)
  (format t "ok ~A ~D~%" verb n))

(defun cmd-add (args)
  (if (/= (length args) 6)
      (err "BADARG")
      (destructuring-bind (name teacher loc day-s from-s to-s) args
        (let ((day (parse-int day-s))
              (from (parse-int from-s))
              (to (parse-int to-s)))
          (if (or (not (word-valid-p name))
                  (not (word-valid-p teacher))
                  (not (word-valid-p loc))
                  (not (valid-day-p day))
                  (not (valid-time-p from))
                  (not (valid-time-p to))
                  (> from to))
              (err "BADARG")
              (if (find-course name)
                  (err "DUP")
                  (if (>= (length *courses*) 20)
                      (err "LIMIT")
                      (if (conflicts-p day from to nil)
                          (err "CONFLICT")
                          (progn
                            (push (make-course :name name :teacher teacher :loc loc
                                               :day day :from from :to to)
                                  *courses*)
                            (ok "add" 1))))))))))

(defun cmd-del (args)
  (if (/= (length args) 1)
      (err "BADARG")
      (let ((name (first args)))
        (if (not (word-valid-p name))
            (err "BADARG")
            (let ((c (find-course name)))
              (if (null c)
                  (err "NOTFOUND")
                  (progn
                    (setf *courses* (remove name *courses* :key #'course-name :test #'string=))
                    (ok "del" 1))))))))

(defun cmd-edit (args)
  (if (/= (length args) 3)
      (err "BADARG")
      (destructuring-bind (name teacher loc) args
        (if (or (not (word-valid-p name))
                (not (word-valid-p teacher))
                (not (word-valid-p loc)))
            (err "BADARG")
            (let ((c (find-course name)))
              (if (null c)
                  (err "NOTFOUND")
                  (progn
                    (setf (course-teacher c) teacher
                          (course-loc c) loc)
                    (ok "edit" 1))))))))

(defun cmd-move (args)
  (if (/= (length args) 4)
      (err "BADARG")
      (destructuring-bind (name day-s from-s to-s) args
        (let ((day (parse-int day-s))
              (from (parse-int from-s))
              (to (parse-int to-s)))
          (if (or (not (word-valid-p name))
                  (not (valid-day-p day))
                  (not (valid-time-p from))
                  (not (valid-time-p to))
                  (> from to))
              (err "BADARG")
              (let ((c (find-course name)))
                (if (null c)
                    (err "NOTFOUND")
                    (if (conflicts-p day from to name)
                        (err "CONFLICT")
                        (progn
                          (setf (course-day c) day
                                (course-from c) from
                                (course-to c) to)
                          (ok "move" 1))))))))))

(defun cmd-swap (args)
  (if (/= (length args) 2)
      (err "BADARG")
      (destructuring-bind (a b) args
        (if (or (not (word-valid-p a)) (not (word-valid-p b)))
            (err "BADARG")
            (let ((ca (find-course a))
                  (cb (find-course b)))
              (if (or (null ca) (null cb))
                  (err "NOTFOUND")
                  (progn
                    (unless (eq ca cb)
                      (rotatef (course-day ca) (course-day cb))
                      (rotatef (course-from ca) (course-from cb))
                      (rotatef (course-to ca) (course-to cb)))
                    (ok "swap" 2))))))))

(defun cmd-rename (args)
  (if (/= (length args) 2)
      (err "BADARG")
      (destructuring-bind (old new) args
        (if (or (not (word-valid-p old)) (not (word-valid-p new)))
            (err "BADARG")
            (let ((c (find-course old)))
              (if (null c)
                  (err "NOTFOUND")
                  (if (find-course new)
                      (err "DUP")
                      (progn
                        (setf (course-name c) new)
                        (ok "rename" 1)))))))))

(defun cmd-duplicate (args)
  (if (/= (length args) 2)
      (err "BADARG")
      (destructuring-bind (name newname) args
        (if (or (not (word-valid-p name)) (not (word-valid-p newname)))
            (err "BADARG")
            (let ((c (find-course name)))
              (if (null c)
                  (err "NOTFOUND")
                  (if (find-course newname)
                      (err "DUP")
                      (if (>= (length *courses*) 20)
                          (err "LIMIT")
                          (progn
                            (push (make-course :name newname
                                               :teacher (course-teacher c)
                                               :loc (course-loc c)
                                               :day (course-day c)
                                               :from (course-from c)
                                               :to (course-to c))
                                  *courses*)
                            (ok "duplicate" 1))))))))))

(defun cmd-trim (args)
  (if (/= (length args) 2)
      (err "BADARG")
      (destructuring-bind (day-s to-s) args
        (let ((day (parse-int day-s))
              (to (parse-int to-s)))
          (if (or (not (valid-day-p day)) (not (valid-time-p to)))
              (err "BADARG")
              (let ((count 0))
                (dolist (c *courses*)
                  (when (and (= (course-day c) day)
                             (<= (course-from c) to)
                             (< to (course-to c)))
                    (setf (course-to c) to)
                    (incf count)))
                (ok "trim" count)))))))

(defun cmd-clear (args)
  (if (/= (length args) 1)
      (err "BADARG")
      (let ((day (parse-int (first args))))
        (if (not (valid-day-p day))
            (err "BADARG")
            (let ((old-len (length *courses*)))
              (setf *courses* (remove day *courses* :key #'course-day))
              (ok "clear" (- old-len (length *courses*)))))))))

(defun cmd-shift (args)
  (if (/= (length args) 2)
      (err "BADARG")
      (destructuring-bind (day-s delta-s) args
        (let ((day (parse-int day-s))
              (delta (parse-int delta-s)))
          (if (or (not (valid-day-p day)) (not (integerp delta)))
              (err "BADARG")
              (let ((newday (+ day delta)))
                (if (not (valid-day-p newday))
                    (err "BADARG")
                    (let ((count 0))
                      (dolist (c *courses*)
                        (when (= (course-day c) day)
                          (setf (course-day c) newday)
                          (incf count)))
                      (ok "shift" count)))))))))

(defun cmd-copy (args)
  (if (/= (length args) 2)
      (err "BADARG")
      (destructuring-bind (name day-s) args
        (let ((day (parse-int day-s)))
          (if (or (not (word-valid-p name)) (not (valid-day-p day)))
              (err "BADARG")
              (let ((c (find-course name)))
                (if (null c)
                    (err "NOTFOUND")
                    (let ((newname (concatenate 'string name "_2")))
                      (if (not (word-valid-p newname))
                          (err "BADARG")
                          (if (find-course newname)
                              (err "DUP")
                              (if (>= (length *courses*) 20)
                                  (err "LIMIT")
                                  (progn
                                    (push (make-course :name newname
                                                       :teacher (course-teacher c)
                                                       :loc (course-loc c)
                                                       :day day
                                                       :from (course-from c)
                                                       :to (course-to c))
                                          *courses*)
                                    (ok "copy" 1))))))))))))

(defun cmd-merge (args)
  (if (/= (length args) 2)
      (err "BADARG")
      (destructuring-bind (aname bname) args
        (if (or (not (word-valid-p aname)) (not (word-valid-p bname)))
            (err "BADARG")
            (let ((a (find-course aname))
                  (b (find-course bname)))
              (if (or (null a) (null b))
                  (err "NOTFOUND")
                  (progn
                    (setf (course-teacher a) (course-teacher b)
                          (course-loc a) (course-loc b))
                    (setf *courses* (remove bname *courses* :key #'course-name :test #'string=))
                    (ok "merge" 2))))))))

(defun cmd-sort (args)
  (if (not (null args))
      (err "BADARG")
      (progn
        (setf *courses* (sort *courses* #'string< :key #'course-name))
        (ok "sort" 0))))

(defun cmd-filter (args)
  (if (/= (length args) 1)
      (err "BADARG")
      (let ((day (parse-int (first args))))
        (if (not (valid-day-p day))
            (err "BADARG")
            (ok "filter" (count day *courses* :key #'course-day :test #'=))))))

(defun cmd-count (args)
  (if (not (null args))
      (err "BADARG")
      (ok "count" (length *courses*))))

(defun process-command (cmd)
  (let ((tokens (split-command cmd)))
    (if (null tokens)
        (err "BADARG")
        (let ((verb (first tokens))
              (args (rest tokens)))
          (cond
            ((string= verb "add") (cmd-add args))
            ((string= verb "del") (cmd-del args))
            ((string= verb "edit") (cmd-edit args))
            ((string= verb "move") (cmd-move args))
            ((string= verb "swap") (cmd-swap args))
            ((string= verb "rename") (cmd-rename args))
            ((string= verb "duplicate") (cmd-duplicate args))
            ((string= verb "trim") (cmd-trim args))
            ((string= verb "clear") (cmd-clear args))
            ((string= verb "shift") (cmd-shift args))
            ((string= verb "copy") (cmd-copy args))
            ((string= verb "merge") (cmd-merge args))
            ((string= verb "sort") (cmd-sort args))
            ((string= verb "filter") (cmd-filter args))
            ((string= verb "count") (cmd-count args))
            (t (err "BADARG")))))))

(defun script-args ()
  (let ((argv sb-ext:*posix-argv*))
    (let ((lisp-pos (position-if (lambda (s)
                                   (and (stringp s)
                                        (search ".lisp" s :test #'char-equal)))
                                 argv)))
      (cond
        (lisp-pos (nthcdr (1+ lisp-pos) argv))
        ((and argv (stringp (first argv))
              (search "sbcl" (first argv) :test #'char-equal))
         (rest argv))
        (t argv)))))

(let ((cmd-args (script-args)))
  (dolist (cmd cmd-args)
    (process-command cmd))
  (format t "#state~%")
  (dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
    (format t "~A|~A|~A|~D|~D-~D~%"
            (course-name c)
            (course-teacher c)
            (course-loc c)
            (course-day c)
            (course-from c)
            (course-to c))))
