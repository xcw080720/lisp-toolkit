;;; impl.lisp — 课表 ops 执行器：add / del / edit / move / swap
;;; 用法： sbcl --script impl.lisp <input.json>

;;; ============ JSON 读 ============
(defvar *s* "") (defvar *i* 0) (defvar *len* 0)

(defun jerr (m) (error "JSON: ~a (at ~d)" m *i*))
(defun peek-at (k) (let ((j (+ *i* k))) (if (< j *len*) (char *s* j) nil)))
(defun peekc () (peek-at 0))
(defun ws? (c) (member c '(#\Space #\Tab #\Newline #\Return) :test #'char=))
(defun skip-ws () (loop while (and (< *i* *len*) (ws? (char *s* *i*))) do (incf *i*)))

(defun hex4 ()
  (let ((n (parse-integer *s* :start *i* :end (+ *i* 4) :radix 16)))
    (incf *i* 4) n))

(defun p-string ()
  (incf *i*)                                     ; 开引号
  (let ((out (make-string-output-stream)))
    (loop
      (let ((c (peekc)))
        (cond ((null c) (jerr "字符串未闭合"))
              ((char= c #\") (incf *i*) (return))
              ((char= c #\\)
               (incf *i*)
               (let ((e (peekc)))
                 (incf *i*)
                 (case e
                   (#\" (write-char #\" out))
                   (#\\ (write-char #\\ out))
                   (#\/ (write-char #\/ out))
                   (#\b (write-char #\Backspace out))
                   (#\f (write-char #\Page out))
                   (#\n (write-char #\Newline out))
                   (#\r (write-char #\Return out))
                   (#\t (write-char #\Tab out))
                   (#\u (let ((hi (hex4)))
                          (if (and (<= #xd800 hi #xdbff)
                                   (eql (peek-at 0) #\\) (eql (peek-at 1) #\u))
                              (progn (incf *i* 2)
                                     (let ((lo (hex4)))
                                       (write-char (code-char (+ #x10000
                                                                 (ash (- hi #xd800) 10)
                                                                 (- lo #xdc00)))
                                                   out)))
                              (write-char (code-char hi) out))))
                   (t (jerr "坏转义")))))
              (t (write-char c out) (incf *i*)))))
    (get-output-stream-string out)))

(defun p-number ()
  (let ((start *i*))
    (loop while (and (< *i* *len*) (find (char *s* *i*) "-+.eE0123456789")) do (incf *i*))
    (let ((tok (subseq *s* start *i*)))
      (if (some (lambda (c) (member c '(#\. #\e #\E))) tok)
          (let ((*read-eval* nil)) (coerce (read-from-string tok) 'double-float))
          (parse-integer tok)))))

(defun p-array ()
  (incf *i*)                                     ; [
  (let ((acc '()))
    (skip-ws)
    (cond ((eql (peekc) #\]) (incf *i*))
          (t (loop
               (push (p-value) acc)
               (skip-ws)
               (let ((c (peekc)))
                 (cond ((eql c #\,) (incf *i*))
                       ((eql c #\]) (incf *i*) (return))
                       (t (jerr "数组里缺 , 或 ]")))))))
    (cons :a (nreverse acc))))

(defun p-object ()
  (incf *i*)                                     ; {
  (let ((acc '()))
    (skip-ws)
    (cond ((eql (peekc) #\}) (incf *i*))
          (t (loop
               (skip-ws)
               (unless (eql (peekc) #\") (jerr "对象键必须是字符串"))
               (let ((k (p-string)))
                 (skip-ws)
                 (unless (eql (peekc) #\:) (jerr "缺冒号"))
                 (incf *i*)
                 (push (cons k (p-value)) acc))
               (skip-ws)
               (let ((c (peekc)))
                 (cond ((eql c #\,) (incf *i*))
                       ((eql c #\}) (incf *i*) (return))
                       (t (jerr "对象里缺 , 或 }")))))))
    (cons :o (nreverse acc))))

(defun p-value ()
  (skip-ws)
  (let ((c (peekc)))
    (cond ((null c) (jerr "意外结束"))
          ((eql c #\{) (p-object))
          ((eql c #\[) (p-array))
          ((eql c #\") (p-string))
          ((eql c #\t) (incf *i* 4) :true)
          ((eql c #\f) (incf *i* 5) :false)
          ((eql c #\n) (incf *i* 4) :null)
          (t (p-number)))))

(defun parse-json (s)
  (setf *s* s *i* 0 *len* (length s))
  (p-value))

;;; ============ JSON 写 ============
(defun wr-string (str)
  (write-char #\")
  (loop for ch across str do
        (case ch
          (#\" (write-string "\\\""))
          (#\\ (write-string "\\\\"))
          (#\Newline (write-string "\\n"))
          (#\Return (write-string "\\r"))
          (#\Tab (write-string "\\t"))
          (t (if (< (char-code ch) 32)
                 (format t "\\u~4,'0x" (char-code ch))
                 (write-char ch)))))
  (write-char #\"))

(defun wr-num (x)
  (cond ((integerp x) (format t "~d" x))
        ((rationalp x) (wr-num (coerce x 'double-float)))
        (t (write-string (format nil "~f" (coerce x 'double-float))))))

(defun wr (v)
  (cond ((null v) (write-string "null"))
        ((eq v :true) (write-string "true"))
        ((eq v :false) (write-string "false"))
        ((eq v :null) (write-string "null"))
        ((stringp v) (wr-string v))
        ((numberp v) (wr-num v))
        ((consp v)
         (ecase (car v)
           (:o (write-char #\{)
               (loop for (k . val) in (cdr v) for first = t then nil
                     do (unless first (write-char #\,))
                        (wr-string k) (write-char #\:) (wr val))
               (write-char #\}))
           (:a (write-char #\[)
               (loop for x in (cdr v) for first = t then nil
                     do (unless first (write-char #\,)) (wr x))
               (write-char #\]))))
        (t (write-string "null"))))

;;; ============ 模型 ============
(defvar *courses* nil)
(defvar *log* nil)
(defvar *n* 0)
(defvar *otexts* nil)

(defun obj? (x) (and (consp x) (eq (car x) :o)))
(defun arr-items (x) (if (and (consp x) (eq (car x) :a)) (cdr x) nil))
(defun fld (o k) (and (obj? o) (cdr (assoc k (cdr o) :test #'equal))))
(defun fset (o k v)
  (let ((p (assoc k (cdr o) :test #'equal)))
    (if p (setf (cdr p) v) (setf (cdr o) (nconc (cdr o) (list (cons k v))))))
  v)
(defun strv (v) (if (stringp v) v ""))
(defun clampi (v lo hi d)
  (let ((x (cond ((integerp v) v) ((numberp v) (round v)) (t d))))
    (max lo (min hi x))))
(defun default-weeks () (list :o (cons "type" "range") (cons "from" 1) (cons "to" 16)))
(defun matchp (c m) (and (stringp m) (search m (fld c "name") :test #'char=)))
(defun hits (m) (remove-if-not (lambda (c) (matchp c m)) *courses*))
(defun emit (fmt &rest a) (push (apply #'format nil fmt a) *log*))
(defun otext (fmt &rest a) (push (apply #'format nil fmt a) *otexts*))

(defun norm-course (c)
  (let* ((pf (clampi (fld c "periodFrom") 1 1000 1))
         (pt (max (clampi (fld c "periodTo") 1 1000 2) pf))
         (w (fld c "weeks"))
         (tagp (and (obj? c) (assoc "tag" (cdr c) :test #'equal))))
    (list :o
          (cons "name" (strv (fld c "name")))
          (cons "teacher" (strv (fld c "teacher")))
          (cons "location" (strv (fld c "location")))
          (cons "day" (clampi (fld c "day") 1 7 1))
          (cons "periodFrom" pf)
          (cons "periodTo" pt)
          (cons "weeks" (if (obj? w) w (default-weeks)))
          (cons "tag" (if tagp (cdr tagp) :null)))))

;;; ============ ops ============
(defun do-add (op)
  (let ((c (norm-course (fld op "course"))))
    (setf *courses* (nconc *courses* (list c)))
    (incf *n*)
    (emit "加「~a」" (fld c "name"))
    (otext "加「~a」" (fld c "name"))))

(defun do-del (op)
  (let ((m (fld op "match")) (hs (hits (fld op "match"))))
    (if hs
        (progn (setf *courses* (remove-if (lambda (c) (matchp c m)) *courses*))
               (incf *n* (length hs))
               (emit "删「~a」~d 门" m (length hs))
               (otext "删「~a」" m))
        (progn (emit "没找到「~a」" m)
               (otext "删「~a」未命中" m)))))

(defun apply-set (c set)
  (when (obj? set)
    (dolist (kv (cdr set))
      (let ((k (car kv)) (v (cdr kv)))
        (cond ((member k '("name" "teacher" "location") :test #'equal)
               (fset c k (strv v)))
              ((equal k "day") (fset c "day" (clampi v 1 7 1)))
              ((member k '("periodFrom" "periodTo") :test #'equal)
               (fset c k (clampi v 1 1000 1)))
              ((equal k "tag") (fset c "tag" (if (stringp v) v :null))))))
    (when (> (fld c "periodFrom") (fld c "periodTo"))
      (fset c "periodTo" (fld c "periodFrom")))))

(defun do-edit (op)
  (let ((m (fld op "match")) (set (fld op "set")) (hs (hits (fld op "match"))))
    (dolist (c hs) (apply-set c set))
    (if hs
        (progn (incf *n* (length hs))
               (emit "改「~a」~d 门" m (length hs))
               (otext "改「~a」" m))
        (progn (emit "没找到「~a」" m)
               (otext "改「~a」未命中" m)))))

(defun do-move (op)
  (let ((m (fld op "match")) (d (fld op "day"))
        (pf (fld op "periodFrom")) (pt (fld op "periodTo")))
    (if (and (stringp m) (numberp d) (numberp pf) (numberp pt))
        (let ((hs (hits m))
              (d* (clampi d 1 7 1))
              (pf* (clampi pf 1 1000 1))
              (pt* (max (clampi pf 1 1000 1) (clampi pt 1 1000 1))))
          (dolist (c hs)
            (fset c "day" d*) (fset c "periodFrom" pf*) (fset c "periodTo" pt*))
          (incf *n* (length hs))
          (emit "移动 ~d 门到周~d 第~d-~d节" (length hs) d* pf* pt*)
          (otext "移动「~a」" m))
        (progn (emit "move 缺 day/periodFrom/periodTo，不执行")
               (otext "move 不执行")))))

(defun swap-f (x y k)
  (let ((tmp (fld x k))) (fset x k (fld y k)) (fset y k tmp)))

(defun do-swap (op)
  (let* ((a (hits (fld op "match"))) (b (hits (fld op "with"))))
    (if (and (= 1 (length a)) (= 1 (length b)))
        (let ((x (car a)) (y (car b)))
          (swap-f x y "day") (swap-f x y "periodFrom") (swap-f x y "periodTo")
          (incf *n* 2)
          (emit "互换「~a」与「~a」" (fld x "name") (fld y "name"))
          (otext "互换"))
        (progn (emit "swap 未执行：两侧各需命中恰好 1 门")
               (otext "swap 不执行")))))

(defun known? (op)
  (member (fld op "op") '("add" "del" "edit" "move" "swap") :test #'equal))

(defun run-op (op)
  (let ((name (fld op "op")))
    (cond ((equal name "add") (do-add op))
          ((equal name "del") (do-del op))
          ((equal name "edit") (do-edit op))
          ((equal name "move") (do-move op))
          ((equal name "swap") (do-swap op)))))

;;; ============ 输出 ============
(defun out ()
  (write-string "{\"opsText\":")
  (wr (if *otexts* (format nil "~{~a~^；~}" (reverse *otexts*)) ""))
  (write-string ",\"courses\":")
  (wr (cons :a *courses*))
  (write-string ",\"log\":")
  (wr (cons :a (loop for s in (reverse *log*) for i from 1
                     collect (format nil "~d) ~a" i s))))
  (format t ",\"n\":~d}~%" *n*))

;;; ============ 入口 ============
(defun slurp (path)
  (with-open-file (in path :direction :input :external-format :utf-8)
    (let ((out (make-string-output-stream)))
      (loop for ch = (read-char in nil nil) while ch do (write-char ch out))
      (get-output-stream-string out))))

(defun main ()
  (let* ((path (car (last sb-ext:*posix-argv*)))
         (root (parse-json (slurp path)))
         (cs (arr-items (fld root "courses")))
         (ops (arr-items (fld root "ops")))
         (bad (find-if-not #'known? ops)))
    (setf *courses* (mapcar #'norm-course cs) *n* 0 *log* nil *otexts* nil)
    (if bad
        (setf *courses* (mapcar #'norm-course cs)
              *log* (list (format nil "拒绝：未知 op ~a" (fld bad "op"))))
        (dolist (op ops) (run-op op)))
    (out)))

(main)
