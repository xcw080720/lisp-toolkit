(defstruct course name teacher loc day from to)
(defvar *courses* nil)

(defun split-tokens (str)
  (let ((tokens '()) (start 0) (len (length str)))
    (loop for i from 0 to len
          do (when (or (= i len)
                       (char= (char str i) #\Space)
                       (char= (char str i) #\Tab))
               (when (< start i)
                 (push (subseq str start i) tokens))
               (setf start (1+ i))))
    (nreverse tokens)))

(defun parse-int (s)
  (handler-case (parse-integer s) (error () nil)))

(defun valid-word-p (s)
  (and (stringp s)
       (>= (length s) 1)
       (<= (length s) 12)
       (not (find #\Space s))
       (not (find #\Tab s))))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun conflict-p (day from to &optional (except nil))
  (loop for c in *courses*
        thereis (and (not (eq c except))
                     (= (course-day c) day)
                     (<= from (course-to c))
                     (<= (course-from c) to))))

(defun out-ok (verb n)
  (format t "ok ~a ~d~%" verb n))

(defun out-err (code)
  (format t "err ~a~%" code))

(defun exec-command (line)
  (let ((tokens (split-tokens line)))
    (if (null tokens)
        (out-err "BADARG")
        (let ((verb (first tokens)))
          (cond
            ((string= verb "add")
             (if (= (length tokens) 7)
                 (let ((name (nth 1 tokens))
                       (teacher (nth 2 tokens))
                       (loc (nth 3 tokens))
                       (day (parse-int (nth 4 tokens)))
                       (from (parse-int (nth 5 tokens)))
                       (to (parse-int (nth 6 tokens))))
                   (if (and (valid-word-p name)
                            (valid-word-p teacher)
                            (valid-word-p loc)
                            day from to
                            (<= 1 day 7)
                            (<= 1 from 12)
                            (<= 1 to 12)
                            (<= from to))
                       (cond
                         ((find-course name) (out-err "DUP"))
                         ((conflict-p day from to) (out-err "CONFLICT"))
                         ((>= (length *courses*) 20) (out-err "LIMIT"))
                         (t (push (make-course :name name
                                               :teacher teacher
                                               :loc loc
                                               :day day
                                               :from from
                                               :to to)
                                  *courses*)
                            (out-ok "add" 1)))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "del")
             (if (= (length tokens) 2)
                 (let ((name (nth 1 tokens)))
                   (if (valid-word-p name)
                       (let ((c (find-course name)))
                         (if c
                             (progn
                               (setf *courses* (remove c *courses* :test #'eq))
                               (out-ok "del" 1))
                             (out-err "NOTFOUND")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "edit")
             (if (= (length tokens) 4)
                 (let ((name (nth 1 tokens))
                       (teacher (nth 2 tokens))
                       (loc (nth 3 tokens)))
                   (if (and (valid-word-p name)
                            (valid-word-p teacher)
                            (valid-word-p loc))
                       (let ((c (find-course name)))
                         (if c
                             (progn
                               (setf (course-teacher c) teacher
                                     (course-loc c) loc)
                               (out-ok "edit" 1))
                             (out-err "NOTFOUND")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "move")
             (if (= (length tokens) 5)
                 (let ((name (nth 1 tokens))
                       (day (parse-int (nth 2 tokens)))
                       (from (parse-int (nth 3 tokens)))
                       (to (parse-int (nth 4 tokens))))
                   (if (and (valid-word-p name)
                            day from to
                            (<= 1 day 7)
                            (<= 1 from 12)
                            (<= 1 to 12)
                            (<= from to))
                       (let ((c (find-course name)))
                         (if c
                             (if (conflict-p day from to c)
                                 (out-err "CONFLICT")
                                 (progn
                                   (setf (course-day c) day
                                         (course-from c) from
                                         (course-to c) to)
                                   (out-ok "move" 1)))
                             (out-err "NOTFOUND")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "swap")
             (if (= (length tokens) 3)
                 (let ((an (nth 1 tokens))
                       (bn (nth 2 tokens)))
                   (if (and (valid-word-p an) (valid-word-p bn))
                       (let ((a (find-course an))
                             (b (find-course bn)))
                         (if (and a b)
                             (if (eq a b)
                                 (out-ok "swap" 2)
                                 (let ((ad (course-day a))
                                       (af (course-from a))
                                       (at (course-to a)))
                                   (setf (course-day a) (course-day b)
                                         (course-from a) (course-from b)
                                         (course-to a) (course-to b)
                                         (course-day b) ad
                                         (course-from b) af
                                         (course-to b) at)
                                   (out-ok "swap" 2)))
                             (out-err "NOTFOUND")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "rename")
             (if (= (length tokens) 3)
                 (let ((old (nth 1 tokens))
                       (new (nth 2 tokens)))
                   (if (and (valid-word-p old) (valid-word-p new))
                       (let ((c (find-course old)))
                         (if c
                             (if (find-course new)
                                 (out-err "DUP")
                                 (progn
                                   (setf (course-name c) new)
                                   (out-ok "rename" 1)))
                             (out-err "NOTFOUND")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "duplicate")
             (if (= (length tokens) 3)
                 (let ((name (nth 1 tokens))
                       (newname (nth 2 tokens)))
                   (if (and (valid-word-p name) (valid-word-p newname))
                       (let ((c (find-course name)))
                         (if c
                             (cond
                               ((find-course newname) (out-err "DUP"))
                               ((>= (length *courses*) 20) (out-err "LIMIT"))
                               (t (push (make-course :name newname
                                                     :teacher (course-teacher c)
                                                     :loc (course-loc c)
                                                     :day (course-day c)
                                                     :from (course-from c)
                                                     :to (course-to c))
                                        *courses*)
                                  (out-ok "duplicate" 1)))
                             (out-err "NOTFOUND")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "trim")
             (if (= (length tokens) 3)
                 (let ((day (parse-int (nth 1 tokens)))
                       (to (parse-int (nth 2 tokens))))
                   (if (and day to (<= 1 day 7) (<= 1 to 12))
                       (let ((n 0))
                         (dolist (c *courses*)
                           (when (and (= (course-day c) day)
                                      (<= (course-from c) to)
                                      (< to (course-to c)))
                             (setf (course-to c) to)
                             (incf n)))
                         (out-ok "trim" n))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "clear")
             (if (= (length tokens) 2)
                 (let ((day (parse-int (nth 1 tokens))))
                   (if (and day (<= 1 day 7))
                       (let ((n (count-if (lambda (c) (= (course-day c) day)) *courses*)))
                         (setf *courses* (remove-if (lambda (c) (= (course-day c) day)) *courses*))
                         (out-ok "clear" n))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "shift")
             (if (= (length tokens) 3)
                 (let ((day (parse-int (nth 1 tokens)))
                       (delta (parse-int (nth 2 tokens))))
                   (if (and day delta (<= 1 day 7))
                       (let ((newday (+ day delta)))
                         (if (<= 1 newday 7)
                             (let ((n 0))
                               (dolist (c *courses*)
                                 (when (= (course-day c) day)
                                   (setf (course-day c) newday)
                                   (incf n)))
                               (out-ok "shift" n))
                             (out-err "BADARG")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "copy")
             (if (= (length tokens) 3)
                 (let ((name (nth 1 tokens))
                       (day (parse-int (nth 2 tokens))))
                   (if (and (valid-word-p name) day (<= 1 day 7))
                       (let ((c (find-course name)))
                         (if c
                             (let ((newname (concatenate 'string name "_2")))
                               (cond
                                 ((> (length newname) 12) (out-err "BADARG"))
                                 ((find-course newname) (out-err "DUP"))
                                 ((>= (length *courses*) 20) (out-err "LIMIT"))
                                 (t (push (make-course :name newname
                                                       :teacher (course-teacher c)
                                                       :loc (course-loc c)
                                                       :day day
                                                       :from (course-from c)
                                                       :to (course-to c))
                                          *courses*)
                                    (out-ok "copy" 1))))
                             (out-err "NOTFOUND")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "merge")
             (if (= (length tokens) 3)
                 (let ((an (nth 1 tokens))
                       (bn (nth 2 tokens)))
                   (if (and (valid-word-p an) (valid-word-p bn))
                       (let ((a (find-course an))
                             (b (find-course bn)))
                         (if (and a b)
                             (progn
                               (setf (course-teacher a) (course-teacher b)
                                     (course-loc a) (course-loc b))
                               (setf *courses* (remove b *courses* :test #'eq))
                               (out-ok "merge" 2))
                             (out-err "NOTFOUND")))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "sort")
             (if (= (length tokens) 1)
                 (out-ok "sort" 0)
                 (out-err "BADARG")))
            ((string= verb "filter")
             (if (= (length tokens) 2)
                 (let ((day (parse-int (nth 1 tokens))))
                   (if (and day (<= 1 day 7))
                       (out-ok "filter"
                               (count-if (lambda (c) (= (course-day c) day)) *courses*))
                       (out-err "BADARG")))
                 (out-err "BADARG")))
            ((string= verb "count")
             (if (= (length tokens) 1)
                 (out-ok "count" (length *courses*))
                 (out-err "BADARG")))
            (t (out-err "BADARG")))))))

(defun command-arg-p (s)
  (let ((tokens (split-tokens s)))
    (and tokens
         (member (first tokens)
                 '("add" "del" "edit" "move" "swap" "rename" "duplicate"
                   "trim" "clear" "shift" "copy" "merge" "sort" "filter" "count")
                 :test #'string=))))

(defun main ()
  (dolist (arg (remove-if-not #'command-arg-p sb-ext:*posix-argv*))
    (exec-command arg))
  (format t "#state~%")
  (dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
    (format t "~a|~a|~a|~d|~d-~d~%"
            (course-name c)
            (course-teacher c)
            (course-loc c)
            (course-day c)
            (course-from c)
            (course-to c))))

(main)
