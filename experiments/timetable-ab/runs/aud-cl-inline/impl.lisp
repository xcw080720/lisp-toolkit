; v3 timetable ops executor -- inline style: one hand written branch per op.
; no macros, no dispatch table, single file, no file i/o, no json.

(defvar *courses* nil)

(defun script-token-p (s)
  (or (string-equal s "sbcl")
      (string-equal s "--script")
      (string-equal s "--noinform")
      (string-equal s "--disable-debugger")
      (let ((n (length s)))
        (and (>= n 5) (string-equal (subseq s (- n 5)) ".lisp")))))

(defun user-args ()
  (let ((args (cdr sb-ext:*posix-argv*)))
    (loop while (and args (script-token-p (first args)))
          do (setf args (rest args)))
    args))

(defun split-spaces (s)
  (let ((out '()) (cur '()) (n (length s)))
    (dotimes (i n)
      (let ((c (char s i)))
        (if (or (char= c #\Space) (char= c #\Tab))
            (when cur
              (push (coerce (nreverse cur) 'string) out)
              (setf cur nil))
            (push c cur))))
    (when cur
      (push (coerce (nreverse cur) 'string) out))
    (nreverse out)))

(defun to-int (s)
  (ignore-errors (parse-integer s)))

(defun int-range-p (x lo hi)
  (and (integerp x) (<= lo x) (<= x hi)))

(defun word-ok (s)
  (and (stringp s) (<= 1 (length s) 12)))

(defun find-course (name)
  (find name *courses* :key (lambda (c) (first c)) :test #'string=))

(defun conflicts-p (day from to except)
  (some (lambda (c)
          (and (not (eq c except))
               (= (fourth c) day)
               (<= from (sixth c))
               (<= (fifth c) to)))
        *courses*))

(defun run-command (line)
  (let* ((toks (split-spaces line))
         (verb (first toks))
         (r (rest toks)))
    (cond
      ((null verb) (format t "err BADARG~%"))

      ((string-equal verb "add")
       (if (/= (length r) 6)
           (format t "err BADARG~%")
           (let ((name (nth 0 r))
                 (teacher (nth 1 r))
                 (loc (nth 2 r))
                 (day (to-int (nth 3 r)))
                 (from (to-int (nth 4 r)))
                 (to (to-int (nth 5 r))))
             (cond
               ((not (and (word-ok name) (word-ok teacher) (word-ok loc)
                          (int-range-p day 1 7)
                          (int-range-p from 1 12)
                          (int-range-p to 1 12)
                          (<= from to)))
                (format t "err BADARG~%"))
               ((find-course name) (format t "err DUP~%"))
               ((conflicts-p day from to nil) (format t "err CONFLICT~%"))
               ((>= (length *courses*) 20) (format t "err LIMIT~%"))
               (t (push (list name teacher loc day from to) *courses*)
                  (format t "ok add 1~%"))))))

      ((string-equal verb "del")
       (if (/= (length r) 1)
           (format t "err BADARG~%")
           (let ((c (find-course (first r))))
             (cond
               ((null c) (format t "err NOTFOUND~%"))
               (t (setf *courses* (remove c *courses* :test #'eq))
                  (format t "ok del 1~%"))))))

      ((string-equal verb "edit")
       (if (/= (length r) 3)
           (format t "err BADARG~%")
           (let ((name (nth 0 r))
                 (teacher (nth 1 r))
                 (loc (nth 2 r)))
             (cond
               ((not (and (word-ok teacher) (word-ok loc)))
                (format t "err BADARG~%"))
               ((null (find-course name)) (format t "err NOTFOUND~%"))
               (t (let ((c (find-course name)))
                    (setf (second c) teacher)
                    (setf (third c) loc)
                    (format t "ok edit 1~%")))))))

      ((string-equal verb "move")
       (if (/= (length r) 4)
           (format t "err BADARG~%")
           (let ((name (nth 0 r))
                 (day (to-int (nth 1 r)))
                 (from (to-int (nth 2 r)))
                 (to (to-int (nth 3 r))))
             (cond
               ((not (and (int-range-p day 1 7)
                          (int-range-p from 1 12)
                          (int-range-p to 1 12)
                          (<= from to)))
                (format t "err BADARG~%"))
               ((null (find-course name)) (format t "err NOTFOUND~%"))
               ((conflicts-p day from to (find-course name))
                (format t "err CONFLICT~%"))
               (t (let ((c (find-course name)))
                    (setf (fourth c) day)
                    (setf (fifth c) from)
                    (setf (sixth c) to)
                    (format t "ok move 1~%")))))))

      ((string-equal verb "swap")
       (if (/= (length r) 2)
           (format t "err BADARG~%")
           (let ((ca (find-course (first r)))
                 (cb (find-course (second r))))
             (cond
               ((null ca) (format t "err NOTFOUND~%"))
               ((null cb) (format t "err NOTFOUND~%"))
               (t (let ((td (fourth ca)) (tf (fifth ca)) (tt (sixth ca)))
                    (setf (fourth ca) (fourth cb))
                    (setf (fifth ca) (fifth cb))
                    (setf (sixth ca) (sixth cb))
                    (setf (fourth cb) td)
                    (setf (fifth cb) tf)
                    (setf (sixth cb) tt))
                  (format t "ok swap 2~%"))))))

      ((string-equal verb "rename")
       (if (/= (length r) 2)
           (format t "err BADARG~%")
           (let ((old (first r)) (new (second r)))
             (cond
               ((not (word-ok new)) (format t "err BADARG~%"))
               ((null (find-course old)) (format t "err NOTFOUND~%"))
               (t (let ((ca (find-course old)) (cb (find-course new)))
                    (cond
                      ((and cb (not (eq ca cb))) (format t "err DUP~%"))
                      (t (setf (first ca) new)
                         (format t "ok rename 1~%")))))))))

      ((string-equal verb "duplicate")
       (if (/= (length r) 2)
           (format t "err BADARG~%")
           (let ((name (first r)) (newname (second r)))
             (cond
               ((not (word-ok newname)) (format t "err BADARG~%"))
               ((null (find-course name)) (format t "err NOTFOUND~%"))
               ((find-course newname) (format t "err DUP~%"))
               ((>= (length *courses*) 20) (format t "err LIMIT~%"))
               (t (let ((c (find-course name)))
                    (push (list newname (second c) (third c)
                                (fourth c) (fifth c) (sixth c))
                          *courses*)
                    (format t "ok duplicate 1~%")))))))

      ((string-equal verb "trim")
       (if (/= (length r) 2)
           (format t "err BADARG~%")
           (let ((day (to-int (first r))) (to (to-int (second r))))
             (if (not (and (int-range-p day 1 7) (int-range-p to 1 12)))
                 (format t "err BADARG~%")
                 (let ((n 0))
                   (dolist (c *courses*)
                     (when (and (= (fourth c) day)
                                (<= (fifth c) to)
                                (< to (sixth c)))
                       (setf (sixth c) to)
                       (incf n)))
                   (format t "ok trim ~a~%" n))))))

      ((string-equal verb "clear")
       (if (/= (length r) 1)
           (format t "err BADARG~%")
           (let ((day (to-int (first r))))
             (if (not (int-range-p day 1 7))
                 (format t "err BADARG~%")
                 (let ((n 0))
                   (dolist (c *courses*)
                     (when (= (fourth c) day)
                       (incf n)))
                   (setf *courses*
                         (remove-if (lambda (c) (= (fourth c) day)) *courses*))
                   (format t "ok clear ~a~%" n))))))

      ((string-equal verb "shift")
       (if (/= (length r) 2)
           (format t "err BADARG~%")
           (let ((day (to-int (first r))) (delta (to-int (second r))))
             (if (not (and (int-range-p day 1 7)
                           (integerp delta)
                           (int-range-p (+ day delta) 1 7)))
                 (format t "err BADARG~%")
                 (let ((n 0))
                   (dolist (c *courses*)
                     (when (= (fourth c) day)
                       (setf (fourth c) (+ day delta))
                       (incf n)))
                   (format t "ok shift ~a~%" n))))))

      ((string-equal verb "copy")
       (if (/= (length r) 2)
           (format t "err BADARG~%")
           (let ((name (first r)) (day (to-int (second r))))
             (cond
               ((not (int-range-p day 1 7)) (format t "err BADARG~%"))
               ((null (find-course name)) (format t "err NOTFOUND~%"))
               (t (let* ((c (find-course name))
                         (newname (concatenate 'string name "_2")))
                    (cond
                      ((find-course newname) (format t "err DUP~%"))
                      ((>= (length *courses*) 20) (format t "err LIMIT~%"))
                      (t (push (list newname (second c) (third c)
                                     day (fifth c) (sixth c))
                               *courses*)
                         (format t "ok copy 1~%")))))))))

      ((string-equal verb "merge")
       (if (/= (length r) 2)
           (format t "err BADARG~%")
           (let ((ca (find-course (first r)))
                 (cb (find-course (second r))))
             (cond
               ((null ca) (format t "err NOTFOUND~%"))
               ((null cb) (format t "err NOTFOUND~%"))
               (t (setf (second ca) (second cb))
                  (setf (third ca) (third cb))
                  (setf *courses* (remove cb *courses* :test #'eq))
                  (format t "ok merge 2~%"))))))

      ((string-equal verb "sort")
       (if (not (null r))
           (format t "err BADARG~%")
           (format t "ok sort 0~%")))

      ((string-equal verb "filter")
       (if (/= (length r) 1)
           (format t "err BADARG~%")
           (let ((day (to-int (first r))))
             (if (not (int-range-p day 1 7))
                 (format t "err BADARG~%")
                 (let ((n 0))
                   (dolist (c *courses*)
                     (when (= (fourth c) day)
                       (incf n)))
                   (format t "ok filter ~a~%" n))))))

      ((string-equal verb "count")
       (if (not (null r))
           (format t "err BADARG~%")
           (format t "ok count ~a~%" (length *courses*))))

      (t (format t "err BADARG~%")))))

(dolist (line (user-args))
  (run-command line))

(format t "#state~%")

(dolist (c (sort (copy-list *courses*) #'string< :key (lambda (c) (first c))))
  (format t "~a|~a|~a|~a|~a-~a~%"
          (first c) (second c) (third c) (fourth c) (fifth c) (sixth c)))
