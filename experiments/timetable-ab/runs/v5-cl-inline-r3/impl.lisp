(defvar *courses* nil)

(defstruct course name teacher loc day from to)

(defun split-command (s)
  (let ((tokens '())
        (start 0)
        (len (length s)))
    (loop for i from 0 to len
          do (when (or (= i len)
                       (member (char s i) '(#\Space #\Tab)))
               (when (> i start)
                 (push (subseq s start i) tokens))
               (setf start (1+ i))))
    (nreverse tokens)))

(defun parse-int (s)
  (handler-case
      (multiple-value-bind (v pos)
          (parse-integer s :junk-allowed nil)
        (declare (ignore pos))
        v)
    (error () nil)))

(defun valid-word-p (s)
  (and (stringp s)
       (<= 1 (length s) 12)))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun conflict-p (day from to &optional exclude)
  (loop for c in *courses*
        unless (eq c exclude)
        when (and (= (course-day c) day)
                  (<= from (course-to c))
                  (<= (course-from c) to))
          return t))

(defun fail (code)
  (format t "err ~a~%" code))

(defun ok (verb n)
  (format t "ok ~a ~d~%" verb n))

(defun run-command (command)
  (let* ((tokens (split-command command))
         (verb (and tokens (string-downcase (first tokens)))))
    (cond
      ((null tokens) (fail "BADARG"))
      ((string= verb "add")
       (if (/= (length tokens) 7)
           (fail "BADARG")
           (let ((name (nth 1 tokens))
                 (teacher (nth 2 tokens))
                 (loc (nth 3 tokens))
                 (day (parse-int (nth 4 tokens)))
                 (from (parse-int (nth 5 tokens)))
                 (to (parse-int (nth 6 tokens))))
             (if (and (valid-word-p name)
                      (valid-word-p teacher)
                      (valid-word-p loc)
                      day (<= 1 day 7)
                      from (<= 1 from 12)
                      to (<= 1 to 12)
                      (<= from to))
                 (cond
                   ((find-course name) (fail "DUP"))
                   ((>= (length *courses*) 20) (fail "LIMIT"))
                   ((conflict-p day from to) (fail "CONFLICT"))
                   (t (push (make-course :name name :teacher teacher :loc loc
                                         :day day :from from :to to)
                            *courses*)
                      (ok "add" 1)))
                 (fail "BADARG")))))
      ((string= verb "del")
       (if (/= (length tokens) 2)
           (fail "BADARG")
           (let ((name (nth 1 tokens)))
             (if (not (valid-word-p name))
                 (fail "BADARG")
                 (let ((c (find-course name)))
                   (if (null c)
                       (fail "NOTFOUND")
                       (progn
                         (setf *courses* (remove c *courses* :test #'eq))
                         (ok "del" 1))))))))
      ((string= verb "edit")
       (if (/= (length tokens) 4)
           (fail "BADARG")
           (let ((name (nth 1 tokens))
                 (teacher (nth 2 tokens))
                 (loc (nth 3 tokens)))
             (if (not (and (valid-word-p name)
                           (valid-word-p teacher)
                           (valid-word-p loc)))
                 (fail "BADARG")
                 (let ((c (find-course name)))
                   (if (null c)
                       (fail "NOTFOUND")
                       (progn
                         (setf (course-teacher c) teacher
                               (course-loc c) loc)
                         (ok "edit" 1))))))))
      ((string= verb "move")
       (if (/= (length tokens) 5)
           (fail "BADARG")
           (let ((name (nth 1 tokens))
                 (day (parse-int (nth 2 tokens)))
                 (from (parse-int (nth 3 tokens)))
                 (to (parse-int (nth 4 tokens))))
             (if (not (and (valid-word-p name)
                           day (<= 1 day 7)
                           from (<= 1 from 12)
                           to (<= 1 to 12)
                           (<= from to)))
                 (fail "BADARG")
                 (let ((c (find-course name)))
                   (if (null c)
                       (fail "NOTFOUND")
                       (if (conflict-p day from to c)
                           (fail "CONFLICT")
                           (progn
                             (setf (course-day c) day
                                   (course-from c) from
                                   (course-to c) to)
                             (ok "move" 1)))))))))
      ((string= verb "swap")
       (if (/= (length tokens) 3)
           (fail "BADARG")
           (let ((n1 (nth 1 tokens))
                 (n2 (nth 2 tokens)))
             (if (not (and (valid-word-p n1)
                           (valid-word-p n2)))
                 (fail "BADARG")
                 (let ((a (find-course n1))
                       (b (find-course n2)))
                   (if (or (null a) (null b))
                       (fail "NOTFOUND")
                       (let ((ad (course-day a))
                             (af (course-from a))
                             (at (course-to a))
                             (bd (course-day b))
                             (bf (course-from b))
                             (bt (course-to b)))
                         (setf (course-day a) bd
                               (course-from a) bf
                               (course-to a) bt
                               (course-day b) ad
                               (course-from b) af
                               (course-to b) at)
                         (ok "swap" 2))))))))
      ((string= verb "rename")
       (if (/= (length tokens) 3)
           (fail "BADARG")
           (let ((old (nth 1 tokens))
                 (new (nth 2 tokens)))
             (if (not (and (valid-word-p old)
                           (valid-word-p new)))
                 (fail "BADARG")
                 (let ((c (find-course old)))
                   (if (null c)
                       (fail "NOTFOUND")
                       (if (find-course new)
                           (fail "DUP")
                           (progn
                             (setf (course-name c) new)
                             (ok "rename" 1)))))))))
      ((string= verb "duplicate")
       (if (/= (length tokens) 3)
           (fail "BADARG")
           (let ((name (nth 1 tokens))
                 (newname (nth 2 tokens)))
             (if (not (and (valid-word-p name)
                           (valid-word-p newname)))
                 (fail "BADARG")
                 (let ((c (find-course name)))
                   (if (null c)
                       (fail "NOTFOUND")
                       (if (find-course newname)
                           (fail "DUP")
                           (if (>= (length *courses*) 20)
                               (fail "LIMIT")
                               (progn
                                 (push (make-course :name newname
                                                    :teacher (course-teacher c)
                                                    :loc (course-loc c)
                                                    :day (course-day c)
                                                    :from (course-from c)
                                                    :to (course-to c))
                                       *courses*)
                                 (ok "duplicate" 1))))))))))
      ((string= verb "trim")
       (if (/= (length tokens) 3)
           (fail "BADARG")
           (let ((day (parse-int (nth 1 tokens)))
                 (to (parse-int (nth 2 tokens))))
             (if (not (and day (<= 1 day 7)
                           to (<= 1 to 12)))
                 (fail "BADARG")
                 (let ((count 0))
                   (dolist (c *courses*)
                     (when (and (= (course-day c) day)
                                (<= (course-from c) to)
                                (< to (course-to c)))
                       (setf (course-to c) to)
                       (incf count)))
                   (ok "trim" count))))))
      ((string= verb "clear")
       (if (/= (length tokens) 2)
           (fail "BADARG")
           (let ((day (parse-int (nth 1 tokens))))
             (if (not (and day (<= 1 day 7)))
                 (fail "BADARG")
                 (let ((before (length *courses*)))
                   (setf *courses*
                         (remove-if (lambda (c) (= (course-day c) day))
                                    *courses*))
                   (ok "clear" (- before (length *courses*))))))))
      ((string= verb "shift")
       (if (/= (length tokens) 3)
           (fail "BADARG")
           (let ((day (parse-int (nth 1 tokens)))
                 (delta (parse-int (nth 2 tokens))))
             (if (not (and day (<= 1 day 7) delta))
                 (fail "BADARG")
                 (let ((newday (+ day delta)))
                   (if (or (< newday 1) (> newday 7))
                       (fail "BADARG")
                       (let ((count 0))
                         (dolist (c *courses*)
                           (when (= (course-day c) day)
                             (setf (course-day c) newday)
                             (incf count)))
                         (ok "shift" count))))))))
      ((string= verb "copy")
       (if (/= (length tokens) 3)
           (fail "BADARG")
           (let ((name (nth 1 tokens))
                 (day (parse-int (nth 2 tokens))))
             (if (not (and (valid-word-p name)
                           day (<= 1 day 7)))
                 (fail "BADARG")
                 (let ((c (find-course name)))
                   (if (null c)
                       (fail "NOTFOUND")
                       (let ((newname (concatenate 'string (course-name c) "_2")))
                         (if (not (valid-word-p newname))
                             (fail "BADARG")
                             (if (find-course newname)
                                 (fail "DUP")
                                 (if (>= (length *courses*) 20)
                                     (fail "LIMIT")
                                     (progn
                                       (push (make-course :name newname
                                                          :teacher (course-teacher c)
                                                          :loc (course-loc c)
                                                          :day day
                                                          :from (course-from c)
                                                          :to (course-to c))
                                             *courses*)
                                       (ok "copy" 1))))))))))))
      ((string= verb "merge")
       (if (/= (length tokens) 3)
           (fail "BADARG")
           (let ((n1 (nth 1 tokens))
                 (n2 (nth 2 tokens)))
             (if (not (and (valid-word-p n1)
                           (valid-word-p n2)))
                 (fail "BADARG")
                 (let ((a (find-course n1))
                       (b (find-course n2)))
                   (if (or (null a) (null b))
                       (fail "NOTFOUND")
                       (progn
                         (setf (course-teacher a) (course-teacher b)
                               (course-loc a) (course-loc b))
                         (setf *courses* (remove b *courses* :test #'eq))
                         (ok "merge" 2))))))))
      ((string= verb "sort")
       (if (/= (length tokens) 1)
           (fail "BADARG")
           (ok "sort" 0)))
      ((string= verb "filter")
       (if (/= (length tokens) 2)
           (fail "BADARG")
           (let ((day (parse-int (nth 1 tokens))))
             (if (not (and day (<= 1 day 7)))
                 (fail "BADARG")
                 (let ((count 0))
                   (dolist (c *courses*)
                     (when (= (course-day c) day)
                       (incf count)))
                   (ok "filter" count))))))
      ((string= verb "count")
       (if (/= (length tokens) 1)
           (fail "BADARG")
           (ok "count" (length *courses*))))
      (t (fail "BADARG")))))

(defun extract-commands (argv)
  (let ((verbs '("add" "del" "edit" "move" "swap" "rename" "duplicate" "trim"
                 "clear" "shift" "copy" "merge" "sort" "filter" "count")))
    (loop for tail on argv
          for arg = (car tail)
          for tokens = (split-command arg)
          when (and tokens (member (first tokens) verbs :test #'string-equal))
            return tail
          finally (return nil))))

(let ((commands (extract-commands sb-ext:*posix-argv*)))
  (dolist (cmd commands)
    (run-command cmd)))
(format t "#state~%")
(dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
  (format t "~a|~a|~a|~d|~d-~d~%"
          (course-name c)
          (course-teacher c)
          (course-loc c)
          (course-day c)
          (course-from c)
          (course-to c)))
