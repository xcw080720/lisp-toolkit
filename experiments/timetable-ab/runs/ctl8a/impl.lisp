;;;; impl.lisp —— 课表 ops 执行器（add / del / edit / move / swap）
;;;; 边界契约：JSON 标签只在 jparse / jw 两处出现；
;;;; 业务层只看到裸 alist（对象）、vector（数组）、标量。
;;;; 三个"空"的表达：null = nil，空数组 = #()，空对象 = nil（weeks {} 一律回落默认）。

;;; ========== JSON 读 ==========
(declaim (ftype function jval))

(defun jws (s i)
  (let ((n (length s)))
    (loop while (and (< i n) (member (char s i) '(#\Space #\Tab #\Newline #\Return)))
          do (incf i))
    i))

(defun ju (s i out)
  (let ((cp (parse-integer s :start i :end (+ i 4) :radix 16)))
    (incf i 4)
    (if (and (<= #xd800 cp) (<= cp #xdbff) (<= (+ i 6) (length s))
             (char= (char s i) #\\) (char= (char s (1+ i)) #\u))
        (let ((lo (parse-integer s :start (+ i 2) :end (+ i 6) :radix 16)))
          (write-char (code-char (+ #x10000 (* (- cp #xd800) #x400) (- lo #xdc00))) out)
          (+ i 6))
        (progn (write-char (code-char cp) out) i))))

(defun jesc (s i out)
  (let ((e (char s i)))
    (incf i)
    (case e
      (#\" (write-char #\" out))
      (#\\ (write-char #\\ out))
      (#\/ (write-char #\/ out))
      (#\b (write-char #\Backspace out))
      (#\f (write-char #\Page out))
      (#\n (write-char #\Newline out))
      (#\r (write-char #\Return out))
      (#\t (write-char #\Tab out))
      (#\u (setf i (ju s i out)))
      (t (write-char e out)))
    i))

(defun jstr (s i)
  (let ((out (make-string-output-stream)))
    (loop
      (let ((c (char s i)))
        (incf i)
        (cond ((char= c #\") (return))
              ((char= c #\\) (setf i (jesc s i out)))
              (t (write-char c out)))))
    (values (get-output-stream-string out) i)))

(defun jnum (s i)
  (let ((j i) (n (length s)))
    (loop while (and (< j n) (find (char s j) "+-0123456789.eE")) do (incf j))
    (let ((tok (subseq s i j)))
      (values (if (or (find #\. tok) (find #\e tok) (find #\E tok))
                  (let ((*read-default-float-format* 'single-float)) (read-from-string tok))
                  (parse-integer tok))
              j))))

(defun jobj (s i)
  (let ((acc '()))
    (setf i (jws s i))
    (if (char= (char s i) #\})
        (values :empty-obj (1+ i))
        (loop
          (setf i (jws s i))
          (let (k v)
            (multiple-value-setq (k i) (jstr s (1+ i)))
            (setf i (1+ (jws s i)))
            (multiple-value-setq (v i) (jval s i))
            (push (cons k v) acc)
            (setf i (jws s i))
            (if (char= (char s i) #\,)
                (incf i)
                (return (values (nreverse acc) (1+ i)))))))))

(defun jarr (s i)
  (let ((acc '()))
    (setf i (jws s i))
    (if (char= (char s i) #\])
        (values (coerce acc 'vector) (1+ i))
        (loop
          (multiple-value-bind (v ni) (jval s i)
            (setf i ni)
            (push v acc)
            (setf i (jws s i))
            (if (char= (char s i) #\,)
                (incf i)
                (return (values (coerce (nreverse acc) 'vector) (1+ i)))))))))

(defun jval (s i)
  (setf i (jws s i))
  (let ((c (char s i)))
    (cond ((char= c #\{) (jobj s (1+ i)))
          ((char= c #\[) (jarr s (1+ i)))
          ((char= c #\") (jstr s (1+ i)))
          ((char= c #\t) (values t (+ i 4)))
          ((char= c #\f) (values nil (+ i 5)))
          ((char= c #\n) (values nil (+ i 4)))
          (t (jnum s i)))))

(defun jparse (s) (jval s 0))

;;; ========== JSON 写 ==========
(defun jwstr (s)
  (write-char #\")
  (loop for c across s
        do (case c
             (#\" (write-string "\\\""))
             (#\\ (write-string "\\\\"))
             (#\Newline (write-string "\\n"))
             (#\Return (write-string "\\r"))
             (#\Tab (write-string "\\t"))
             (t (if (< (char-code c) 32)
                    (format t "\\u~4,'0x" (char-code c))
                    (write-char c)))))
  (write-char #\"))

(defun jw (v)
  (cond ((eq v :empty-obj) (write-string "{}"))
        ((null v) (write-string "null"))
        ((stringp v) (jwstr v))
        ((vectorp v)
         (write-char #\[)
         (loop for x across v for first = t then nil
               do (unless first (write-char #\,)) (jw x))
         (write-char #\]))
        ((integerp v) (format t "~d" v))
        ((floatp v) (write-string (let ((*read-default-float-format* 'single-float))
                                    (princ-to-string (coerce v 'single-float)))))
        ((consp v)
         (write-char #\{)
         (loop for p in v for first = t then nil
               do (unless first (write-char #\,))
                  (jwstr (car p)) (write-char #\:) (jw (cdr p)))
         (write-char #\}))
        (t (format t "~a" v))))

;;; ========== 业务层：裸 alist ==========
(defun cget (al k)
  (if (consp al) (let ((p (assoc k al :test #'equal))) (and p (cdr p))) nil))

(defun set-fld (al k v)
  (let ((p (assoc k al :test #'equal)))
    (if p (setf (cdr p) v) (nconc al (list (cons k v)))))
  v)

(defun pint (v d)
  (cond ((integerp v) v) ((floatp v) (round v)) (t d)))

(defun clamp-day (v d)
  (let ((i (pint v d)))
    (cond ((< i 1) 1) ((> i 7) 7) (t i))))

(defun name-of (c) (let ((x (cget c "name"))) (if (stringp x) x "")))

(defun hitp (c m) (and (stringp m) (search m (name-of c)) t))

(defun default-weeks () '(("type" . "range") ("from" . 1) ("to" . 16)))

(defun norm-weeks (w)
  (if (and (consp w) (stringp (cget w "type"))) w (default-weeks)))

(defun norm-course (c)
  (let* ((pf (max 1 (pint (cget c "periodFrom") 1)))
         (pt (max pf (max 1 (pint (cget c "periodTo") pf))))
         (tg (cget c "tag")))
    (list (cons "name" (or (cget c "name") ""))
          (cons "teacher" (or (cget c "teacher") ""))
          (cons "location" (or (cget c "location") ""))
          (cons "day" (clamp-day (cget c "day") 1))
          (cons "periodFrom" pf)
          (cons "periodTo" pt)
          (cons "weeks" (norm-weeks (cget c "weeks")))
          (cons "tag" (if (stringp tg) tg nil)))))

(defstruct st courses)

;;; ========== 五个 op：每个只写「自己的语义」，计数与文案一起返回 ==========
(defun op-add (st op)
  (let ((c (norm-course (cget op "course"))))
    (setf (st-courses st) (append (st-courses st) (list c)))
    (values 1 (format nil "加「~a」" (name-of c)))))

(defun op-del (st op)
  (let* ((m (cget op "match"))
         (cs (st-courses st))
         (kept (remove-if (lambda (c) (hitp c m)) cs))
         (k (- (length cs) (length kept))))
    (setf (st-courses st) kept)
    (values k (if (zerop k)
                  (format nil "删除「~a」：没找到" m)
                  (format nil "删了 ~d 门" k)))))

(defun op-edit (st op)
  (let ((m (cget op "match")) (set (cget op "set")) (k 0))
    (dolist (c (st-courses st))
      (when (hitp c m)
        (incf k)
        (dolist (p (if (listp set) set '()))
          (let ((key (car p)) (val (cdr p)))
            (cond ((equal key "day") (set-fld c key (clamp-day val 1)))
                  ((equal key "periodFrom")
                   (let ((v (max 1 (pint val 1))))
                     (set-fld c key v)
                     (when (< (pint (cget c "periodTo") v) v) (set-fld c "periodTo" v))))
                  ((equal key "periodTo")
                   (set-fld c key (max (pint val 1) (pint (cget c "periodFrom") 1))))
                  (t (set-fld c key val)))))))
    (values k (format nil "改 ~d 门" k))))

(defun op-move (st op)
  (let ((m (cget op "match")) (d (cget op "day"))
        (a (cget op "periodFrom")) (b (cget op "periodTo")))
    (if (and m d a b)
        (let* ((dd (clamp-day d 1)) (pf (max 1 (pint a 1))) (pt (max pf (max 1 (pint b 1)))) (k 0))
          (dolist (c (st-courses st))
            (when (hitp c m)
              (incf k)
              (set-fld c "day" dd)
              (set-fld c "periodFrom" pf)
              (set-fld c "periodTo" pt)))
          (values k (format nil "移动 ~d 门到周~d 第~d-~d节" k dd pf pt)))
        (values 0 "移动：缺 day/periodFrom/periodTo，未执行"))))

(defun op-swap (st op)
  (let* ((m (cget op "match")) (w (cget op "with"))
         (as (remove-if-not (lambda (c) (hitp c m)) (st-courses st)))
         (bs (remove-if-not (lambda (c) (hitp c w)) (st-courses st))))
    (if (and (= (length as) 1) (= (length bs) 1) (not (eq (car as) (car bs))))
        (let ((x (car as)) (y (car bs)))
          (dolist (k '("day" "periodFrom" "periodTo"))
            (let ((vx (cget x k)))
              (set-fld x k (cget y k))
              (set-fld y k vx)))
          (values 2 (format nil "交换「~a」与「~a」" (name-of x) (name-of y))))
        (values 0 "交换：两侧须各命中恰好 1 门，未执行"))))

;;; ========== 分发与收尾 ==========
(defparameter *ops* '("add" "del" "edit" "move" "swap"))

(defun known-op (k) (and (stringp k) (member k *ops* :test #'equal)))

(defun run-op (st op)
  (let ((k (cget op "op")))
    (cond ((equal k "add") (op-add st op))
          ((equal k "del") (op-del st op))
          ((equal k "edit") (op-edit st op))
          ((equal k "move") (op-move st op))
          ((equal k "swap") (op-swap st op))
          (t (values 0 (format nil "跳过 ~a" k))))))

(defun emit (text courses log n)
  (jw (list (cons "opsText" text)
            (cons "courses" courses)
            (cons "log" log)
            (cons "n" n)))
  (terpri))

(defun slurp (path)
  (with-open-file (in path :external-format :utf-8)
    (let ((out (make-string-output-stream)))
      (loop for ch = (read-char in nil nil) while ch do (write-char ch out))
      (get-output-stream-string out))))

(defun main ()
  (let* ((path (car (last sb-ext:*posix-argv*)))
         (doc (jparse (slurp path)))
         (raw (let ((c (cget doc "courses"))) (if (vectorp c) c #())))
         (ops (let ((o (cget doc "ops"))) (if (vectorp o) (coerce o 'list) '())))
         (bad (loop for o in ops
                    unless (known-op (cget o "op")) collect (cget o "op"))))
    (if bad
        (emit "" raw (vector (format nil "1) 拒绝：未知 op ~a" (car bad))) 0)
        (let ((st (make-st :courses (mapcar #'norm-course (coerce raw 'list))))
              (lines '()) (texts '()) (n 0) (i 0))
          (dolist (op ops)
            (multiple-value-bind (k txt) (run-op st op)
              (incf n k)
              (incf i)
              (push (format nil "~d) ~a" i txt) lines)
              (push txt texts)))
          (emit (format nil "~{~a~^; ~}" (reverse texts))
                (coerce (st-courses st) 'vector)
                (coerce (reverse lines) 'vector)
                n)))))

(main)
