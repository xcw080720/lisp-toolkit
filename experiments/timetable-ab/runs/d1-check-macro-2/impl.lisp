;;;; v3 timetable ops executor -- macro style.
;;;; 30 ops, one defop form each; arity check, registry, dispatch and the
;;;; ok/err line are all generated by the macro. Global --dry prefix.

(in-package :cl-user)

;;; ---------------------------------------------------------------- model

(defstruct (course (:conc-name crs-))
  name teacher loc day from to)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defvar *courses* '()
    "The timetable: a list of COURSE structures.")
  (defvar *registry* '()
    "Compile-time registry of (key display-name handler) lists, in defop order."))

;;; ---------------------------------------------------------------- helpers

(defun word-p (s)
  "A name/teacher/loc token: 1-12 printable ASCII chars, no blanks."
  (and (stringp s)
       (<= 1 (length s) 12)
       (every (lambda (ch) (<= 33 (char-code ch) 126)) s)))

(defun num (s lo hi)
  "Unsigned decimal integer in [lo,hi], else NIL."
  (when (and (stringp s) (plusp (length s)) (every #'digit-char-p s))
    (let ((n (parse-integer s)))
      (when (and (<= lo n) (<= n hi)) n))))

(defun int-token (s)
  "Signed decimal integer, else NIL."
  (when (and (stringp s) (plusp (length s)))
    (let* ((neg (char= (char s 0) #\-))
           (body (if neg (subseq s 1) s)))
      (when (and (plusp (length body)) (every #'digit-char-p body))
        (let ((n (parse-integer body)))
          (if neg (- n) n))))))

(defun split-words (s)
  "Split a command string on spaces/tabs; empty fields are dropped."
  (let ((out '()) (start nil) (len (length s)))
    (dotimes (i len)
      (let ((ch (char s i)))
        (if (or (char= ch #\Space) (char= ch #\Tab))
            (when start (push (subseq s start i) out) (setf start nil))
            (unless start (setf start i)))))
    (when start (push (subseq s start) out))
    (nreverse out)))

(defun find-course (name)
  (find name *courses* :key #'crs-name :test #'string=))

(defun course-on-day (day)
  (remove-if-not (lambda (c) (= (crs-day c) day)) *courses*))

(defun hits-time-p (day from to &optional except)
  "True when [from,to] on DAY overlaps a course other than EXCEPT.
   Touching endpoints count as overlap."
  (some (lambda (c)
          (and (not (eq c except))
               (= (crs-day c) day)
               (<= from (crs-to c))
               (<= (crs-from c) to)))
        *courses*))

(defun count-on-day (day)
  (count-if (lambda (c) (= (crs-day c) day)) *courses*))

(defun compress-day (day)
  "Rewrite DAY's courses as (1,2),(2,3),... in ascending FROM order."
  (let ((k 0) (n 0))
    (dolist (c (sort (course-on-day day) #'< :key #'crs-from))
      (incf k)
      (let ((of (crs-from c)) (ot (crs-to c)))
        (setf (crs-from c) k (crs-to c) (1+ k))
        (unless (and (= of k) (= ot (1+ k))) (incf n))))
    n))

;;; ---------------------------------------------------------------- the op macro

(defmacro fail (code)
  `(return-from op (values :err ,code)))

(defmacro defop (name arity &body body)
  "One form declares one op: handler, arity validation, registry entry.
   The dispatch table and the output line are derived from the registry.
   Bad declarations are rejected at expansion time, not at run time."
  (let* ((op-name (string-downcase (string name)))
         (fn (intern (concatenate 'string "OP-" (string-upcase op-name)) :cl-user)))
    (unless (and (stringp name) (plusp (length name)) (not (find #\Space name)))
      (error "defop: bad op name ~s" name))
    (unless (and (integerp arity) (<= 0 arity))
      (error "defop: bad arity ~s for ~s" arity name))
    (unless body
      (error "defop: empty body for ~s" name))
    (when (assoc op-name *registry* :test #'string=)
      (error "defop: duplicate op name ~s" name))
    `(eval-when (:compile-toplevel :load-toplevel :execute)
       (defun ,fn (args)
         (block op
           (unless (= (length args) ,arity)
             (return-from op (values :err "BADARG")))
           (values :ok (progn ,@body))))
       (setf *registry*
             (append (remove ,op-name *registry* :key #'car :test #'string=)
                     (list (list ,op-name ,name ',fn)))))))

(defmacro define-dispatch (fn-name)
  "Expand the registry into a compiled dispatch table over verbose names."
  `(defun ,fn-name (verb args)
     (cond
       ,@(loop for (nm show f) in *registry*
               collect `((string-equal verb ,nm)
                         (multiple-value-bind (kind payload) (,f args)
                           (values kind payload ,show))))
       (t (values :err "BADARG" nil)))))

;;; ---------------------------------------------------------------- base ops 1-15

(defop "add" 6
  (destructuring-bind (name teacher loc ds fs ts) args
    (let ((day (num ds 1 7)) (from (num fs 1 12)) (to (num ts 1 12)))
      (unless (and (word-p name) (word-p teacher) (word-p loc)
                   day from to (<= from to))
        (fail "BADARG"))
      (when (find-course name) (fail "DUP"))
      (when (>= (length *courses*) 20) (fail "LIMIT"))
      (when (hits-time-p day from to) (fail "CONFLICT"))
      (push (make-course :name name :teacher teacher :loc loc
                         :day day :from from :to to)
            *courses*)
      1)))

(defop "del" 1
  (let ((c (find-course (first args))))
    (unless c (fail "NOTFOUND"))
    (setf *courses* (remove c *courses* :test #'eq))
    1))

(defop "edit" 3
  (destructuring-bind (name teacher loc) args
    (let ((c (find-course name)))
      (unless (and (word-p teacher) (word-p loc)) (fail "BADARG"))
      (unless c (fail "NOTFOUND"))
      (setf (crs-teacher c) teacher (crs-loc c) loc)
      1)))

(defop "move" 4
  (destructuring-bind (name ds fs ts) args
    (let ((day (num ds 1 7)) (from (num fs 1 12)) (to (num ts 1 12))
          (c (find-course name)))
      (unless (and day from to (<= from to)) (fail "BADARG"))
      (unless c (fail "NOTFOUND"))
      (when (hits-time-p day from to c) (fail "CONFLICT"))
      (setf (crs-day c) day (crs-from c) from (crs-to c) to)
      1)))

(defop "swap" 2
  (destructuring-bind (na nb) args
    (let ((a (find-course na)) (b (find-course nb)))
      (unless a (fail "NOTFOUND"))
      (unless b (fail "NOTFOUND"))
      (unless (eq a b)
        (rotatef (crs-day a) (crs-day b))
        (rotatef (crs-from a) (crs-from b))
        (rotatef (crs-to a) (crs-to b)))
      2)))

(defop "rename" 2
  (destructuring-bind (old new) args
    (let ((c (find-course old)))
      (unless (word-p new) (fail "BADARG"))
      (unless c (fail "NOTFOUND"))
      (when (find-course new) (fail "DUP"))
      (setf (crs-name c) new)
      1)))

(defop "duplicate" 2
  (destructuring-bind (name newname) args
    (let ((c (find-course name)))
      (unless (word-p newname) (fail "BADARG"))
      (unless c (fail "NOTFOUND"))
      (when (find-course newname) (fail "DUP"))
      (let ((nc (copy-course c)))
        (setf (crs-name nc) newname)
        (push nc *courses*))
      1)))

(defop "trim" 2
  (destructuring-bind (ds ts) args
    (let ((day (num ds 1 7)) (to (num ts 1 12)) (n 0))
      (unless (and day to) (fail "BADARG"))
      (dolist (c *courses*)
        (when (and (= (crs-day c) day) (<= (crs-from c) to) (< to (crs-to c)))
          (setf (crs-to c) to)
          (incf n)))
      n)))

(defop "clear" 1
  (let ((day (num (first args) 1 7)))
    (unless day (fail "BADARG"))
    (let ((before (length *courses*)))
      (setf *courses* (remove-if (lambda (c) (= (crs-day c) day)) *courses*))
      (- before (length *courses*)))))

(defop "shift" 2
  (destructuring-bind (ds dd) args
    (let* ((day (num ds 1 7)) (delta (int-token dd)))
      (unless (and day delta) (fail "BADARG"))
      (let ((target (+ day delta)))
        (unless (<= 1 target 7) (fail "BADARG"))
        (let ((n 0))
          (dolist (c *courses*)
            (when (= (crs-day c) day)
              (setf (crs-day c) target)
              (incf n)))
          n)))))

(defop "copy" 2
  (destructuring-bind (name ds) args
    (let ((day (num ds 1 7)) (c (find-course name)))
      (unless day (fail "BADARG"))
      (unless c (fail "NOTFOUND"))
      (let ((nn (concatenate 'string (crs-name c) "_2")))
        (when (find-course nn) (fail "DUP"))
        (when (hits-time-p day (crs-from c) (crs-to c)) (fail "CONFLICT"))
        (let ((nc (copy-course c)))
          (setf (crs-name nc) nn (crs-day nc) day)
          (push nc *courses*))
        1))))

(defop "merge" 2
  (destructuring-bind (na nb) args
    (let ((a (find-course na)) (b (find-course nb)))
      (unless a (fail "NOTFOUND"))
      (unless b (fail "NOTFOUND"))
      (unless (eq a b)
        (setf (crs-teacher a) (crs-teacher b) (crs-loc a) (crs-loc b))
        (setf *courses* (remove b *courses* :test #'eq)))
      2)))

(defop "sort" 0
  (setf *courses* (sort *courses* #'string< :key #'crs-name))
  0)

(defop "filter" 1
  (let ((day (num (first args) 1 7)))
    (unless day (fail "BADARG"))
    (count-on-day day)))

(defop "count" 0
  (length *courses*))

;;; ---------------------------------------------------------------- ops 16-30

(defop "swapTeacher" 2
  (destructuring-bind (na nb) args
    (let ((a (find-course na)) (b (find-course nb)))
      (unless a (fail "NOTFOUND"))
      (unless b (fail "NOTFOUND"))
      (unless (eq a b) (rotatef (crs-teacher a) (crs-teacher b)))
      2)))

(defop "swapLoc" 2
  (destructuring-bind (na nb) args
    (let ((a (find-course na)) (b (find-course nb)))
      (unless a (fail "NOTFOUND"))
      (unless b (fail "NOTFOUND"))
      (unless (eq a b) (rotatef (crs-loc a) (crs-loc b)))
      2)))

(defop "copyTo" 4
  (destructuring-bind (name ds fs ts) args
    (let ((day (num ds 1 7)) (from (num fs 1 12)) (to (num ts 1 12))
          (c (find-course name)))
      (unless (and day from to (<= from to)) (fail "BADARG"))
      (unless c (fail "NOTFOUND"))
      (let ((nn (concatenate 'string (crs-name c) "_3")))
        (when (find-course nn) (fail "DUP"))
        (when (hits-time-p day from to) (fail "CONFLICT"))
        (let ((nc (copy-course c)))
          (setf (crs-name nc) nn (crs-day nc) day
                (crs-from nc) from (crs-to nc) to)
          (push nc *courses*))
        1))))

(defop "truncate" 1
  (let ((day (num (first args) 1 7)))
    (unless day (fail "BADARG"))
    (let ((cs (sort (course-on-day day) #'string< :key #'crs-name)))
      (if (null cs)
          0
          (let ((keep (first cs)))
            (setf *courses*
                  (remove-if (lambda (c)
                               (and (= (crs-day c) day) (not (eq c keep))))
                             *courses*))
            (1- (length cs)))))))

(defop "keep" 2
  (destructuring-bind (ds ns) args
    (let ((day (num ds 1 7)) (k (num ns 0 99)))
      (unless (and day k) (fail "BADARG"))
      (let* ((cs (sort (course-on-day day) #'string< :key #'crs-name))
             (kept (if (< k (length cs)) (subseq cs 0 k) cs)))
        (setf *courses*
              (remove-if (lambda (c)
                           (and (= (crs-day c) day)
                                (not (member c kept :test #'eq))))
                         *courses*))
        (- (length cs) (length kept))))))

(defop "renameTeacher" 2
  (destructuring-bind (t1 t2) args
    (unless (and (word-p t1) (word-p t2)) (fail "BADARG"))
    (let ((n 0))
      (dolist (c *courses*)
        (when (string= (crs-teacher c) t1)
          (setf (crs-teacher c) t2)
          (incf n)))
      n)))

(defop "renameLoc" 2
  (destructuring-bind (l1 l2) args
    (unless (and (word-p l1) (word-p l2)) (fail "BADARG"))
    (let ((n 0))
      (dolist (c *courses*)
        (when (string= (crs-loc c) l1)
          (setf (crs-loc c) l2)
          (incf n)))
      n)))

(defop "dedupe" 0
  (let ((seen '()) (dead '()) (n 0))
    (dolist (c (sort (copy-list *courses*) #'string< :key #'crs-name))
      (let ((key (list (crs-teacher c) (crs-loc c) (crs-day c)
                       (crs-from c) (crs-to c))))
        (if (member key seen :test #'equal)
            (progn (push c dead) (incf n))
            (push key seen))))
    (setf *courses* (remove-if (lambda (c) (member c dead :test #'eq)) *courses*))
    n))

(defop "compress" 1
  (let ((day (num (first args) 1 7)))
    (unless day (fail "BADARG"))
    (compress-day day)))

(defop "compact" 0
  (let ((n 0))
    (dotimes (i 7)
      (incf n (compress-day (1+ i))))
    n))

(defop "mirror" 2
  (destructuring-bind (ds d2s) args
    (let ((d1 (num ds 1 7)) (d2 (num d2s 1 7)))
      (unless (and d1 d2) (fail "BADARG"))
      (let ((src (course-on-day d1)))
        (dolist (c src)
          (when (find-course (concatenate 'string (crs-name c) "_m"))
            (fail "DUP")))
        (dolist (c src)
          (let ((nc (copy-course c)))
            (setf (crs-name nc) (concatenate 'string (crs-name c) "_m")
                  (crs-day nc) d2)
            (push nc *courses*)))
        (length src)))))

(defop "absorb" 2
  (destructuring-bind (na nb) args
    (let ((a (find-course na)) (b (find-course nb)))
      (unless a (fail "NOTFOUND"))
      (unless b (fail "NOTFOUND"))
      (unless (eq a b)
        (setf (crs-teacher a) (crs-teacher b) (crs-loc a) (crs-loc b)))
      2)))

(defop "swapDays" 2
  (destructuring-bind (d1s d2s) args
    (let ((d1 (num d1s 1 7)) (d2 (num d2s 1 7)))
      (unless (and d1 d2) (fail "BADARG"))
      (let ((a (course-on-day d1))
            (b (if (= d1 d2) nil (course-on-day d2))))
        (when (some (lambda (x)
                      (some (lambda (y)
                              (and (<= (crs-from x) (crs-to y))
                                   (<= (crs-from y) (crs-to x))))
                            b))
                    a)
          (fail "CONFLICT"))
        (dolist (c a) (setf (crs-day c) d2))
        (dolist (c b) (setf (crs-day c) d1))
        (if (= d1 d2) (* 2 (length a)) (+ (length a) (length b)))))))

(defop "promote" 1
  (let ((c (find-course (first args))))
    (unless c (fail "NOTFOUND"))
    (let* ((day (crs-day c))
           (dur (- (crs-to c) (crs-from c)))
           (slot (loop for f from 1 to (- 12 dur)
                       when (not (hits-time-p day f (+ f dur) c))
                         return f)))
      (when slot
        (setf (crs-from c) slot (crs-to c) (+ slot dur)))
      1)))

(defop "purge" 1
  (let ((who (first args)))
    (let ((n (count-if (lambda (c) (string= (crs-teacher c) who)) *courses*)))
      (setf *courses*
            (remove-if (lambda (c) (string= (crs-teacher c) who)) *courses*))
      n)))

;;; ---------------------------------------------------------------- driver

(define-dispatch dispatch)

(defun command-args ()
  "Drop the program name and any --script / script-file residue."
  (let ((rest (rest sb-ext:*posix-argv*)))
    (loop while (and rest
                     (or (string-equal (first rest) "--script")
                         (let ((s (first rest)))
                           (and (> (length s) 5)
                                (string-equal (subseq s (- (length s) 5)) ".lisp")))))
          do (pop rest))
    rest))

(defun emit (kind payload name)
  (if (eq kind :ok)
      (format t "ok ~a ~a~%" name payload)
      (format t "err ~a~%" payload)))

(defun run-command (cmd)
  (let* ((tokens (split-words cmd))
         (dry nil))
    (when (and tokens (string-equal (first tokens) "--dry"))
      (setf dry t tokens (rest tokens)))
    (if (null tokens)
        (format t "err BADARG~%")
        (let ((snapshot (if dry (mapcar #'copy-course *courses*) nil)))
          (multiple-value-bind (kind payload name)
              (dispatch (first tokens) (rest tokens))
            (when dry (setf *courses* snapshot))
            (emit kind payload name))))))

(defun print-state ()
  (format t "#state~%")
  (dolist (c (sort (copy-list *courses*) #'string< :key #'crs-name))
    (format t "~a|~a|~a|~a|~a-~a~%"
            (crs-name c) (crs-teacher c) (crs-loc c)
            (crs-day c) (crs-from c) (crs-to c))))

(defun main ()
  (dolist (cmd (command-args))
    (run-command cmd))
  (print-state))

(main)
