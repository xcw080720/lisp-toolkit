(in-package :cl-user)

(defstruct course name teacher loc day from to)

(defparameter *ops* (make-hash-table :test #'equal))

(defmacro defop (name nargs (state-var &rest arg-vars) &body body)
  (let ((args-sym (gensym "ARGS"))
        (st-sym (gensym "ST")))
    `(setf (gethash ,(string-downcase name) *ops*)
           (lambda (,args-sym ,st-sym)
             (if (/= (length ,args-sym) ,nargs)
                 (values :err "BADARG" ,st-sym)
                 (destructuring-bind ,arg-vars ,args-sym
                   (let ((,state-var ,st-sym))
                     (declare (ignorable ,state-var))
                     (labels ((ok (n &optional (new-state ,state-var))
                                (values :ok n new-state))
                              (err (code &optional (new-state ,state-var))
                                (values :err code new-state)))
                       ,@body))))))))

(defun split-command (s)
  (let ((res nil)
        (start 0)
        (len (length s)))
    (loop for i from 0 below len
          do (when (char= (char s i) #\Space)
               (when (> i start)
                 (push (subseq s start i) res))
               (setf start (1+ i))))
    (when (> len start)
      (push (subseq s start len) res))
    (nreverse res)))

(defun parse-int (s)
  (handler-case
      (parse-integer s :junk-allowed nil)
    (error () nil)))

(defun valid-word-p (s)
  (and (stringp s)
       (<= 1 (length s) 12)))

(defun find-course (name state)
  (find name state :key #'course-name :test #'equal))

(defun overlaps-p (day from to state &optional ignore)
  (loop for c in state
        when (and (not (eq c ignore))
                  (= (course-day c) day)
                  (<= from (course-to c))
                  (<= (course-from c) to))
          return c))

(defun course-name< (a b)
  (string< (course-name a) (course-name b)))

(defop "add" 6 (state name teacher loc day from to)
  (let ((d (parse-int day))
        (f (parse-int from))
        (t2 (parse-int to)))
    (if (or (not (valid-word-p name))
            (not (valid-word-p teacher))
            (not (valid-word-p loc))
            (null d)
            (null f)
            (null t2)
            (not (<= 1 d 7))
            (not (<= 1 f 12))
            (not (<= 1 t2 12))
            (> f t2))
        (err "BADARG" state)
        (if (find-course name state)
            (err "DUP" state)
            (if (>= (length state) 20)
                (err "LIMIT" state)
                (if (overlaps-p d f t2 state)
                    (err "CONFLICT" state)
                    (ok 1 (cons (make-course :name name
                                             :teacher teacher
                                             :loc loc
                                             :day d
                                             :from f
                                             :to t2)
                                state))))))))

(defop "del" 1 (state name)
  (if (not (valid-word-p name))
      (err "BADARG" state)
      (if (not (find-course name state))
          (err "NOTFOUND" state)
          (ok 1 (remove-if (lambda (c) (equal name (course-name c))) state)))))

(defop "edit" 3 (state name teacher loc)
  (if (or (not (valid-word-p name))
          (not (valid-word-p teacher))
          (not (valid-word-p loc)))
      (err "BADARG" state)
      (let ((c (find-course name state)))
        (if (null c)
            (err "NOTFOUND" state)
            (ok 1 (mapcar (lambda (x)
                            (if (eq x c)
                                (let ((n (copy-course x)))
                                  (setf (course-teacher n) teacher
                                        (course-loc n) loc)
                                  n)
                                x))
                          state))))))

(defop "move" 4 (state name day from to)
  (let ((d (parse-int day))
        (f (parse-int from))
        (t2 (parse-int to)))
    (if (or (not (valid-word-p name))
            (null d)
            (null f)
            (null t2)
            (not (<= 1 d 7))
            (not (<= 1 f 12))
            (not (<= 1 t2 12))
            (> f t2))
        (err "BADARG" state)
        (let ((c (find-course name state)))
          (if (null c)
              (err "NOTFOUND" state)
              (if (overlaps-p d f t2 state c)
                  (err "CONFLICT" state)
                  (ok 1 (mapcar (lambda (x)
                                  (if (eq x c)
                                      (let ((n (copy-course x)))
                                        (setf (course-day n) d
                                              (course-from n) f
                                              (course-to n) t2)
                                        n)
                                      x))
                                state))))))))

(defop "swap" 2 (state a b)
  (if (or (not (valid-word-p a))
          (not (valid-word-p b)))
      (err "BADARG" state)
      (let ((ca (find-course a state))
            (cb (find-course b state)))
        (if (or (null ca) (null cb))
            (err "NOTFOUND" state)
            (if (eq ca cb)
                (ok 2 state)
                (let ((aday (course-day ca))
                      (afrom (course-from ca))
                      (ato (course-to ca))
                      (bday (course-day cb))
                      (bfrom (course-from cb))
                      (bto (course-to cb)))
                  (ok 2 (mapcar (lambda (x)
                                  (cond ((eq x ca)
                                         (let ((n (copy-course x)))
                                           (setf (course-day n) bday
                                                 (course-from n) bfrom
                                                 (course-to n) bto)
                                           n))
                                        ((eq x cb)
                                         (let ((n (copy-course x)))
                                           (setf (course-day n) aday
                                                 (course-from n) afrom
                                                 (course-to n) ato)
                                           n))
                                        (t x)))
                                state)))))))

(defop "rename" 2 (state old new)
  (if (or (not (valid-word-p old))
          (not (valid-word-p new)))
      (err "BADARG" state)
      (let ((c (find-course old state)))
        (if (null c)
            (err "NOTFOUND" state)
            (if (find-course new state)
                (err "DUP" state)
                (ok 1 (mapcar (lambda (x)
                                (if (eq x c)
                                    (let ((n (copy-course x)))
                                      (setf (course-name n) new)
                                      n)
                                    x))
                              state)))))))

(defop "duplicate" 2 (state name newname)
  (if (or (not (valid-word-p name))
          (not (valid-word-p newname)))
      (err "BADARG" state)
      (let ((c (find-course name state)))
        (if (null c)
            (err "NOTFOUND" state)
            (if (find-course newname state)
                (err "DUP" state)
                (if (>= (length state) 20)
                    (err "LIMIT" state)
                    (let ((n (copy-course c)))
                      (setf (course-name n) newname)
                      (ok 1 (cons n state)))))))))

(defop "trim" 2 (state day to)
  (let ((d (parse-int day))
        (t2 (parse-int to)))
    (if (or (null d)
            (null t2)
            (not (<= 1 d 7))
            (not (<= 1 t2 12)))
        (err "BADARG" state)
        (let ((count 0))
          (let ((new-state
                  (mapcar (lambda (c)
                            (if (and (= (course-day c) d)
                                     (<= (course-from c) t2)
                                     (< t2 (course-to c)))
                                (progn
                                  (incf count)
                                  (let ((n (copy-course c)))
                                    (setf (course-to n) t2)
                                    n))
                                c))
                          state)))
            (ok count new-state))))))

(defop "clear" 1 (state day)
  (let ((d (parse-int day)))
    (if (or (null d) (not (<= 1 d 7)))
        (err "BADARG" state)
        (let* ((removed (remove-if (lambda (c) (= (course-day c) d)) state))
               (count (- (length state) (length removed))))
          (ok count removed)))))

(defop "shift" 2 (state day delta)
  (let ((d (parse-int day))
        (delta (parse-int delta)))
    (if (or (null d)
            (null delta)
            (not (<= 1 d 7)))
        (err "BADARG" state)
        (let ((target (+ d delta)))
          (if (or (< target 1) (> target 7))
              (err "BADARG" state)
              (let ((count 0))
                (let ((new-state
                        (mapcar (lambda (c)
                                  (if (= (course-day c) d)
                                      (progn
                                        (incf count)
                                        (let ((n (copy-course c)))
                                          (setf (course-day n) target)
                                          n))
                                      c))
                                state)))
                  (ok count new-state))))))))

(defop "copy" 2 (state name day)
  (let ((d (parse-int day)))
    (if (or (not (valid-word-p name))
            (null d)
            (not (<= 1 d 7)))
        (err "BADARG" state)
        (let ((c (find-course name state)))
          (if (null c)
              (err "NOTFOUND" state)
              (let ((newname (concatenate 'string name "_2")))
                (if (not (valid-word-p newname))
                    (err "BADARG" state)
                    (if (find-course newname state)
                        (err "DUP" state)
                        (if (>= (length state) 20)
                            (err "LIMIT" state)
                            (let ((n (copy-course c)))
                              (setf (course-name n) newname
                                    (course-day n) d)
                              (ok 1 (cons n state))))))))))))

(defop "merge" 2 (state a b)
  (if (or (not (valid-word-p a))
          (not (valid-word-p b)))
      (err "BADARG" state)
      (let ((ca (find-course a state))
            (cb (find-course b state)))
        (if (or (null ca) (null cb))
            (err "NOTFOUND" state)
            (if (equal a b)
                (err "BADARG" state)
                (let ((new-state
                        (remove-if (lambda (c) (eq c cb))
                                   (mapcar (lambda (x)
                                             (if (eq x ca)
                                                 (let ((n (copy-course x)))
                                                   (unless (equal (course-teacher cb) "-")
                                                     (setf (course-teacher n) (course-teacher cb)))
                                                   (unless (equal (course-loc cb) "-")
                                                     (setf (course-loc n) (course-loc cb)))
                                                   n)
                                                 x))
                                           state))))
                  (ok 2 new-state)))))))

(defop "sort" 0 (state)
  (ok 0 state))

(defop "filter" 1 (state day)
  (let ((d (parse-int day)))
    (if (or (null d) (not (<= 1 d 7)))
        (err "BADARG" state)
        (ok (count-if (lambda (c) (= (course-day c) d)) state) state))))

(defop "count" 0 (state)
  (ok (length state) state))

(defparameter *command-names*
  '("add" "del" "edit" "move" "swap" "rename" "duplicate" "trim"
    "clear" "shift" "copy" "merge" "sort" "filter" "count"))

(defun starts-with-command-p (s)
  (let ((parts (split-command s)))
    (and parts
         (member (string-downcase (first parts)) *command-names* :test #'equal))))

(defun extract-commands (argv)
  (let ((pos (position-if #'starts-with-command-p argv)))
    (if pos
        (nthcdr pos argv)
        nil)))

(defun process-command (cmd state)
  (let* ((parts (split-command cmd))
         (verb (if parts (string-downcase (first parts)) ""))
         (args (if parts (rest parts) nil))
         (fn (and parts (gethash verb *ops*))))
    (if (null fn)
        (values verb :err "BADARG" state)
        (multiple-value-bind (status payload new-state)
            (funcall fn args state)
          (values verb status payload new-state)))))

(defun main ()
  (let* ((argv (sb-ext:*posix-argv*))
         (commands (extract-commands argv))
         (state nil))
    (dolist (cmd commands)
      (multiple-value-bind (verb status payload new-state)
          (process-command cmd state)
        (setf state new-state)
        (if (eq status :ok)
            (format t "ok ~a ~d~%" verb payload)
            (format t "err ~a~%" payload))))
    (format t "#state~%")
    (dolist (c (sort (copy-list state) #'course-name<))
      (format t "~a|~a|~a|~d|~d-~d~%"
              (course-name c)
              (course-teacher c)
              (course-loc c)
              (course-day c)
              (course-from c)
              (course-to c)))))

(main)
