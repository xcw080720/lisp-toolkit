(defmacro fail (code)
  `(throw 'op-error ,code))

(defmacro defop (name argnames &body body)
  (let ((verb (string-downcase (symbol-name name))))
    `(defun ,(intern (concatenate 'string "OP-" (string-upcase (symbol-name name)))) (argv)
       (if (/= (length argv) ,(length argnames))
           (format t "err BADARG~%")
           (destructuring-bind ,argnames argv
             (let ((result (catch 'op-error (progn ,@body))))
               (if (stringp result)
                   (format t "err ~a~%" result)
                   (format t "ok ~a ~a~%" ,verb result))))))))

(defstruct course name teacher loc day from to)

(defvar *courses* nil)

(defun whitespace-char-p (c)
  (member c '(#\Space #\Tab #\Newline #\Return)))

(defun first-word (s)
  (let* ((n (length s))
         (start (or (position-if-not #'whitespace-char-p s) n)))
    (if (= start n)
        ""
        (let ((end (or (position-if #'whitespace-char-p s :start start) n)))
          (subseq s start end)))))

(defun split-words (s)
  (let ((result '())
        (start 0)
        (n (length s)))
    (dotimes (i n)
      (when (whitespace-char-p (char s i))
        (when (> i start)
          (push (subseq s start i) result))
        (setf start (1+ i))))
    (when (> n start)
      (push (subseq s start n) result))
    (nreverse result)))

(defun parse-int (s)
  (handler-case (parse-integer s)
    (error () nil)))

(defun valid-word-p (s)
  (and (stringp s)
       (<= 1 (length s) 12)))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun course-count ()
  (length *courses*))

(defun conflict-p (day from to &optional ignore)
  (some (lambda (c)
          (and (not (eq c ignore))
               (= (course-day c) day)
               (<= from (course-to c))
               (<= (course-from c) to)))
        *courses*))

(defop add (name teacher loc day from to)
  (unless (and (valid-word-p name) (valid-word-p teacher) (valid-word-p loc))
    (fail "BADARG"))
  (let ((d (parse-int day))
        (f (parse-int from))
        (to2 (parse-int to)))
    (unless (and d f to2 (<= 1 d 7) (<= 1 f 12) (<= 1 to2 12) (<= f to2))
      (fail "BADARG"))
    (when (find-course name) (fail "DUP"))
    (when (>= (course-count) 20) (fail "LIMIT"))
    (when (conflict-p d f to2) (fail "CONFLICT"))
    (push (make-course :name name :teacher teacher :loc loc :day d :from f :to to2)
          *courses*)
    1))

(defop del (name)
  (unless (valid-word-p name) (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (setf *courses* (remove c *courses* :test #'eq))
    1))

(defop edit (name teacher loc)
  (unless (and (valid-word-p name) (valid-word-p teacher) (valid-word-p loc))
    (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (setf (course-teacher c) teacher
          (course-loc c) loc)
    1))

(defop move (name day from to)
  (unless (valid-word-p name) (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (let ((d (parse-int day))
          (f (parse-int from))
          (to2 (parse-int to)))
      (unless (and d f to2 (<= 1 d 7) (<= 1 f 12) (<= 1 to2 12) (<= f to2))
        (fail "BADARG"))
      (when (conflict-p d f to2 c) (fail "CONFLICT"))
      (setf (course-day c) d
            (course-from c) f
            (course-to c) to2)
      1)))

(defop swap (a b)
  (unless (and (valid-word-p a) (valid-word-p b)) (fail "BADARG"))
  (let ((ca (find-course a))
        (cb (find-course b)))
    (unless ca (fail "NOTFOUND"))
    (unless cb (fail "NOTFOUND"))
    (let ((ad (course-day ca))
          (af (course-from ca))
          (at (course-to ca)))
      (setf (course-day ca) (course-day cb)
            (course-from ca) (course-from cb)
            (course-to ca) (course-to cb)
            (course-day cb) ad
            (course-from cb) af
            (course-to cb) at))
    2))

(defop rename (old new)
  (unless (and (valid-word-p old) (valid-word-p new)) (fail "BADARG"))
  (let ((c (find-course old)))
    (unless c (fail "NOTFOUND"))
    (when (find-course new) (fail "DUP"))
    (setf (course-name c) new)
    1))

(defop duplicate (name newname)
  (unless (and (valid-word-p name) (valid-word-p newname)) (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (when (find-course newname) (fail "DUP"))
    (when (>= (course-count) 20) (fail "LIMIT"))
    (push (make-course :name newname
                       :teacher (course-teacher c)
                       :loc (course-loc c)
                       :day (course-day c)
                       :from (course-from c)
                       :to (course-to c))
          *courses*)
    1))

(defop trim (day to)
  (let ((d (parse-int day))
        (to2 (parse-int to)))
    (unless (and d to2 (<= 1 d 7) (<= 1 to2 12)) (fail "BADARG"))
    (let ((count 0))
      (dolist (c *courses*)
        (when (and (= (course-day c) d)
                   (<= (course-from c) to2)
                   (< to2 (course-to c)))
          (setf (course-to c) to2)
          (incf count)))
      count)))

(defop clear (day)
  (let ((d (parse-int day)))
    (unless (and d (<= 1 d 7)) (fail "BADARG"))
    (let ((count (count-if (lambda (c) (= (course-day c) d)) *courses*)))
      (setf *courses* (remove-if (lambda (c) (= (course-day c) d)) *courses*))
      count)))

(defop shift (day delta)
  (let ((d (parse-int day))
        (delta2 (parse-int delta)))
    (unless (and d delta2 (<= 1 d 7)) (fail "BADARG"))
    (let ((newday (+ d delta2)))
      (unless (<= 1 newday 7) (fail "BADARG"))
      (let ((count 0))
        (dolist (c *courses*)
          (when (= (course-day c) d)
            (setf (course-day c) newday)
            (incf count)))
        count))))

(defop copy (name day)
  (unless (valid-word-p name) (fail "BADARG"))
  (let ((d (parse-int day)))
    (unless (and d (<= 1 d 7)) (fail "BADARG"))
    (let ((c (find-course name)))
      (unless c (fail "NOTFOUND"))
      (let ((newname (concatenate 'string name "_2")))
        (unless (valid-word-p newname) (fail "BADARG"))
        (when (find-course newname) (fail "DUP"))
        (when (>= (course-count) 20) (fail "LIMIT"))
        (push (make-course :name newname
                           :teacher (course-teacher c)
                           :loc (course-loc c)
                           :day d
                           :from (course-from c)
                           :to (course-to c))
              *courses*)
        1))))

(defop merge (a b)
  (unless (and (valid-word-p a) (valid-word-p b)) (fail "BADARG"))
  (let ((ca (find-course a))
        (cb (find-course b)))
    (unless ca (fail "NOTFOUND"))
    (unless cb (fail "NOTFOUND"))
    (setf (course-teacher ca) (course-teacher cb)
          (course-loc ca) (course-loc cb))
    (setf *courses* (remove cb *courses* :test #'eq))
    2))

(defop sort ()
  0)

(defop filter (day)
  (let ((d (parse-int day)))
    (unless (and d (<= 1 d 7)) (fail "BADARG"))
    (count-if (lambda (c) (= (course-day c) d)) *courses*)))

(defop count ()
  (length *courses*))

(defparameter *ops*
  '(("add" . op-add)
    ("del" . op-del)
    ("edit" . op-edit)
    ("move" . op-move)
    ("swap" . op-swap)
    ("rename" . op-rename)
    ("duplicate" . op-duplicate)
    ("trim" . op-trim)
    ("clear" . op-clear)
    ("shift" . op-shift)
    ("copy" . op-copy)
    ("merge" . op-merge)
    ("sort" . op-sort)
    ("filter" . op-filter)
    ("count" . op-count)))

(defun command-args ()
  (let ((known '("add" "del" "edit" "move" "swap" "rename" "duplicate" "trim" "clear" "shift" "copy" "merge" "sort" "filter" "count")))
    (loop for tail on (sb-ext:*posix-argv*)
          do (let ((arg (first tail)))
               (when (and (stringp arg)
                          (member (first-word arg) known :test #'string=))
                 (return tail)))
          finally (return nil))))

(let ((args (command-args)))
  (dolist (cmd args)
    (let* ((tokens (split-words cmd))
           (verb (first tokens))
           (handler (cdr (assoc verb *ops* :test #'string=))))
      (if handler
          (funcall handler (rest tokens))
          (format t "err BADARG~%")))))

(format t "#state~%")
(let ((sorted (sort (copy-list *courses*) #'string< :key #'course-name)))
  (dolist (c sorted)
    (format t "~a|~a|~a|~a|~a-~a~%"
            (course-name c)
            (course-teacher c)
            (course-loc c)
            (course-day c)
            (course-from c)
            (course-to c))))
