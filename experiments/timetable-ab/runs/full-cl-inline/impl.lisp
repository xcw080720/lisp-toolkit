(defvar *courses* nil)
(defvar *lines* nil)

(defun out-line (s)
  (push s *lines*))

(defun space-char-p (ch)
  (or (char= ch #\Space) (char= ch #\Tab) (char= ch #\Return) (char= ch #\Newline)))

(defun split-ws (s)
  (let ((tokens nil) (start nil))
    (dotimes (i (length s))
      (let ((ch (char s i)))
        (if (space-char-p ch)
            (when start
              (push (subseq s start i) tokens)
              (setf start nil))
            (unless start
              (setf start i)))))
    (when start
      (push (subseq s start) tokens))
    (nreverse tokens)))

(defun word-p (s)
  (and (stringp s)
       (>= (length s) 1)
       (<= (length s) 12)
       (every (lambda (ch) (and (> (char-code ch) 32) (< (char-code ch) 127))) s)))

(defun num-val (s lo hi)
  (when (and (stringp s) (plusp (length s)) (<= (length s) 4) (every #'digit-char-p s))
    (let ((v (parse-integer s)))
      (when (and (>= v lo) (<= v hi))
        v))))

(defun int-val (s)
  (when (and (stringp s) (plusp (length s)))
    (let* ((neg (char= (char s 0) #\-))
           (plus (char= (char s 0) #\+))
           (body (if (or neg plus) (subseq s 1) s)))
      (when (and (plusp (length body)) (<= (length body) 4) (every #'digit-char-p body))
        (let ((v (parse-integer body)))
          (if neg (- v) v))))))

(defun mk (n tn lc d f to)
  (vector n tn lc d f to))

(defun find-c (n)
  (find n *courses* :key (lambda (c) (svref c 0)) :test #'string=))

(defun conflict-p (d f to &optional skip)
  (let ((hit nil))
    (dolist (c *courses* hit)
      (when (and (not (eq c skip))
                 (= (svref c 3) d)
                 (<= f (svref c 5))
                 (<= (svref c 4) to))
        (setf hit t)))))

(defun day-key (c) (svref c 3))

(defun sort-by-name (lst)
  (sort lst #'string< :key (lambda (c) (svref c 0))))

(defun sort-by-from (lst)
  (sort lst (lambda (a b)
              (if (= (svref a 4) (svref b 4))
                  (string< (svref a 0) (svref b 0))
                  (< (svref a 4) (svref b 4))))))

(defun lisp-file-p (s)
  (let ((n (length s)))
    (and (>= n 5) (string-equal (subseq s (- n 5)) ".lisp"))))

(defun run-op (verb args)
  (cond
    ((string-equal verb "add")
     (if (/= (length args) 6)
         (values :err "BADARG")
         (let ((n (first args))
               (tn (second args))
               (lc (third args))
               (d (num-val (fourth args) 1 7))
               (f (num-val (fifth args) 1 12))
               (to (num-val (sixth args) 1 12)))
           (cond
             ((or (not (word-p n)) (not (word-p tn)) (not (word-p lc))
                  (null d) (null f) (null to) (> f to))
              (values :err "BADARG"))
             ((find-c n) (values :err "DUP"))
             ((>= (length *courses*) 20) (values :err "LIMIT"))
             ((conflict-p d f to) (values :err "CONFLICT"))
             (t (push (mk n tn lc d f to) *courses*)
                (values :ok 1))))))

    ((string-equal verb "del")
     (if (/= (length args) 1)
         (values :err "BADARG")
         (let ((n (first args)))
           (if (not (word-p n))
               (values :err "BADARG")
               (let ((c (find-c n)))
                 (if (null c)
                     (values :err "NOTFOUND")
                     (progn
                       (setf *courses* (remove c *courses* :test #'eq))
                       (values :ok 1))))))))

    ((string-equal verb "edit")
     (if (/= (length args) 3)
         (values :err "BADARG")
         (let ((n (first args)) (tn (second args)) (lc (third args)))
           (if (or (not (word-p n)) (not (word-p tn)) (not (word-p lc)))
               (values :err "BADARG")
               (let ((c (find-c n)))
                 (if (null c)
                     (values :err "NOTFOUND")
                     (progn
                       (setf (svref c 1) tn (svref c 2) lc)
                       (values :ok 1))))))))

    ((string-equal verb "move")
     (if (/= (length args) 4)
         (values :err "BADARG")
         (let ((n (first args))
               (d (num-val (second args) 1 7))
               (f (num-val (third args) 1 12))
               (to (num-val (fourth args) 1 12)))
           (if (or (not (word-p n)) (null d) (null f) (null to) (> f to))
               (values :err "BADARG")
               (let ((c (find-c n)))
                 (cond
                   ((null c) (values :err "NOTFOUND"))
                   ((conflict-p d f to c) (values :err "CONFLICT"))
                   (t (setf (svref c 3) d (svref c 4) f (svref c 5) to)
                      (values :ok 1))))))))

    ((string-equal verb "swap")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((a (first args)) (b (second args)))
           (if (or (not (word-p a)) (not (word-p b)))
               (values :err "BADARG")
               (let ((ca (find-c a)) (cb (find-c b)))
                 (if (or (null ca) (null cb))
                     (values :err "NOTFOUND")
                     (progn
                       (rotatef (svref ca 3) (svref cb 3))
                       (rotatef (svref ca 4) (svref cb 4))
                       (rotatef (svref ca 5) (svref cb 5))
                       (values :ok 2))))))))

    ((string-equal verb "rename")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((o (first args)) (nn (second args)))
           (if (or (not (word-p o)) (not (word-p nn)))
               (values :err "BADARG")
               (let ((c (find-c o)))
                 (cond
                   ((null c) (values :err "NOTFOUND"))
                   ((find-c nn) (values :err "DUP"))
                   (t (setf (svref c 0) nn)
                      (values :ok 1))))))))

    ((string-equal verb "duplicate")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((n (first args)) (nn (second args)))
           (if (or (not (word-p n)) (not (word-p nn)))
               (values :err "BADARG")
               (let ((c (find-c n)))
                 (cond
                   ((null c) (values :err "NOTFOUND"))
                   ((find-c nn) (values :err "DUP"))
                   (t (push (mk nn (svref c 1) (svref c 2) (svref c 3) (svref c 4) (svref c 5))
                            *courses*)
                      (values :ok 1))))))))

    ((string-equal verb "trim")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((d (num-val (first args) 1 7))
               (to (num-val (second args) 1 12)))
           (if (or (null d) (null to))
               (values :err "BADARG")
               (let ((k 0))
                 (dolist (c *courses*)
                   (when (and (= (svref c 3) d)
                              (<= (svref c 4) to)
                              (< to (svref c 5)))
                     (setf (svref c 5) to)
                     (incf k)))
                 (values :ok k))))))

    ((string-equal verb "clear")
     (if (/= (length args) 1)
         (values :err "BADARG")
         (let ((d (num-val (first args) 1 7)))
           (if (null d)
               (values :err "BADARG")
               (let ((k (count d *courses* :key #'day-key)))
                 (setf *courses* (remove d *courses* :key #'day-key))
                 (values :ok k))))))

    ((string-equal verb "shift")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((d (num-val (first args) 1 7))
               (dl (int-val (second args))))
           (cond
             ((or (null d) (null dl)) (values :err "BADARG"))
             ((or (< (+ d dl) 1) (> (+ d dl) 7)) (values :err "BADARG"))
             (t (let ((nd (+ d dl)) (k 0))
                  (dolist (c *courses*)
                    (when (= (svref c 3) d)
                      (setf (svref c 3) nd)
                      (incf k)))
                  (values :ok k)))))))

    ((string-equal verb "copy")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((n (first args)) (d (num-val (second args) 1 7)))
           (if (or (not (word-p n)) (null d))
               (values :err "BADARG")
               (let ((c (find-c n)))
                 (if (null c)
                     (values :err "NOTFOUND")
                     (let ((nn (concatenate 'string n "_2")))
                       (if (find-c nn)
                           (values :err "DUP")
                           (progn
                             (push (mk nn (svref c 1) (svref c 2) d (svref c 4) (svref c 5))
                                   *courses*)
                             (values :ok 1))))))))))

    ((string-equal verb "merge")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((a (first args)) (b (second args)))
           (if (or (not (word-p a)) (not (word-p b)))
               (values :err "BADARG")
               (let ((ca (find-c a)) (cb (find-c b)))
                 (cond
                   ((or (null ca) (null cb)) (values :err "NOTFOUND"))
                   ((eq ca cb) (values :err "BADARG"))
                   (t (setf (svref ca 1) (svref cb 1) (svref ca 2) (svref cb 2))
                      (setf *courses* (remove cb *courses* :test #'eq))
                      (values :ok 2))))))))

    ((string-equal verb "sort")
     (if (/= (length args) 0)
         (values :err "BADARG")
         (progn
           (setf *courses* (sort-by-name *courses*))
           (values :ok 0))))

    ((string-equal verb "filter")
     (if (/= (length args) 1)
         (values :err "BADARG")
         (let ((d (num-val (first args) 1 7)))
           (if (null d)
               (values :err "BADARG")
               (values :ok (count d *courses* :key #'day-key))))))

    ((string-equal verb "count")
     (if (/= (length args) 0)
         (values :err "BADARG")
         (values :ok (length *courses*))))

    ((string-equal verb "swapTeacher")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((a (first args)) (b (second args)))
           (if (or (not (word-p a)) (not (word-p b)))
               (values :err "BADARG")
               (let ((ca (find-c a)) (cb (find-c b)))
                 (if (or (null ca) (null cb))
                     (values :err "NOTFOUND")
                     (progn
                       (rotatef (svref ca 1) (svref cb 1))
                       (values :ok 2))))))))

    ((string-equal verb "swapLoc")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((a (first args)) (b (second args)))
           (if (or (not (word-p a)) (not (word-p b)))
               (values :err "BADARG")
               (let ((ca (find-c a)) (cb (find-c b)))
                 (if (or (null ca) (null cb))
                     (values :err "NOTFOUND")
                     (progn
                       (rotatef (svref ca 2) (svref cb 2))
                       (values :ok 2))))))))

    ((string-equal verb "copyTo")
     (if (/= (length args) 4)
         (values :err "BADARG")
         (let ((n (first args))
               (d (num-val (second args) 1 7))
               (f (num-val (third args) 1 12))
               (to (num-val (fourth args) 1 12)))
           (if (or (not (word-p n)) (null d) (null f) (null to) (> f to))
               (values :err "BADARG")
               (let ((c (find-c n)))
                 (cond
                   ((null c) (values :err "NOTFOUND"))
                   ((find-c (concatenate 'string n "_3")) (values :err "DUP"))
                   ((conflict-p d f to) (values :err "CONFLICT"))
                   (t (push (mk (concatenate 'string n "_3")
                                (svref c 1) (svref c 2) d f to)
                            *courses*)
                      (values :ok 1))))))))

    ((string-equal verb "truncate")
     (if (/= (length args) 1)
         (values :err "BADARG")
         (let ((d (num-val (first args) 1 7)))
           (if (null d)
               (values :err "BADARG")
               (let* ((on (remove-if-not (lambda (c) (= (svref c 3) d)) *courses*))
                      (sorted (sort-by-name (copy-list on))))
                 (if (null sorted)
                     (values :ok 0)
                     (let ((keep (first sorted)) (k 0))
                       (dolist (c on)
                         (unless (eq c keep)
                           (incf k)))
                       (setf *courses*
                             (remove-if (lambda (c)
                                          (and (= (svref c 3) d) (not (eq c keep))))
                                        *courses*))
                       (values :ok k))))))))

    ((string-equal verb "keep")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((d (num-val (first args) 1 7))
               (kk (num-val (second args) 0 99)))
           (if (or (null d) (null kk))
               (values :err "BADARG")
               (let* ((on (remove-if-not (lambda (c) (= (svref c 3) d)) *courses*))
                      (sorted (sort-by-name (copy-list on)))
                      (kept (if (>= kk (length sorted)) sorted (subseq sorted 0 kk)))
                      (k 0))
                 (dolist (c on)
                   (unless (member c kept :test #'eq)
                     (incf k)))
                 (setf *courses*
                       (remove-if (lambda (c)
                                    (and (= (svref c 3) d)
                                         (not (member c kept :test #'eq))))
                                  *courses*))
                 (values :ok k))))))

    ((string-equal verb "renameTeacher")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((a (first args)) (b (second args)))
           (if (or (not (word-p a)) (not (word-p b)))
               (values :err "BADARG")
               (let ((k 0))
                 (dolist (c *courses*)
                   (when (string= (svref c 1) a)
                     (setf (svref c 1) b)
                     (incf k)))
                 (values :ok k))))))

    ((string-equal verb "renameLoc")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((a (first args)) (b (second args)))
           (if (or (not (word-p a)) (not (word-p b)))
               (values :err "BADARG")
               (let ((k 0))
                 (dolist (c *courses*)
                   (when (string= (svref c 2) a)
                     (setf (svref c 2) b)
                     (incf k)))
                 (values :ok k))))))

    ((string-equal verb "dedupe")
     (if (/= (length args) 0)
         (values :err "BADARG")
         (let ((sorted (sort-by-name (copy-list *courses*)))
               (seen nil)
               (kept nil)
               (k 0))
           (dolist (c sorted)
             (let ((key (list (svref c 1) (svref c 2) (svref c 3) (svref c 4) (svref c 5))))
               (if (member key seen :test #'equal)
                   (incf k)
                   (progn
                     (push key seen)
                     (push c kept)))))
           (setf *courses* (nreverse kept))
           (values :ok k))))

    ((string-equal verb "compress")
     (if (/= (length args) 1)
         (values :err "BADARG")
         (let ((d (num-val (first args) 1 7)))
           (if (null d)
               (values :err "BADARG")
               (let ((on (sort-by-from
                          (remove-if-not (lambda (c) (= (svref c 3) d)) *courses*)))
                     (k 0))
                 (loop for i from 0 below (length on)
                       for c = (nth i on)
                       for nf = (1+ i)
                       for nt = (+ i 2)
                       do (unless (and (= (svref c 4) nf) (= (svref c 5) nt))
                            (setf (svref c 4) nf (svref c 5) nt)
                            (incf k)))
                 (values :ok k))))))

    ((string-equal verb "compact")
     (if (/= (length args) 0)
         (values :err "BADARG")
         (let ((k 0))
           (dotimes (i 7)
             (let* ((d (1+ i))
                    (on (sort-by-from
                         (remove-if-not (lambda (c) (= (svref c 3) d)) *courses*))))
               (loop for j from 0 below (length on)
                     for c = (nth j on)
                     for nf = (1+ j)
                     for nt = (+ j 2)
                     do (unless (and (= (svref c 4) nf) (= (svref c 5) nt))
                          (setf (svref c 4) nf (svref c 5) nt)
                          (incf k)))))
           (values :ok k))))

    ((string-equal verb "mirror")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((d (num-val (first args) 1 7))
               (d2 (num-val (second args) 1 7)))
           (if (or (null d) (null d2))
               (values :err "BADARG")
               (let ((on (remove-if-not (lambda (c) (= (svref c 3) d)) *courses*))
                     (dup nil))
                 (dolist (c on)
                   (when (find-c (concatenate 'string (svref c 0) "_m"))
                     (setf dup t)))
                 (if dup
                     (values :err "DUP")
                     (progn
                       (dolist (c on)
                         (push (mk (concatenate 'string (svref c 0) "_m")
                                   (svref c 1) (svref c 2) d2 (svref c 4) (svref c 5))
                               *courses*))
                       (values :ok (length on)))))))))

    ((string-equal verb "absorb")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((a (first args)) (b (second args)))
           (if (or (not (word-p a)) (not (word-p b)))
               (values :err "BADARG")
               (let ((ca (find-c a)) (cb (find-c b)))
                 (cond
                   ((or (null ca) (null cb)) (values :err "NOTFOUND"))
                   (t (setf (svref ca 1) (svref cb 1) (svref ca 2) (svref cb 2))
                      (values :ok 2))))))))

    ((string-equal verb "swapDays")
     (if (/= (length args) 2)
         (values :err "BADARG")
         (let ((d1 (num-val (first args) 1 7))
               (d2 (num-val (second args) 1 7)))
           (if (or (null d1) (null d2))
               (values :err "BADARG")
               (let ((n1 (count d1 *courses* :key #'day-key))
                     (n2 (count d2 *courses* :key #'day-key)))
                 (if (= d1 d2)
                     (values :ok (+ n1 n2))
                     (let ((sim (mapcar #'copy-seq *courses*))
                           (bad nil))
                       (dolist (c sim)
                         (cond ((= (svref c 3) d1) (setf (svref c 3) d2))
                               ((= (svref c 3) d2) (setf (svref c 3) d1))))
                       (loop for a on sim
                             do (dolist (b (rest a))
                                  (when (and (= (svref (first a) 3) (svref b 3))
                                             (<= (svref (first a) 4) (svref b 5))
                                             (<= (svref b 4) (svref (first a) 5)))
                                    (setf bad t))))
                       (if bad
                           (values :err "CONFLICT")
                           (progn
                             (dolist (c *courses*)
                               (cond ((= (svref c 3) d1) (setf (svref c 3) d2))
                                     ((= (svref c 3) d2) (setf (svref c 3) d1))))
                             (values :ok (+ n1 n2)))))))))))

    ((string-equal verb "promote")
     (if (/= (length args) 1)
         (values :err "BADARG")
         (let ((n (first args)))
           (if (not (word-p n))
               (values :err "BADARG")
               (let ((c (find-c n)))
                 (if (null c)
                     (values :err "NOTFOUND")
                     (let ((d (svref c 3)) (slot nil))
                       (loop for f from 1 to 11
                             do (when (not (conflict-p d f (1+ f) c))
                                  (setf slot f)
                                  (return)))
                       (if slot
                           (progn
                             (setf (svref c 4) slot (svref c 5) (1+ slot))
                             (values :ok 1))
                           (values :ok 0)))))))))

    ((string-equal verb "purge")
     (if (/= (length args) 1)
         (values :err "BADARG")
         (let ((tn (first args)))
           (if (not (word-p tn))
               (values :err "BADARG")
               (let ((k (count tn *courses* :key (lambda (c) (svref c 1)) :test #'string=)))
                 (setf *courses* (remove tn *courses*
                                        :key (lambda (c) (svref c 1))
                                        :test #'string=))
                 (values :ok k))))))

    (t (values :err "BADARG"))))

(defun main ()
  (let ((args (cdr sb-ext:*posix-argv*)))
    (loop while (and args
                     (or (string= (first args) "--script")
                         (string= (first args) "--")
                         (string= (first args) "sbcl")
                         (lisp-file-p (first args))))
          do (pop args))
    (let ((pending nil))
      (dolist (item args)
        (let ((tokens (split-ws item)))
          (if (null tokens)
              (progn
                (setf pending nil)
                (out-line "err BADARG"))
              (let ((dry pending)
                    (rest tokens))
                (loop while (and rest (string= (first rest) "--dry"))
                      do (setf dry t)
                         (pop rest))
                (if (null rest)
                    (setf pending t)
                    (let ((snap (when dry (mapcar #'copy-seq *courses*))))
                      (setf pending nil)
                      (multiple-value-bind (kind val) (run-op (first rest) (rest rest))
                        (when dry
                          (setf *courses* snap))
                        (if (eq kind :ok)
                            (out-line (format nil "ok ~a ~a" (first rest) val))
                            (out-line (format nil "err ~a" val))))))))))
      (when pending
        (out-line "err BADARG")))
    (dolist (s (nreverse *lines*))
      (write-line s))
    (write-line "#state")
    (dolist (c (sort-by-name (copy-list *courses*)))
      (write-line (format nil "~a|~a|~a|~a|~a-~a"
                          (svref c 0) (svref c 1) (svref c 2)
                          (svref c 3) (svref c 4) (svref c 5))))))

(main)
