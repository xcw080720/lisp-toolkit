(in-package :cl-user)

(defstruct course name teacher loc day from to)

(defvar *courses* nil)
(defvar *ops* (make-hash-table :test #'equal))

(define-condition op-error (error)
  ((code :initarg :code :reader op-error-code)))

(defun fail (code)
  (error 'op-error :code code))

(defun split-words (s)
  (let ((len (length s))
        (start 0)
        (res '()))
    (loop for i from 0 to len do
      (when (or (= i len)
                (member (char s i) '(#\Space #\Tab)))
        (when (< start i)
          (push (subseq s start i) res))
        (setf start (1+ i))))
    (nreverse res)))

(defun parse-int-token (s &key allow-negative)
  (let* ((len (length s))
         (start (if (and (> len 0)
                         allow-negative
                         (or (char= (char s 0) #\-)
                             (char= (char s 0) #\+)))
                    1
                    0)))
    (when (or (= start len)
              (not (every (lambda (c) (char<= #\0 c #\9))
                          (subseq s start))))
      (return-from parse-int-token nil))
    (handler-case
        (parse-integer s)
      (error () nil))))

(defun word-ok-p (s)
  (and (stringp s)
       (<= 1 (length s) 12)))

(defun day-ok-p (n)
  (and (integerp n) (<= 1 n 7)))

(defun time-ok-p (n)
  (and (integerp n) (<= 1 n 12)))

(defun find-course (name)
  (find name *courses* :key #'course-name :test #'string=))

(defun intervals-overlap-p (f1 t1 f2 t2)
  (not (or (< t1 f2) (< t2 f1))))

(defun time-conflict-p (day from to &optional exclude)
  (loop for c in *courses*
        unless (eq c exclude)
        when (and (= day (course-day c))
                  (intervals-overlap-p from to (course-from c) (course-to c)))
        return t))

(defmacro defop (name args &body body)
  (let* ((argc (length args))
         (fname (intern (format nil "OP-~A" (string-upcase (symbol-name name)))))
         (verb (string-downcase (symbol-name name))))
    `(progn
       (defun ,fname (cmd-args)
         (unless (= (length cmd-args) ,argc)
           (fail "BADARG"))
         (destructuring-bind ,args cmd-args
           ,@body))
       (setf (gethash ,verb *ops*) #',fname))))

(defop add (name teacher loc day from to)
  (unless (and (word-ok-p name)
               (word-ok-p teacher)
               (word-ok-p loc))
    (fail "BADARG"))
  (let ((d (parse-int-token day))
        (f (parse-int-token from))
        (tt (parse-int-token to)))
    (unless (and d f tt (day-ok-p d) (time-ok-p f) (time-ok-p tt) (<= f tt))
      (fail "BADARG"))
    (when (find-course name)
      (fail "DUP"))
    (when (>= (length *courses*) 20)
      (fail "LIMIT"))
    (when (time-conflict-p d f tt)
      (fail "CONFLICT"))
    (push (make-course :name name :teacher teacher :loc loc
                       :day d :from f :to tt)
          *courses*)
    1))

(defop del (name)
  (unless (word-ok-p name) (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (setf *courses* (remove c *courses* :test #'eq))
    1))

(defop edit (name teacher loc)
  (unless (and (word-ok-p name) (word-ok-p teacher) (word-ok-p loc))
    (fail "BADARG"))
  (let ((c (find-course name)))
    (unless c (fail "NOTFOUND"))
    (setf (course-teacher c) teacher
          (course-loc c) loc)
    1))

(defop move (name day from to)
  (unless (word-ok-p name) (fail "BADARG"))
  (let ((d (parse-int-token day))
        (f (parse-int-token from))
        (tt (parse-int-token to)))
    (unless (and d f tt (day-ok-p d) (time-ok-p f) (time-ok-p tt) (<= f tt))
      (fail "BADARG"))
    (let ((c (find-course name)))
      (unless c (fail "NOTFOUND"))
      (when (time-conflict-p d f tt c)
        (fail "CONFLICT"))
      (setf (course-day c) d
            (course-from c) f
            (course-to c) tt)
      1)))

(defop swap (a b)
  (unless (and (word-ok-p a) (word-ok-p b)) (fail "BADARG"))
  (let ((ca (find-course a))
        (cb (find-course b)))
    (unless (and ca cb) (fail "NOTFOUND"))
    (if (eq ca cb)
        2
        (let ((da (course-day ca)) (fa (course-from ca)) (ta (course-to ca))
              (db (course-day cb)) (fb (course-from cb)) (tb (course-to cb)))
          (setf (course-day ca) db (course-from ca) fb (course-to ca) tb
                (course-day cb) da (course-from cb) fa (course-to cb) ta)
          2))))

(defop rename (old new)
  (unless (and (word-ok-p old) (word-ok-p new)) (fail "BADARG"))
  (let ((c (find-course old)))
    (unless c (fail "NOTFOUND"))
    (when (find-course new) (fail "DUP"))
    (setf (course-name c) new)
    1))

(defop duplicate (name newname)
  (unless (and (word-ok-p name) (word-ok-p newname)) (fail "BADARG"))
  (let ((src (find-course name)))
    (unless src (fail "NOTFOUND"))
    (when (find-course newname) (fail "DUP"))
    (when (>= (length *courses*) 20) (fail "LIMIT"))
    (let ((copy (copy-course src)))
      (setf (course-name copy) newname)
      (push copy *courses*)
      1)))

(defop trim (day to)
  (let ((d (parse-int-token day))
        (tt (parse-int-token to)))
    (unless (and d tt (day-ok-p d) (time-ok-p tt))
      (fail "BADARG"))
    (let ((count 0))
      (dolist (c *courses*)
        (when (and (= (course-day c) d)
                   (<= (course-from c) tt)
                   (< tt (course-to c)))
          (setf (course-to c) tt)
          (incf count)))
      count)))

(defop clear (day)
  (let ((d (parse-int-token day)))
    (unless (and d (day-ok-p d)) (fail "BADARG"))
    (let ((new nil) (count 0))
      (dolist (c *courses*)
        (if (= (course-day c) d)
            (incf count)
            (push c new)))
      (setf *courses* (nreverse new))
      count)))

(defop shift (day delta)
  (let ((d (parse-int-token day))
        (delta-i (parse-int-token delta :allow-negative t)))
    (unless (and d delta-i (day-ok-p d))
      (fail "BADARG"))
    (let ((new-day (+ d delta-i)))
      (unless (day-ok-p new-day)
        (fail "BADARG"))
      (let ((count 0))
        (dolist (c *courses*)
          (when (= (course-day c) d)
            (setf (course-day c) new-day)
            (incf count)))
        count))))

(defop copy (name day)
  (unless (word-ok-p name) (fail "BADARG"))
  (let ((d (parse-int-token day)))
    (unless (and d (day-ok-p d)) (fail "BADARG"))
    (let ((src (find-course name)))
      (unless src (fail "NOTFOUND"))
      (let ((newname (concatenate 'string name "_2")))
        (unless (word-ok-p newname) (fail "BADARG"))
        (when (find-course newname) (fail "DUP"))
        (when (>= (length *courses*) 20) (fail "LIMIT"))
        (let ((copy (copy-course src)))
          (setf (course-name copy) newname
                (course-day copy) d)
          (push copy *courses*)
          1)))))

(defop merge (a b)
  (unless (and (word-ok-p a) (word-ok-p b)) (fail "BADARG"))
  (let ((ca (find-course a))
        (cb (find-course b)))
    (unless (and ca cb) (fail "NOTFOUND"))
    (if (eq ca cb)
        2
        (progn
          (setf (course-teacher ca) (course-teacher cb)
                (course-loc ca) (course-loc cb))
          (setf *courses* (remove cb *courses* :test #'eq))
          2))))

(defop sort ()
  0)

(defop filter (day)
  (let ((d (parse-int-token day)))
    (unless (and d (day-ok-p d)) (fail "BADARG"))
    (count-if (lambda (c) (= (course-day c) d)) *courses*)))

(defop count ()
  (length *courses*))

(defun run-command (s)
  (let* ((words (split-words s))
         (verb (and words (string-downcase (first words))))
         (args (rest words)))
    (let ((handler (and verb (gethash verb *ops*))))
      (if handler
          (handler-case
              (let ((n (funcall handler args)))
                (format t "ok ~A ~D~%" verb n))
            (op-error (e)
              (format t "err ~A~%" (op-error-code e))))
          (format t "err BADARG~%")))))

(defun main ()
  (dolist (arg (cdr sb-ext:*posix-argv*))
    (run-command arg))
  (format t "#state~%")
  (dolist (c (sort (copy-list *courses*) #'string< :key #'course-name))
    (format t "~A|~A|~A|~D|~D-~D~%"
            (course-name c)
            (course-teacher c)
            (course-loc c)
            (course-day c)
            (course-from c)
            (course-to c)))
  (finish-output))

(main)
