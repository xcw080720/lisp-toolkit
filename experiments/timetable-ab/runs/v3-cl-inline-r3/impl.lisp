(defvar *courses* nil)

(defun split-tokens (s)
  (let ((n (length s)) (start 0) (out nil))
    (dotimes (i n)
      (when (or (char= (char s i) #\Space) (char= (char s i) #\Tab))
        (when (> i start) (push (subseq s start i) out))
        (setf start (1+ i))))
    (when (> n start) (push (subseq s start n) out))
    (nreverse out)))

(defun u-num (s)
  (and (plusp (length s)) (every #'digit-char-p s) (parse-integer s)))

(defun i-num (s)
  (let ((n (length s)))
    (cond ((and (plusp n) (every #'digit-char-p s)) (parse-integer s))
          ((and (> n 1) (char= (char s 0) #\-) (every #'digit-char-p (subseq s 1)))
           (parse-integer s))
          (t nil))))

(defun word-ok (s)
  (and (plusp (length s)) (<= (length s) 12)))

(defun run-one (line)
  (let* ((ts (split-tokens line))
         (cmd (first ts))
         (a (second ts))
         (b (third ts))
         (c (fourth ts))
         (d (fifth ts))
         (e (sixth ts))
         (f (seventh ts)))
    (cond
      ((null ts) (format t "err BADARG~%"))
      ((string-equal cmd "add")
       (let ((dv (and d (u-num d))) (fv (and e (u-num e))) (tv (and f (u-num f))))
         (if (not (and a b c (null (eighth ts)) (word-ok a) (word-ok b) (word-ok c)
                       dv fv tv (<= 1 dv 7) (<= 1 fv 12) (<= 1 tv 12) (<= fv tv)))
             (format t "err BADARG~%")
             (let ((hit nil) (cur *courses*))
               (loop while cur do
                     (if (string= (first (first cur)) a)
                         (progn (setf hit t) (return))
                         (setf cur (rest cur))))
               (cond
                 (hit (format t "err DUP~%"))
                 ((>= (length *courses*) 20) (format t "err LIMIT~%"))
                 (t (let ((conf nil) (cur2 *courses*))
                      (loop while cur2 do
                            (let ((cc (first cur2)))
                              (when (and (= (fourth cc) dv)
                                         (<= fv (sixth cc))
                                         (<= (fifth cc) tv))
                                (setf conf t)))
                            (setf cur2 (rest cur2)))
                      (if conf
                          (format t "err CONFLICT~%")
                          (progn
                            (push (list a b c dv fv tv) *courses*)
                            (format t "ok add 1~%"))))))))))
      ((string-equal cmd "del")
       (if (not (and a (null b) (word-ok a)))
           (format t "err BADARG~%")
           (let ((cur *courses*) (found nil))
             (loop while cur do
                   (if (string= (first (first cur)) a)
                       (progn (setf found t) (return))
                       (setf cur (rest cur))))
             (if found
                 (progn
                   (setf *courses* (remove a *courses* :key #'first :test #'string= :count 1))
                   (format t "ok del 1~%"))
                 (format t "err NOTFOUND~%")))))
      ((string-equal cmd "edit")
       (if (not (and a b c (null d) (word-ok a) (word-ok b) (word-ok c)))
           (format t "err BADARG~%")
           (let ((cur *courses*) (found nil))
             (loop while cur do
                   (if (string= (first (first cur)) a)
                       (progn (setf found t) (return))
                       (setf cur (rest cur))))
             (if found
                 (let ((self (first cur)))
                   (setf (second self) b)
                   (setf (third self) c)
                   (format t "ok edit 1~%"))
                 (format t "err NOTFOUND~%")))))
      ((string-equal cmd "move")
       (let ((dv (and b (u-num b))) (fv (and c (u-num c))) (tv (and d (u-num d))))
         (if (not (and a dv fv tv (null e) (word-ok a)
                       (<= 1 dv 7) (<= 1 fv 12) (<= 1 tv 12) (<= fv tv)))
             (format t "err BADARG~%")
             (let ((cur *courses*) (found nil))
               (loop while cur do
                     (if (string= (first (first cur)) a)
                         (progn (setf found t) (return))
                         (setf cur (rest cur))))
               (if (not found)
                   (format t "err NOTFOUND~%")
                   (let ((self (first cur)) (conf nil) (cur2 *courses*))
                     (loop while cur2 do
                           (let ((cc (first cur2)))
                             (unless (eq cc self)
                               (when (and (= (fourth cc) dv)
                                          (<= fv (sixth cc))
                                          (<= (fifth cc) tv))
                                 (setf conf t))))
                           (setf cur2 (rest cur2)))
                     (if conf
                         (format t "err CONFLICT~%")
                         (progn
                           (setf (fourth self) dv)
                           (setf (fifth self) fv)
                           (setf (sixth self) tv)
                           (format t "ok move 1~%")))))))))
      ((string-equal cmd "swap")
       (if (not (and a b (null c) (word-ok a) (word-ok b)))
           (format t "err BADARG~%")
           (let ((ca nil) (cb nil) (cur *courses*))
             (loop while cur do
                   (let ((cc (first cur)))
                     (cond ((string= (first cc) a) (setf ca cc))
                           ((string= (first cc) b) (setf cb cc))))
                   (setf cur (rest cur)))
             (if (not (and ca cb))
                 (format t "err NOTFOUND~%")
                 (progn
                   (rotatef (fourth ca) (fourth cb))
                   (rotatef (fifth ca) (fifth cb))
                   (rotatef (sixth ca) (sixth cb))
                   (format t "ok swap 2~%"))))))
      ((string-equal cmd "rename")
       (if (not (and a b (null c) (word-ok a) (word-ok b)))
           (format t "err BADARG~%")
           (let ((cur *courses*) (found nil) (dup nil))
             (loop while cur do
                   (if (string= (first (first cur)) a)
                       (progn (setf found t) (return))
                       (setf cur (rest cur))))
             (if (not found)
                 (format t "err NOTFOUND~%")
                 (let ((cur2 *courses*))
                   (loop while cur2 do
                         (if (string= (first (first cur2)) b)
                             (progn (setf dup t) (return))
                             (setf cur2 (rest cur2))))
                   (if dup
                       (format t "err DUP~%")
                       (progn
                         (setf (first (first cur)) b)
                         (format t "ok rename 1~%"))))))))
      ((string-equal cmd "duplicate")
       (if (not (and a b (null c) (word-ok a) (word-ok b)))
           (format t "err BADARG~%")
           (let ((cur *courses*) (src nil) (dup nil))
             (loop while cur do
                   (if (string= (first (first cur)) a)
                       (progn (setf src (first cur)) (return))
                       (setf cur (rest cur))))
             (let ((cur2 *courses*))
               (loop while cur2 do
                     (if (string= (first (first cur2)) b)
                         (progn (setf dup t) (return))
                         (setf cur2 (rest cur2))))
               (cond
                 ((null src) (format t "err NOTFOUND~%"))
                 (dup (format t "err DUP~%"))
                 ((>= (length *courses*) 20) (format t "err LIMIT~%"))
                 (t (push (list b (second src) (third src)
                                (fourth src) (fifth src) (sixth src))
                          *courses*)
                    (format t "ok duplicate 1~%")))))))
      ((string-equal cmd "trim")
       (let ((dv (and a (u-num a))) (tv (and b (u-num b))))
         (if (not (and dv tv (null c) (<= 1 dv 7) (<= 1 tv 12)))
             (format t "err BADARG~%")
             (let ((n 0) (cur *courses*))
               (loop while cur do
                     (let ((cc (first cur)))
                       (when (and (= (fourth cc) dv)
                                  (<= (fifth cc) tv)
                                  (< tv (sixth cc)))
                         (setf (sixth cc) tv)
                         (incf n)))
                     (setf cur (rest cur)))
               (format t "ok trim ~a~%" n)))))
      ((string-equal cmd "clear")
       (let ((dv (and a (u-num a))))
         (if (not (and dv (null b) (<= 1 dv 7)))
             (format t "err BADARG~%")
             (let ((n (count-if (lambda (cc) (= (fourth cc) dv)) *courses*)))
               (setf *courses* (remove-if (lambda (cc) (= (fourth cc) dv)) *courses*))
               (format t "ok clear ~a~%" n)))))
      ((string-equal cmd "shift")
       (let ((dv (and a (u-num a))) (dl (and b (i-num b))))
         (if (not (and dv dl (null c) (<= 1 dv 7) (<= 1 (+ dv dl) 7)))
             (format t "err BADARG~%")
             (let ((n 0) (cur *courses*))
               (loop while cur do
                     (let ((cc (first cur)))
                       (when (= (fourth cc) dv)
                         (setf (fourth cc) (+ dv dl))
                         (incf n)))
                     (setf cur (rest cur)))
               (format t "ok shift ~a~%" n)))))
      ((string-equal cmd "copy")
       (let ((dv (and b (u-num b))) (nn (and a (concatenate 'string a "_2"))))
         (if (not (and a nn dv (null c) (word-ok a) (<= 1 dv 7)))
             (format t "err BADARG~%")
             (let ((cur *courses*) (src nil) (dup nil))
               (loop while cur do
                     (if (string= (first (first cur)) a)
                         (progn (setf src (first cur)) (return))
                         (setf cur (rest cur))))
               (let ((cur2 *courses*))
                 (loop while cur2 do
                       (if (string= (first (first cur2)) nn)
                           (progn (setf dup t) (return))
                           (setf cur2 (rest cur2))))
                 (cond
                   ((null src) (format t "err NOTFOUND~%"))
                   (dup (format t "err DUP~%"))
                   ((>= (length *courses*) 20) (format t "err LIMIT~%"))
                   (t (push (list nn (second src) (third src) dv
                                  (fifth src) (sixth src))
                            *courses*)
                      (format t "ok copy 1~%"))))))))
      ((string-equal cmd "merge")
       (if (not (and a b (null c) (word-ok a) (word-ok b)))
           (format t "err BADARG~%")
           (if (string= a b)
               (format t "err BADARG~%")
               (let ((ca nil) (cb nil) (cur *courses*))
                 (loop while cur do
                       (let ((cc (first cur)))
                         (cond ((string= (first cc) a) (setf ca cc))
                               ((string= (first cc) b) (setf cb cc))))
                       (setf cur (rest cur)))
                 (if (not (and ca cb))
                     (format t "err NOTFOUND~%")
                     (progn
                       (setf (second ca) (second cb))
                       (setf (third ca) (third cb))
                       (setf *courses* (remove cb *courses* :count 1))
                       (format t "ok merge 2~%")))))))
      ((string-equal cmd "sort")
       (if (not (null a))
           (format t "err BADARG~%")
           (progn
             (setf *courses*
                   (sort (copy-list *courses*)
                         (lambda (x y) (string< (first x) (first y)))))
             (format t "ok sort 0~%"))))
      ((string-equal cmd "filter")
       (let ((dv (and a (u-num a))))
         (if (not (and dv (null b) (<= 1 dv 7)))
             (format t "err BADARG~%")
             (format t "ok filter ~a~%"
                     (count-if (lambda (cc) (= (fourth cc) dv)) *courses*)))))
      ((string-equal cmd "count")
       (if (not (null a))
           (format t "err BADARG~%")
           (format t "ok count ~a~%" (length *courses*))))
      (t (format t "err BADARG~%")))))

(let ((args (rest sb-ext:*posix-argv*)))
  (dolist (s args)
    (unless (or (and (plusp (length s)) (char= (char s 0) #\-))
                (search ".lisp" s))
      (run-one s)))
  (let ((sorted (sort (copy-list *courses*)
                      (lambda (x y) (string< (first x) (first y))))))
    (format t "#state~%")
    (dolist (c sorted)
      (format t "~a|~a|~a|~a|~a-~a~%"
              (first c) (second c) (third c)
              (fourth c) (fifth c) (sixth c))))
  (finish-output))
