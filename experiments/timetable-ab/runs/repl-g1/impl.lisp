;;;; impl.lisp -- timetable ops executor (scale arm, 5 ops at build time)
;;;; Interface: sbcl --script impl.lisp <input.json>  -> one JSON object on stdout
;;;; ASCII-only source; JSON output escaped so it is ASCII-safe too.

;; ---------------- I/O ----------------

(defun slurp (path)
  (with-open-file (s path :direction :input :element-type '(unsigned-byte 8))
    (let ((b (make-array (file-length s) :element-type '(unsigned-byte 8))))
      (read-sequence b s)
      (sb-ext:octets-to-string b :external-format :utf-8))))

(defun emit (str)
  (write-string str)
  (finish-output))

;; ---------------- JSON reader ----------------
;; object -> (:obj (key . value) ...)   array -> (:arr v ...)
;; string -> string   number -> integer   :true :false :null

(defvar *src* "")
(defvar *pos* 0)

(defun jerr (msg)
  (error "JSON ~a at ~d" msg *pos*))

(defun jpeek ()
  (if (< *pos* (length *src*)) (char *src* *pos*) nil))

(defun jws ()
  (loop while (and (jpeek)
                   (member (jpeek) '(#\Space #\Tab #\Newline #\Return)))
        do (incf *pos*)))

(defun jword (w)
  (let ((n (length w)))
    (unless (and (<= (+ *pos* n) (length *src*))
                 (string= w *src* :start2 *pos* :end2 (+ *pos* n)))
      (jerr "literal"))
    (incf *pos* n)))

(defun jhex4 ()
  (let ((v 0))
    (dotimes (i 4)
      (let* ((c (jpeek))
             (d (cond ((null c) -1)
                      ((digit-char-p c 16) (digit-char-p c 16))
                      (t -1))))
        (when (minusp d) (jerr "hex"))
        (setf v (+ (* v 16) d))
        (incf *pos*)))
    v))

(defun jstring ()
  (incf *pos*)                          ; opening quote
  (let ((o (make-string-output-stream)))
    (loop
      (let ((c (jpeek)))
        (cond ((null c) (jerr "unterminated string"))
              ((char= c #\") (incf *pos*) (return (get-output-stream-string o)))
              ((char= c #\\)
               (incf *pos*)
               (let ((e (jpeek)))
                 (incf *pos*)
                 (case e
                   (#\" (write-char #\" o))
                   (#\\ (write-char #\\ o))
                   (#\/ (write-char #\/ o))
                   (#\b (write-char (code-char 8) o))
                   (#\f (write-char (code-char 12) o))
                   (#\n (write-char #\Newline o))
                   (#\r (write-char #\Return o))
                   (#\t (write-char #\Tab o))
                   (#\u (let ((code (jhex4)))
                          (if (and (>= code #xD800) (<= code #xDBFF))
                              (let ((save *pos*))
                                (cond ((and (char= (or (jpeek) #\x) #\\)
                                            (let ((p (1+ *pos*)))
                                              (and (< p (length *src*))
                                                   (char= (char *src* p) #\u))))
                                       (incf *pos* 2)
                                       (let ((lo (jhex4)))
                                         (write-char
                                          (code-char (+ #x10000
                                                        (ash (- code #xD800) 10)
                                                        (- lo #xDC00)))
                                          o)))
                                      (t (setf *pos* save)
                                         (write-char (code-char code) o))))
                              (write-char (code-char code) o))))
                   (t (jerr "bad escape")))))
              (t (write-char c o) (incf *pos*)))))))

(defun jnumber ()
  (let ((start *pos*))
    (loop while (and (jpeek)
                     (or (digit-char-p (jpeek))
                         (member (jpeek) '(#\- #\+ #\. #\e #\E))))
          do (incf *pos*))
    (let ((txt (subseq *src* start *pos*)))
      (if (or (find #\. txt) (find #\e txt) (find #\E txt))
          (read-from-string txt)
          (parse-integer txt)))))

(defun jarray ()
  (incf *pos*)                          ; [
  (jws)
  (if (char= (or (jpeek) #\x) #\])
      (progn (incf *pos*) (cons :arr nil))
      (let ((items '()))
        (loop
          (push (jvalue) items)
          (jws)
          (let ((c (jpeek)))
            (cond ((null c) (jerr "eof array"))
                  ((char= c #\]) (incf *pos*) (return))
                  ((char= c #\,) (incf *pos*) (jws))
                  (t (jerr "array sep")))))
        (cons :arr (nreverse items)))))

(defun jobject ()
  (incf *pos*)                          ; {
  (jws)
  (if (char= (or (jpeek) #\x) #\})
      (progn (incf *pos*) (cons :obj nil))
      (let ((pairs '()))
        (loop
          (jws)
          (unless (char= (or (jpeek) #\x) #\") (jerr "object key"))
          (let ((k (jstring)))
            (jws)
            (unless (char= (or (jpeek) #\x) #\:) (jerr "colon"))
            (incf *pos*)
            (push (cons k (jvalue)) pairs))
          (jws)
          (let ((c (jpeek)))
            (cond ((null c) (jerr "eof object"))
                  ((char= c #\}) (incf *pos*) (return))
                  ((char= c #\,) (incf *pos*))
                  (t (jerr "object sep")))))
        (cons :obj (nreverse pairs)))))

(defun jvalue ()
  (jws)
  (let ((c (jpeek)))
    (cond ((null c) (jerr "eof"))
          ((char= c #\{) (jobject))
          ((char= c #\[) (jarray))
          ((char= c #\") (jstring))
          ((char= c #\t) (jword "true") :true)
          ((char= c #\f) (jword "false") :false)
          ((char= c #\n) (jword "null") :null)
          (t (jnumber)))))

(defun parse-json (text)
  (let ((*src* text) (*pos* 0))
    (prog1 (jvalue) (jws))))

;; ---------------- JSON writer ----------------

(defun jstr (s)
  (with-output-to-string (o)
    (write-char #\" o)
    (loop for ch across s
          do (cond ((char= ch #\") (write-string "\\\"" o))
                   ((char= ch #\\) (write-string "\\\\" o))
                   ((< (char-code ch) 32) (format o "\\u~4,'0X" (char-code ch)))
                   ((< (char-code ch) 127) (write-char ch o))
                   (t (format o "\\u~4,'0X" (char-code ch)))))
    (write-char #\" o)))

(defun jwrite (v)
  (cond ((eq v :true) "true")
        ((eq v :false) "false")
        ((eq v :null) "null")
        ((stringp v) (jstr v))
        ((integerp v) (format nil "~d" v))
        ((floatp v) (format nil "~f" v))
        ((and (consp v) (eq (car v) :obj))
         (with-output-to-string (o)
           (write-char #\{ o)
           (let ((first t))
             (dolist (p (cdr v))
               (unless first (write-char #\, o))
               (setf first nil)
               (write-string (jstr (car p)) o)
               (write-char #\: o)
               (write-string (jwrite (cdr p)) o)))
           (write-char #\} o)))
        ((and (consp v) (eq (car v) :arr))
         (with-output-to-string (o)
           (write-char #\[ o)
           (let ((first t))
             (dolist (x (cdr v))
               (unless first (write-char #\, o))
               (setf first nil)
               (write-string (jwrite x) o)))
           (write-char #\] o)))
        (t "null")))

;; ---------------- helpers ----------------

(defun u (&rest codes) (coerce (mapcar #'code-char codes) 'string))

(defvar +reject+ (u #x62D2 #x7EDD #xFF1A #x672A #x77E5))       ; "refuse: unknown"
(defvar +missing+ (u #x6CA1 #x627E #x5230))                    ; "not found"

(defun oget (obj key &optional (default :null))
  (let ((p (assoc key (cdr obj) :test #'string=)))
    (if p (cdr p) default)))

(defun oset (obj key val)
  (let ((p (assoc key (cdr obj) :test #'string=)))
    (if p
        (setf (cdr p) val)
        (setf (cdr obj) (append (cdr obj) (list (cons key val)))))
    obj))

(defun clamp (v lo hi) (max lo (min hi v)))

(defun sub (hay needle)
  (and (stringp hay) (stringp needle) (search needle hay) t))

(defun cname (c) (let ((v (oget c "name" ""))) (if (stringp v) v "")))

(defun matches (courses needle)
  (if (stringp needle)
      (remove-if-not (lambda (c) (sub (cname c) needle)) courses)
      '()))

(defun range-weeks ()
  (cons :obj (list (cons "type" "range") (cons "from" 1) (cons "to" 16))))

(defvar *log* nil)
(defvar *n* 0)

(defun log! (fmt &rest args) (push (apply #'format nil fmt args) *log*))

(defun norm-course (c)
  (let ((out (cons :obj nil)))
    (oset out "name" (let ((v (oget c "name" ""))) (if (stringp v) v "")))
    (oset out "teacher" (oget c "teacher" ""))
    (oset out "location" (oget c "location" ""))
    (oset out "day" (let ((v (oget c "day" 1))) (if (integerp v) (clamp v 1 7) 1)))
    (oset out "periodFrom" (let ((v (oget c "periodFrom" 1))) (if (integerp v) (max 1 v) 1)))
    (oset out "periodTo" (let ((v (oget c "periodTo" 2))) (if (integerp v) (max 1 v) 2)))
    (oset out "weeks" (oget c "weeks" :null))
    (oset out "tag" (oget c "tag" :null))
    (dolist (p (cdr c))
      (unless (assoc (car p) (cdr out) :test #'string=)
        (oset out (car p) (cdr p))))
    out))

;; ---------------- ops ----------------
;; Every op: (lambda (courses op) ...) returning the new course list.
;; Handlers mutate course objects in place; the list itself is rebuilt when
;; items are added or removed.

(defun op-add (courses op)
  (let* ((raw (oget op "course" :null))
         (c (if (and (consp raw) (eq (car raw) :obj)) (norm-course raw) (norm-course (cons :obj nil)))))
    (when (or (eq (oget c "weeks" :null) :null)
              (not (consp (oget c "weeks" :null))))
      (oset c "weeks" (range-weeks)))
    (incf *n*)
    (log! "add ~a" (cname c))
    (append courses (list c))))

(defun op-del (courses op)
  (let* ((m (oget op "match" ""))
         (hit (matches courses m)))
    (if hit
        (progn (incf *n* (length hit))
               (log! "del ~a ~d" m (length hit))
               (remove-if (lambda (c) (sub (cname c) m)) courses))
        (progn (log! "~a ~a" +missing+ m) courses))))

(defun op-edit (courses op)
  (let ((m (oget op "match" ""))
        (set (oget op "set" :null)))
    (if (not (and (consp set) (eq (car set) :obj)))
        (progn (log! "edit: no set") courses)
        (let ((cnt 0))
          (dolist (c courses)
            (when (sub (cname c) m)
              (dolist (p (cdr set))
                (let ((k (car p)) (v (cdr p)))
                  (cond ((string= k "day")
                         (when (integerp v) (oset c "day" (clamp v 1 7))))
                        ((string= k "periodFrom")
                         (when (integerp v) (oset c "periodFrom" (max 1 v))))
                        ((string= k "periodTo")
                         (when (integerp v) (oset c "periodTo" (max 1 v))))
                        (t (oset c k v)))))
              (when (> (oget c "periodFrom") (oget c "periodTo"))
                (oset c "periodTo" (oget c "periodFrom")))
              (incf cnt)))
          (incf *n* cnt)
          (log! "edit ~a ~d" m cnt)
          courses))))

(defun op-move (courses op)
  (let ((m (oget op "match" :null))
        (d (oget op "day" :null))
        (pf (oget op "periodFrom" :null))
        (pt (oget op "periodTo" :null)))
    (if (or (not (stringp m)) (not (integerp d))
            (not (integerp pf)) (not (integerp pt)))
        (progn (log! "move: incomplete") courses)
        (let ((cnt 0))
          (dolist (c courses)
            (when (sub (cname c) m)
              (oset c "day" (clamp d 1 7))
              (let ((a (max 1 pf)) (b (max 1 pt)))
                (when (> a b) (setf b a))
                (oset c "periodFrom" a)
                (oset c "periodTo" b))
              (incf cnt)))
          (incf *n* cnt)
          (log! "move ~a ~d" m cnt)
          courses))))

(defun op-swap (courses op)
  (let* ((m (oget op "match" :null))
         (w (oget op "with" :null))
         (as (matches courses m))
         (bs (matches courses w)))
    (if (and (= (length as) 1) (= (length bs) 1))
        (let* ((a (first as)) (b (first bs))
               (ad (oget a "day")) (apf (oget a "periodFrom")) (apt (oget a "periodTo"))
               (bd (oget b "day")) (bpf (oget b "periodFrom")) (bpt (oget b "periodTo")))
          (oset a "day" bd) (oset a "periodFrom" bpf) (oset a "periodTo" bpt)
          (oset b "day" ad) (oset b "periodFrom" apf) (oset b "periodTo" apt)
          (incf *n* 2)
          (log! "swap ~a ~a" (cname a) (cname b))
          courses)
        (progn (log! "swap: need exactly one each") courses))))

(defun op-summary (op)
  (let ((nm (oget op "op" :null)))
    (cond ((not (stringp nm)) "?")
          ((string= nm "add") (format nil "add ~a" (cname (oget op "course" (cons :obj nil)))))
          ((string= nm "del") (format nil "del ~a" (oget op "match" "")))
          ((string= nm "edit") (format nil "edit ~a" (oget op "match" "")))
          ((string= nm "move") (format nil "move ~a" (oget op "match" "")))
          ((string= nm "swap") (format nil "swap ~a ~a" (oget op "match" "") (oget op "with" "")))
          (t nm))))

(defun apply-op (courses op)
  (let ((nm (oget op "op" :null)))
    (cond ((not (stringp nm)) (log! "reject") courses)
          ((string= nm "add") (op-add courses op))
          ((string= nm "del") (op-del courses op))
          ((string= nm "edit") (op-edit courses op))
          ((string= nm "move") (op-move courses op))
          ((string= nm "swap") (op-swap courses op))
          (t (log! "reject") courses))))

(defun known-op-p (op)
  (and (consp op) (eq (car op) :obj)
       (let ((nm (oget op "op" :null)))
         (and (stringp nm)
              (member nm '("add" "del" "edit" "move" "swap") :test #'string=)))))

;; ---------------- output ----------------

(defun numbered (revlog)
  (let ((i 0) (out '()))
    (dolist (m (reverse revlog) (nreverse out))
      (incf i)
      (push (format nil "~d) ~a" i m) out))))

(defun emit-result (courses ops-text revlog n)
  (emit (jwrite
         (cons :obj
               (list (cons "opsText" ops-text)
                     (cons "courses" (cons :arr courses))
                     (cons "log" (cons :arr (numbered revlog)))
                     (cons "n" n))))))

;; ---------------- main ----------------

(defun main ()
  (let* ((argv (cdr sb-ext:*posix-argv*))
         (path (or (second sb-ext:*posix-argv*)
                   (car (last sb-ext:*posix-argv*))))
         (input (parse-json (slurp path)))
         (cs (oget input "courses" :null))
         (courses (if (and (consp cs) (eq (car cs) :arr))
                      (mapcar #'norm-course (cdr cs))
                      '()))
         (ops (oget input "ops" :null))
         (opl (and (consp ops) (eq (car ops) :arr) (cdr ops)))
         (bad (find-if-not #'known-op-p opl)))
    (declare (ignore argv))
    (setf *log* nil *n* 0)
    (cond
      ((null opl)
       (emit-result courses "" nil 0))
      (bad
       (let ((nm (oget bad "op" :null)))
         (emit-result courses ""
                      (list (format nil "~a op ~a" +reject+ (if (stringp nm) nm "?")))
                      0)))
      (t
       (let ((texts '()))
         (dolist (op opl)
           (push (op-summary op) texts)
           (setf courses (apply-op courses op)))
         (emit-result courses
                      (format nil "~{~a~^~%~}" (nreverse texts))
                      *log* *n*))))))

(main)
